#!/bin/sh /etc/rc.common
# batman-ots — procd runtime owner / guardian for the OTS payload (#156).
#
# On OpenWrt the runtime owner is a procd init script (NOT a systemd Quadlet — no systemd).
# Its narrow DoD (#156) is guardianship / anti-bypass: on EVERY boot the OTS stack is (re)brought
# up with the profile's hardened flags, so a hand-run `docker run` cannot leave a non-hardened
# config in place. Intra-stack ordering + health-gating live in run.sh (the ordering-wrapper).
#
# BOOT ORDERING (validated on manet01): dockerd is START=99 and "batman-ots" sorts before "dockerd",
# so this starts first AND dockerd cold-boot can exceed 2 min on a Pi4 (data-root on p6). A one-shot
# wait therefore races and loses. Fix: the bring-up runs UNDER procd with respawn — it waits for the
# docker socket (generously), applies fw4 + run.sh, then keepalive-watches the API; if anything is
# not ready it exits and procd respawns it until the stack is up. Idempotent, so retries are safe.
#
# On-node deploy dir (scp'd or baked): DEPLOY holds run.sh + ots.fw4.uci + ots.hardening.env.
START=99
STOP=10
USE_PROCD=1
DEPLOY=/opt/batdata/deploy/ots

start_service() {
	[ -d "$DEPLOY" ] || { echo "batman-ots: $DEPLOY missing (deploy artifacts not installed)"; return 1; }
	procd_open_instance
	# The supervised command does the whole guarded bring-up, then blocks as a keepalive.
	# It EXITS (non-zero) if docker isn't ready yet or the API isn't up -> procd respawns it.
	procd_set_param command /bin/sh -c '
		DEPLOY='"$DEPLOY"'
		docker info >/dev/null 2>&1 || { echo "batman-ots: waiting for dockerd"; exit 1; }
		[ -f "$DEPLOY/ots.fw4.uci" ] && sh "$DEPLOY/ots.fw4.uci"
		docker inspect -f "{{.State.Running}}" opentakserver 2>/dev/null | grep -q true || sh "$DEPLOY/run.sh"
		[ -x "$DEPLOY/verify-profile.sh" ] && { "$DEPLOY/verify-profile.sh" ots "$DEPLOY/ots.hardening.env" >/dev/null 2>&1 || true; }
		# keepalive: hold the instance while the API runs; exit -> procd respawn re-checks/re-applies
		while docker inspect -f "{{.State.Running}}" opentakserver >/dev/null 2>&1; do sleep 30; done
		echo "batman-ots: opentakserver not running — exiting for respawn"; exit 1
	'
	procd_set_param respawn 30 15 0    # threshold 30s, respawn every 15s, unlimited retries
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

stop_service() {
	for c in ots_eud_handler_ssl ots_eud_handler ots_cot_parser opentakserver rabbitmq ots-db; do
		docker rm -f "$c" >/dev/null 2>&1 || true
	done
}
