# GENERATED by scripts/profile-to-manifest.py from deploy/ots/profile.yaml -- DO NOT EDIT BY HAND.
# Consumed by /usr/bin/payload-run (the generic payload orchestrator, #167). Line-oriented for busybox.
TENANT opentakserver
NETWORK_NAME ots-net
BRIDGE br-ots
SUBNET 172.20.0.0/24
ZONE dockert
RESTART unless-stopped

CONTAINER ots-db
IMAGE imresamu/postgis:18-3.6
IP 172.20.0.2
HOSTNAME ots-db
HARDEN ots-db.hardening.env
ENV POSTGRES_USER=ots
ENV POSTGRES_PASSWORD=password
ENV POSTGRES_DB=ots
ENV PGUSER=ots
VOLUME ots-pgdata:/var/lib/postgresql:999:999:batman/ots:1.7.13-arm64
HEALTH pg_isready -q
ENDCONTAINER

CONTAINER rabbitmq
IMAGE rabbitmq:4.3.6
IP 172.20.0.3
HOSTNAME rabbitmq
HARDEN rabbitmq.hardening.env
ENV RABBITMQ_ERLANG_COOKIE=batman-ots-cookie
ENV RABBITMQ_ENABLED_PLUGINS_FILE=/var/lib/rabbitmq/enabled_plugins
VOLUME ots-mqdata:/var/lib/rabbitmq:999:999:batman/ots:1.7.13-arm64
MOUNT rabbitmq-extra.conf:/etc/rabbitmq/conf.d/99-batman.conf:ro
HEALTH rabbitmq-diagnostics -q ping
ENDCONTAINER

CONTAINER opentakserver
IMAGE batman/ots:1.7.13-arm64
IP 172.20.0.5
HOSTNAME opentakserver
HARDEN ots.hardening.env
ENV SQLALCHEMY_DATABASE_URI=postgresql+psycopg://ots:password@ots-db/ots
ENV OTS_RABBITMQ_SERVER_ADDRESS=rabbitmq
ENV OTS_LISTENER_ADDRESS=0.0.0.0
ENV OTS_FQDN=_
ENV OTS_MEDIAMTX_API_ADDRESS=http://localhost:9997
VOLUME ots-appdata:/app/ots:1000:1024
HEALTH curl -fsS http://localhost:8081/api/health
ENDCONTAINER

CONTAINER ots_cot_parser
IMAGE batman/ots:1.7.13-arm64
IP 172.20.0.4
HOSTNAME ots-cot_parser
HARDEN ots.hardening.env
ENV SQLALCHEMY_DATABASE_URI=postgresql+psycopg://ots:password@ots-db/ots
ENV OTS_RABBITMQ_SERVER_ADDRESS=rabbitmq
ENV OTS_LISTENER_ADDRESS=0.0.0.0
ENV OTS_FQDN=_
ENV OTS_MEDIAMTX_API_ADDRESS=http://localhost:9997
ENTRYPOINT python3 /app/venv/bin/cot_parser
VOLUME ots-appdata:/app/ots
ENDCONTAINER

CONTAINER ots_eud_handler
IMAGE batman/ots:1.7.13-arm64
IP 172.20.0.10
HOSTNAME ots_eud_handler
HARDEN ots.hardening.env
ENV SQLALCHEMY_DATABASE_URI=postgresql+psycopg://ots:password@ots-db/ots
ENV OTS_RABBITMQ_SERVER_ADDRESS=rabbitmq
ENV OTS_LISTENER_ADDRESS=0.0.0.0
ENV OTS_FQDN=_
ENV OTS_MEDIAMTX_API_ADDRESS=http://localhost:9997
ENTRYPOINT python3 /app/venv/bin/eud_handler
VOLUME ots-appdata:/app/ots
ENDCONTAINER

CONTAINER ots_eud_handler_ssl
IMAGE batman/ots:1.7.13-arm64
IP 172.20.0.12
HOSTNAME ots_eud_handler_ssl
HARDEN ots.hardening.env
ENV SQLALCHEMY_DATABASE_URI=postgresql+psycopg://ots:password@ots-db/ots
ENV OTS_RABBITMQ_SERVER_ADDRESS=rabbitmq
ENV OTS_LISTENER_ADDRESS=0.0.0.0
ENV OTS_FQDN=_
ENV OTS_MEDIAMTX_API_ADDRESS=http://localhost:9997
ENTRYPOINT python3 /app/venv/bin/eud_handler --ssl
VOLUME ots-appdata:/app/ots
ENDCONTAINER
