#!/bin/sh
# halow-setkey — the one supported door for setting the node's radio keys and HaLow channel
# (#103/#13/#202): validate -> apply -> read back -> PERSIST to p5.
#
#   halow-setkey [--mesh <sae-key>] [--ap <psk>] [--mesh-id <id>] [--channel <n>]   (at least one)
#   halow-setkey --forget-mesh [--no-persist]   (#254 §6: placeholder key + radio blocked, verified down)
#   halow-setkey --check-only [--mesh <key>|-] [--mesh-id <id>] [--channel <n>]   (#254 §15.1)
#   halow-setkey --status
#   halow-setkey --country <CC> --rollback [--lockwait <s>]                            (#254 P3 settings key 2)
#   halow-setkey --ap - --ap-ssid <ssid> --ap-section default_radio0 --rollback [--lockwait <s>]   (P3 key 20)
#
# --check-only runs exactly the validation of the write modes and exits 0 (would be accepted) or 2 (refused, the same
# message); no lock, no uci write, no wifi, no persist, no root needed beyond reading uci. It takes only --mesh /
# --mesh-id / --channel (at least one): batman-provhelper asks it whether a snapshot could be put back (#254 §15.1).
# An operator's write (no --no-persist) is refused, rc 2, while /etc/batman-prov/.txn exists: the helper's next
# Finish would silently undo it (#254 §15.6). --no-persist (the helper) proceeds.
#
# One writer at a time (#254 §6): every write mode holds $RUNDIR/halow-setkey.lock (flock; 99-batman-chanfix takes
# it per reassert). Busy for LOCKWAIT s, or the run dir unusable -> rc 2, nothing changed (fail closed).
# --status is read-only and takes no lock.
#
# Sets the HaLow mesh SAE key and/or the onboarding-AP PSK / mesh id / S1G channel, releases whatever
# halow-keyguard disabled because a key was still the public placeholder, commits, reloads wifi, reads
# the result back from the radio, and then runs `batman-config-save --save` so the change survives
# the next A/B reflash (#202: before this, a key set here lived only in the running slot's overlay).
#
# Exit codes: 0 applied and persisted (or no p5 on this card); 2 bad argument, nothing changed;
#             3 applied but NOT verified / NOT persisted (message says why; "persist:" line is the truth).
#             3 is not a harness skip code — it means "look at this node".
# Persisted (PRESERVE in batman-config-save): mesh key, mesh_id, channel, country, hostname, AP key,
# address flags, AP ssid (#254 P3; one with an UNSAFE character is not kept). NOT persisted: mesh encryption (image default sae).
# Keys may not contain  ` $ ( ) ; | & < > '  — p5's uci batch cannot carry them (96 rejects the batch).
# --channel is validated against the morse regdb for the radio's country: an S1G channel number implies
# its bandwidth (US: ch40 = 4 MHz @ 922.0 MHz, ch42 = 2 MHz @ 923.0 MHz), the same table netifd uses.
MARK=/etc/halow-keyguard.blocked
PLACEHOLDER=CHANGE-ME-NOW
REGDB=/usr/share/morse-regdb/channels.csv
LOCKWAIT=90         # s to wait for another writer (#254 §6)
FORGET_WAIT=30      # s for --forget-mesh to see the radio down (04 idle: within 2 s, radiooff.sh 2026-10-30; §19.1 for the slow case)
SETTLE_WAIT=30      # s for netifd to finish a change in flight before ours is staged (#254 §19.2 rule 1; rc 2 at the deadline)
READBACK_WAIT=60    # s for netifd to report the radio up on the settings just written (#254 §19.2 rule 2)
WSETTLE=/usr/lib/batman/wireless-settle.sh
# the forget escalation's inputs (#254 §19.3) — kernel / root-owned; the tests point them at fakes
IEEE80211=/sys/class/ieee80211; NETCLASS=/sys/class/net; PROC=/proc; S1G_EXE=/usr/sbin/wpa_supplicant_s1g; S1G_UID=0
PROVTXN=/etc/batman-prov/.txn   # the helper's "a network change is unfinished" (#254 wireless-txn §3)
MESH=""; AP=""; MESHID=""; CHAN=""; STATUS=0; NOPERSIST=0; FORGET=0; CHECK=0
COUNTRY=""; APSSID=""; APSEC=""; ROLLBACK=0; P3=0   # #254 P3 settings (254-p3-impl §3.3)
usage() { echo "usage: halow-setkey [--mesh <key>|-] [--ap <key>] [--mesh-id <id>] [--channel <n>] [--no-persist] | --forget-mesh [--no-persist] | --check-only [--mesh <key>|-] [--mesh-id <id>] [--channel <n>] | --status" >&2; exit 2; }
while [ $# -gt 0 ]; do
	case "$1" in --mesh|--ap|--mesh-id|--channel|--country|--ap-ssid|--ap-section|--lockwait) [ $# -ge 2 ] || usage ;; esac
	case "$1" in
		--mesh) MESH=${2:-}; shift 2;; --ap) AP=${2:-}; shift 2;; --mesh-id) MESHID=${2:-}; shift 2;;
		--channel) CHAN=${2:-}; shift 2;; --status) STATUS=1; shift;;
		--no-persist) NOPERSIST=1; shift;;   # #254: batman-provhelper's transaction persists by itself (§4.4 step 2)
		--forget-mesh) FORGET=1; shift;;     # #254 §6: no key input; mesh id / channel unchanged
		--check-only) CHECK=1; shift;;       # #254 §15.1: validate only
		--country) COUNTRY=${2:-}; shift 2;; --ap-ssid) APSSID=${2:-}; shift 2;; --ap-section) APSEC=${2:-}; shift 2;;
		--rollback) ROLLBACK=1; shift;;
		--lockwait) case "${2:-}" in ''|*[!0-9]*) usage;; esac; LOCKWAIT=$2; shift 2;;
		*) usage;;
	esac
done
# #254 P3: --rollback marks the app's settings mode — exactly one of --country / (--ap - --ap-ssid --ap-section), nothing
# else; the existing modes are untouched (without --rollback, --country / --ap-ssid / --ap-section are refused)
if [ "$ROLLBACK" = 1 ] || [ -n "$COUNTRY$APSSID$APSEC" ]; then
	[ "$ROLLBACK" = 1 ] || { echo "--country / --ap-ssid / --ap-section need --rollback" >&2; exit 2; }
	[ "$STATUS$FORGET$CHECK$NOPERSIST" = 0000 ] && [ -z "$MESH$MESHID$CHAN" ] || { echo "--rollback takes only --country, or --ap - --ap-ssid --ap-section" >&2; exit 2; }
	if [ -n "$COUNTRY" ]; then [ -z "$AP$APSSID$APSEC" ] || { echo "one setting per call" >&2; exit 2; }
	else [ "$AP" = - ] && [ -n "$APSSID" ] && [ -n "$APSEC" ] || { echo "--ap - --ap-ssid <ssid> --ap-section <section> (the passphrase on stdin)" >&2; exit 2; }
		IFS= read -r AP || true; p3cr=$(printf '\r'); AP=${AP%"$p3cr"}
		# one line only: a second line would be dropped silently and a different key set than sent (P3 security review m1)
		if IFS= read -r p3extra || [ -n "${p3extra:-}" ]; then echo "passphrase: one line only"; exit 2; fi; fi
	P3=1
fi
# --forget-mesh takes no key, id or channel (and never reads stdin): checked before `--mesh -` could read one
if [ "$FORGET" = 1 ] && { [ "$STATUS" = 1 ] || [ -n "$MESH$AP$MESHID$CHAN" ]; }; then
	echo "--forget-mesh takes no key, mesh id, channel or --status (only --no-persist)" >&2; exit 2
fi
if [ "$CHECK" = 1 ]; then
	{ [ "$STATUS$FORGET$NOPERSIST" = 000 ] && [ -z "$AP" ]; } || { echo "--check-only takes only --mesh / --mesh-id / --channel" >&2; exit 2; }
	[ -n "$MESH$MESHID$CHAN" ] || { echo "--check-only: nothing to check (use --mesh/--mesh-id/--channel)" >&2; exit 2; }
fi
# #254: `--mesh -` reads the key from stdin (one line) — batman-provhelper never puts a secret on a command line,
# where any local process could read it from /proc/<pid>/cmdline
if [ "$MESH" = - ]; then IFS= read -r MESH || true; MESH=$(printf '%s' "$MESH" | tr -d '\r'); [ -n "$MESH" ] || { echo "--mesh -: no key on stdin"; exit 2; }; fi
# #254 §4.4 step 9: an app-managed node (prov.meta rm=1) — the operator's change is applied, but it is not in the network config
if [ "$STATUS" = 0 ] && [ "$CHECK" = 0 ] && [ "$NOPERSIST" = 0 ] && grep -q '\(^\| \)rm=1\( \|$\)' /etc/batman-prov/prov.meta 2>/dev/null; then
	echo "WARN: this node is app-managed (member): the change is not in the network config — other members and the app still use the old value; change it from the app" >&2
fi

mesh_ifaces(){ uci show wireless | sed -n "s/^wireless\.\([^.]*\)\.mode='mesh'$/\1/p"; }
ap_ifaces(){ uci show wireless | sed -n "s/^wireless\.\([^.]*\)\.mode='ap'$/\1/p"; }
morse_radio(){ uci show wireless 2>/dev/null | sed -n "s/^wireless\.\([^.]*\)\.type='morse'$/\1/p" | head -1; }
# fd 9 (the lock, once held) is closed for the external commands of the verify loops and the persist: a child wedged
# in D-state must not keep the lock (code review 2 B m6). uci (short file operations) keeps the plain form.
mesh_netdev(){ iw dev 2>/dev/null 9>&- | awk '/^\tInterface/{i=$2} /type mesh point/{print i; exit}'; }

# ---- validation (#254 §15.1: ONE implementation for the write modes and --check-only) --------------
# exits 2 with the reason; sets RADIO, BW, CENTRE_KHZ
validate() {
	for k in "$MESH" "$AP"; do [ -z "$k" ] || [ ${#k} -ge 8 ] || { echo "key must be >= 8 characters"; exit 2; }; done
	for k in "$MESH" "$AP"; do [ "$k" != "$PLACEHOLDER" ] || { echo "refusing the placeholder as a key"; exit 2; }; done
	for v in "$MESH" "$AP" "$MESHID"; do
		case "$v" in *[\`\$\(\)\;\|\&\<\>\']*) echo "refusing: a key / mesh id may not contain any of  \` \$ ( ) ; | & < > '  — p5 (the config that survives a reflash) cannot carry it (#202)"; exit 2 ;; esac
	done
	RADIO=$(morse_radio)
	BW=""; CENTRE_KHZ=""
	if [ -n "$CHAN" ]; then
		case "$CHAN" in ''|*[!0-9]*) echo "channel must be an integer"; exit 2 ;; esac
		[ -n "$RADIO" ] || { echo "no morse (HaLow) radio in uci — cannot set a channel"; exit 2; }
		CC=$(uci -q get "wireless.$RADIO.country"); [ -n "$CC" ] || { echo "wireless.$RADIO.country is unset — set the country first"; exit 2; }
		[ -r "$REGDB" ] || { echo "$REGDB missing — cannot validate the channel for $CC"; exit 2; }
		# columns: country_code,channelizations,default_channelization,bw,s1g_chan,...,centre_freq_mhz(8)
		row=$(awk -F, -v cc="$CC" -v ch="$CHAN" '$1==cc && $5==ch {print $4, $8; exit}' "$REGDB")
		[ -n "$row" ] || { echo "channel $CHAN is not a legal S1G channel for country $CC (per $REGDB); legal: $(awk -F, -v cc="$CC" '$1==cc {printf "%s(%sMHz) ", $5, $4}' "$REGDB")"; exit 2; }
		BW=${row% *}; centre=${row#* }
		CENTRE_KHZ=$(awk -v c="$centre" 'BEGIN{printf "%d", c*1000+0.5}')
		echo "channel $CHAN = $BW MHz @ $centre MHz ($CC)"
	fi
}

if [ "$STATUS" = 1 ]; then
	for s in $(mesh_ifaces); do k=$(uci -q get "wireless.$s.key"); r=$(uci -q get "wireless.$s.device")
		printf 'mesh %-16s id=%s key=%s radio=%s channel=%s country=%s disabled=%s\n' "$s" "$(uci -q get "wireless.$s.mesh_id")" \
			"$([ "$k" = "$PLACEHOLDER" ] && echo PLACEHOLDER || echo set)" "$r" "$(uci -q get "wireless.$r.channel")" "$(uci -q get "wireless.$r.country")" "$(uci -q get "wireless.$r.disabled" || echo 0)"; done
	for s in $(ap_ifaces); do k=$(uci -q get "wireless.$s.key")
		printf 'ap   %-16s ssid=%s key=%s disabled=%s\n' "$s" "$(uci -q get "wireless.$s.ssid")" \
			"$([ "$k" = "$PLACEHOLDER" ] && echo PLACEHOLDER || echo set)" "$(uci -q get "wireless.$s.disabled" || echo 0)"; done
	[ -f "$MARK" ] && echo "keyguard blocked:$(cat "$MARK")" || echo "keyguard: nothing blocked"
	if command -v batman-config-save >/dev/null 2>&1 && [ "$(id -u)" = 0 ]; then batman-config-save --check 2>/dev/null | sed 's/^batman-config-save: /persist: /'; fi
	exit 0
fi

if [ "$CHECK" = 1 ]; then
	validate
	echo "check: would be accepted"; exit 0
fi

[ "$(id -u)" = 0 ] || { echo "halow-setkey: root only" >&2; exit 2; }
[ "$FORGET" = 1 ] || [ "$P3" = 1 ] || [ -n "$MESH$AP$MESHID$CHAN" ] || { echo "nothing to set (use --mesh/--ap/--mesh-id/--channel, --forget-mesh or --status)"; exit 2; }

# ---- 0. one writer at a time (#254 §6) ------------------------------------------------------------
# helper (net.apply / Finish), operator and 99-batman-chanfix all write wireless + `wifi reload`; interleaved, one
# could commit the other's half-staged values. The lock lives in the root-only run dir (#280); fd 9 is closed for
# `wifi` (nothing it starts may keep the lock). busybox flock has only -n, hence the poll.
# shellcheck source=/dev/null
[ -r /usr/lib/batman/rundir.sh ] && . /usr/lib/batman/rundir.sh
if ! type batman_rundir >/dev/null 2>&1 || ! batman_rundir 2>/dev/null || ! command -v flock >/dev/null 2>&1; then
	echo "halow-setkey: run dir / flock unusable — refusing (nothing changed)" >&2; [ "$P3" = 1 ] && exit 5; exit 2
fi
command exec 9>"$RUNDIR/halow-setkey.lock" || { echo "halow-setkey: cannot open the lock — refusing (nothing changed)" >&2; [ "$P3" = 1 ] && exit 5; exit 2; }
w=0; until flock -n 9; do
	w=$((w + 1)); [ "$w" -ge "$LOCKWAIT" ] && { echo "halow-setkey: busy — another radio change holds the lock (${w}s); nothing changed" >&2; [ "$P3" = 1 ] && exit 5; exit 2; }
	sleep 1
done
# #254 §15.6: an operator's change while the helper has an unfinished network change would be undone by its Finish.
# Checked while HOLDING the lock (code review 2 B m8): a helper change that started while we waited is seen here.
if [ "$NOPERSIST" = 0 ] && { [ -e "$PROVTXN" ] || [ -L "$PROVTXN" ]; }; then
	echo "halow-setkey: an unfinished network change — let the helper finish it (any app action or a reboot); nothing changed" >&2; [ "$P3" = 1 ] && exit 5; exit 2
fi

# ---- 0b. settle gate (#254 §19.2 rule 1) -----------------------------------------------------------
# netifd finishes the change in flight (boot, chanfix, an operator's `wifi`) before ours is staged: a `wifi reload`
# landing inside netifd's setup of the morse radio left a mesh netdev + wpa_supplicant_s1g on the air that netifd no
# longer knew (04 2026-10-30, §19.1). An unreadable status is not settled. Nothing has been written yet -> rc 2.
# shellcheck source=/dev/null
if [ -r "$WSETTLE" ]; then . "$WSETTLE"; else echo "halow-setkey: $WSETTLE missing — refusing (nothing changed)" >&2; [ "$P3" = 1 ] && exit 5; exit 2; fi
GRADIO=$(morse_radio)
if [ -n "$GRADIO" ] && ! wl_wait_settled "$GRADIO" "$SETTLE_WAIT"; then
	echo "halow-setkey: netifd is still reconfiguring $GRADIO after ${SETTLE_WAIT}s — nothing changed (a netifd that never settles needs a reboot)" >&2; [ "$P3" = 1 ] && exit 5; exit 2
fi

# ---- 4. persist (#202), shared by every write mode -------------------------------------------------
persist_exit() {
	if [ "$NOPERSIST" = 1 ]; then
		echo "persist: skipped (--no-persist: the caller persists)"; exit 0
	fi
	if [ ! -b /dev/mmcblk0p5 ]; then
		echo "persist: n/a (no p5 on this card — single-slot image, nothing to survive a reflash)"; exit 0
	fi
	if ! command -v batman-config-save >/dev/null 2>&1; then
		echo "persist: FAILED (batman-config-save missing) — the setting lives only in this slot and is LOST on the next OTA" >&2; exit 3
	fi
	out=$(batman-config-save --save 2>&1 9>&-); prc=$?
	case "$prc" in
		0) echo "persist: saved -> /dev/mmcblk0p5" ;;
		6) echo "persist: PARTIAL — $(echo "$out" | sed -n 's/.*cannot persist\(.*\)(forbidden.*/\1/p' | head -1) could not be persisted (forbidden characters)" >&2; RC=3 ;;
		*) echo "persist: FAILED ($(echo "$out" | tail -1)) — the setting lives only in this slot and is LOST on the next OTA" >&2; RC=3 ;;
	esac
	exit "$RC"
}
RC=0

# ---- P3 settings (#254 254-p3-impl §3.3): --country / --ap - --ap-ssid --ap-section, always with --rollback --------
# One value per call, from batman-provhelper's settings.set. A failure goes back to the previous state in this same call
# ("失敗就回到之前的狀態"). Exit codes of this mode (the existing modes keep theirs): 0 set + read back + persisted;
# 2 value refused, nothing written; 3 applied but not read back -> restored; 4 not persisted -> restored; 5 busy (the
# lock within --lockwait, another writer's staged wireless changes, an unfinished helper change (.txn), netifd not
# settled, the run dir unusable), nothing written; 6 the live restore itself did not verify — the node is in an unknown
# state: the helper logs CRIT and status reports it (design appendix D-5 / D-6). A live restore that verifies but whose
# save fails again keeps 3 / 4 (p5 not fresh is what status key 4 already says). A real previous AP key / ssid this mode
# could not write back (a quote, backslash, line break) is refused with 2 before anything changes. A value equal to the
# current one (AP: on the air with it) is 0 with nothing changed — after p5 is checked fresh or saved (4 if that fails).
# The AP passphrase comes on stdin (`--ap -`) and goes to uci by `uci batch` on stdin — never in an argv (F78).
# uci's save dir is root's 0700 directory under the world-writable tmp (uci makes it at boot). A save dir that is not
# that — another owner, another mode, a symlink, not a directory — is not trusted: counted as staged (refuse), never
# read (#280 rule: a decision input in a world-writable path is owner-checked)
p3_staged(){ d=/tmp/.uci; [ -e "$d" ] || [ -L "$d" ] || return 1
	[ -d "$d" ] && [ ! -L "$d" ] && [ "$(ls -ldn "$d" 2>/dev/null | awk '{print $1, $3}')" = "drwx------ 0" ] || return 0
	[ -s "$d/wireless" ]; }
p3_regdb_has(){ [ -r "$REGDB" ] && awk -F, -v cc="$1" '$1==cc {f=1; exit} END {exit !f}' "$REGDB"; }
# the AP of section $1 on the air with ssid $2: netifd lists the section with that ssid on an ifname and iw shows the
# ssid on that netdev (the ssid and hostapd.<if> come and go together on 04: the ssid is the check) (04 2026-11-09: a blocked AP leaves a DOWN type-AP netdev without ssid /
# hostapd object — "type AP" alone is not "on the air")
p3_ap_ifname(){ printf '%s' "$1" | jsonfilter -e "@.radio0.interfaces[@.section='$2'].ifname" 2>/dev/null 9>&-; }
p3_ap_up(){
	pa_st=$(wl_status) || return 1
	[ "$(wl_field "$pa_st" radio0 pending)" = false ] && [ "$(wl_field "$pa_st" radio0 up)" = true ] || return 1
	pa_if=$(p3_ap_ifname "$pa_st" "$1"); [ -n "$pa_if" ] || return 1
	[ "$(printf '%s' "$pa_st" | jsonfilter -e "@.radio0.interfaces[@.section='$1'].config.ssid" 2>/dev/null 9>&-)" = "$2" ] || return 1
	iw dev "$pa_if" info 2>/dev/null 9>&- | sed 's/^[[:space:]]*//' | grep -qxF "ssid $2"
}
p3_ap_off(){   # no ssid on any AP netdev and no per-interface hostapd object
	iw dev 2>/dev/null 9>&- | grep -q '^[[:space:]]*ssid ' && return 1
	ubus list 2>/dev/null 9>&- | grep -q '^hostapd\.' && return 1
	return 0
}
p3_persist(){ batman-config-save --save >/dev/null 2>&1 9>&-; }
# p5 fresh already, or saved now (a value equal to the live one may still be missing in p5: power lost between a
# commit and its save; A r2 MAJOR-2)
p3_fresh_or_save(){ batman-config-save --check >/dev/null 2>&1 9>&- || p3_persist; }
# a previous value written back by `uci batch` inside single quotes: no quote, backslash, CR or newline
P3NL=$(printf '\nx'); P3NL=${P3NL%x}; P3CR=$(printf '\r')
p3_quotable(){ case "$1" in *"'"*|*\\*|*"$P3NL"*|*"$P3CR"*) return 1 ;; esac; return 0; }
if [ "$P3" = 1 ]; then
	trap '' PIPE   # F77: the helper dying must not stop this run half-way (it keeps the lock and restores by itself)
	if [ -n "$COUNTRY" ]; then
		case "$COUNTRY" in [A-Z][A-Z]) ;; *) echo "country must be two capital letters"; exit 2 ;; esac
		p3_regdb_has "$COUNTRY" || { echo "country $COUNTRY is not in $REGDB"; exit 2; }
		R=$(morse_radio); [ -n "$R" ] || { echo "no morse (HaLow) radio in uci"; exit 2; }
		[ "$(uci -q get "wireless.$R.disabled")" = 1 ] || { echo "the country is set only while $R is blocked (not in a network)"; exit 2; }
		p3_staged && { echo "another writer has staged wireless changes — nothing changed" >&2; exit 5; }
		old=$(uci -q get "wireless.$R.country")
		if [ "$old" = "$COUNTRY" ]; then
			p3_fresh_or_save && { echo "country already $COUNTRY — nothing changed (p5 fresh)"; exit 0; }
			echo "country already $COUNTRY, but p5 is not fresh and saving failed" >&2; exit 4
		fi
		uci -q set "wireless.$R.country=$COUNTRY"; uci commit wireless
		logger -t halow-setkey "p3: country $old -> $COUNTRY on $R (radio blocked)"
		if [ "$(uci -q get "wireless.$R.country")" != "$COUNTRY" ]; then rc=3; why="read back"
		elif p3_persist; then echo "country $COUNTRY set and persisted"; exit 0
		else rc=4; why="persist"; fi
		if [ -n "$old" ]; then uci -q set "wireless.$R.country=$old"; else uci -q delete "wireless.$R.country"; fi
		uci commit wireless
		if [ "$(uci -q get "wireless.$R.country")" != "$old" ]; then
			echo "country: $why failed — RESTORE NOT VERIFIED (uci $(uci -q get "wireless.$R.country"), was ${old:-<unset>})" >&2; rc=6
		elif { [ "$rc" = 3 ] && batman-config-save --check >/dev/null 2>&1 9>&-; } || p3_persist; then echo "country: $why failed — back to ${old:-<unset>}" >&2
		else echo "country: $why failed — back to ${old:-<unset>} live, saving it failed again (status shows p5 not fresh)" >&2; fi
		exit "$rc"
	fi
	# --ap - --ap-ssid <ssid> --ap-section default_radio0
	[ "$APSEC" = default_radio0 ] || { echo "--ap-section must be default_radio0 (the section p5 keeps)"; exit 2; }
	[ "$(uci -q get "wireless.$APSEC.mode")" = ap ] || { echo "wireless.$APSEC is not an AP"; exit 2; }
	case "$APSSID" in ''|' '*|*' '|*[!A-Za-z0-9._~+=,:@%^*\ -]*) echo "ssid: 1-32 of [A-Za-z0-9 ._~+=,:@%^*-], no blank at either end"; exit 2 ;; esac
	[ ${#APSSID} -le 32 ] || { echo "ssid longer than 32"; exit 2; }
	case "$AP" in ''|*[!A-Za-z0-9._~+=,:@%^*-]*) echo "passphrase: 12-63 of [A-Za-z0-9._~+=,:@%^*-]"; exit 2 ;; esac
	[ ${#AP} -ge 12 ] && [ ${#AP} -le 63 ] || { echo "passphrase: 12-63 characters"; exit 2; }
	[ "$AP" != "$PLACEHOLDER" ] || { echo "refusing the placeholder as a key"; exit 2; }
	p3_staged && { echo "another writer has staged wireless changes — nothing changed" >&2; exit 5; }
	oldkey=$(uci -q get "wireless.$APSEC.key"); oldssid=$(uci -q get "wireless.$APSEC.ssid"); olddis=$(uci -q get "wireless.$APSEC.disabled")
	oldmark=""; [ -f "$MARK" ] && read -r oldmark < "$MARK"
	if [ "$oldkey" = "$AP" ] && [ "$oldssid" = "$APSSID" ] && [ "$olddis" != 1 ] && p3_ap_up "$APSEC" "$APSSID"; then
		p3_fresh_or_save && { echo "AP $APSEC already on the air with this ssid and key — nothing changed (p5 fresh)"; exit 0; }
		echo "AP already set, but p5 is not fresh and saving failed" >&2; exit 4
	fi
	# fail-closed BEFORE anything is written: a real previous key / ssid that `uci batch` cannot take back (a quote,
	# backslash or line break, set outside the app) could not be restored if this change failed (P3 security r2 m1)
	if [ -n "$oldkey" ] && [ "$oldkey" != "$PLACEHOLDER" ] && { ! p3_quotable "$oldkey" || ! p3_quotable "$oldssid"; }; then
		echo "the current AP key / ssid has a quote, backslash or line break (set outside the app): it could not be restored on a failure — nothing changed"; exit 2
	fi
	# the passphrase by uci batch on stdin; the allowed set has no ' -> single quotes are safe
	printf "set wireless.%s.key='%s'\nset wireless.%s.ssid='%s'\ndelete wireless.%s.disabled\n" "$APSEC" "$AP" "$APSEC" "$APSSID" "$APSEC" | uci batch 9>&- >/dev/null 2>&1
	rest=""; for s in $oldmark; do [ "$s" = "$APSEC" ] || rest="$rest $s"; done
	if [ -n "$rest" ]; then echo "$rest" > "$MARK.tmp" && mv -f "$MARK.tmp" "$MARK"; else rm -f "$MARK"; fi
	uci commit wireless
	if [ "$(uci -q get "wireless.$APSEC.key")" != "$AP" ] || [ "$(uci -q get "wireless.$APSEC.ssid")" != "$APSSID" ] || [ -n "$(uci -q get "wireless.$APSEC.disabled")" ]; then
		rc=3; why="uci read back (the new key / ssid did not land)"
	else
		logger -t halow-setkey "p3: AP $APSEC paired (ssid set, key set), reloading wifi"
		wifi reload >/dev/null 2>&1 9>&- || wifi 9>&-
		i=0; up=0; while [ "$i" -lt "$READBACK_WAIT" ]; do p3_ap_up "$APSEC" "$APSSID" && { up=1; break; }; sleep 1; i=$((i + 1)); done
		if [ "$up" = 1 ]; then
			if p3_persist; then echo "AP $APSEC on the air with the new ssid after ${i}s; persisted"; exit 0; fi
			rc=4; why="persist"
		else rc=3; why="read back (the AP did not come up with the new ssid within ${READBACK_WAIT}s)"; fi
	fi
	# back to the previous state: a placeholder key goes back BLOCKED (setkey refuses the placeholder as a value)
	if [ "$oldkey" = "$PLACEHOLDER" ] || [ -z "$oldkey" ]; then
		printf "set wireless.%s.key='%s'\nset wireless.%s.disabled='1'\n" "$APSEC" "$PLACEHOLDER" "$APSEC" | uci batch 9>&- >/dev/null 2>&1
		if [ -n "$oldssid" ]; then uci -q set "wireless.$APSEC.ssid=$oldssid"; else uci -q delete "wireless.$APSEC.ssid"; fi
		new=$oldmark; case " $new " in *" $APSEC "*) ;; *) new="$new $APSEC" ;; esac
		echo $new > "$MARK.tmp" && mv -f "$MARK.tmp" "$MARK"
		uci commit wireless; wifi reload >/dev/null 2>&1 9>&- || wifi 9>&-
		i=0; off=0; while [ "$i" -lt 30 ]; do p3_ap_off && { off=1; break; }; sleep 1; i=$((i + 1)); done
		if [ "$off" = 0 ]; then   # D-6: once more with a full reconfigure before calling it unknown
			wifi 9>&-; i=0; while [ "$i" -lt 30 ]; do p3_ap_off && { off=1; break; }; sleep 1; i=$((i + 1)); done
		fi
		if [ "$off" != 1 ]; then echo "AP: $why failed — RESTORE NOT VERIFIED (still on the air)" >&2; rc=6
		elif { [ "$rc" = 3 ] && batman-config-save --check >/dev/null 2>&1 9>&-; } || p3_persist; then echo "AP: $why failed — back to blocked (placeholder, off the air)" >&2
		else echo "AP: $why failed — back to blocked live, saving it failed again (status shows p5 not fresh)" >&2; fi
	else   # (the previous values are quotable: checked before the change)
		# an empty previous ssid is deleted, not written as '' (B r2 C1)
		if [ -n "$oldssid" ]; then printf "set wireless.%s.key='%s'\nset wireless.%s.ssid='%s'\n" "$APSEC" "$oldkey" "$APSEC" "$oldssid"
		else printf "set wireless.%s.key='%s'\ndelete wireless.%s.ssid\n" "$APSEC" "$oldkey" "$APSEC"; fi | uci batch 9>&- >/dev/null 2>&1
		[ "$olddis" = 1 ] && uci -q set "wireless.$APSEC.disabled=1"
		[ -n "$oldmark" ] && { echo "$oldmark" > "$MARK.tmp" && mv -f "$MARK.tmp" "$MARK"; }
		uci commit wireless; wifi reload >/dev/null 2>&1 9>&- || wifi 9>&-
		i=0; back=0
		# disabled, or no ssid (an AP without one is not on the air): verified OFF; else back on the air with its ssid
		if [ "$olddis" = 1 ] || [ -z "$oldssid" ]; then while [ "$i" -lt 30 ]; do p3_ap_off && { back=1; break; }; sleep 1; i=$((i + 1)); done
		else while [ "$i" -lt "$READBACK_WAIT" ]; do p3_ap_up "$APSEC" "$oldssid" && { back=1; break; }; sleep 1; i=$((i + 1)); done; fi
		if [ "$back" != 1 ]; then echo "AP: $why failed — RESTORE NOT VERIFIED (the previous AP state did not come back: disabled=${olddis:-0})" >&2; rc=6
		elif { [ "$rc" = 3 ] && batman-config-save --check >/dev/null 2>&1 9>&-; } || p3_persist; then echo "AP: $why failed — back to the previous ssid / key" >&2
		else echo "AP: $why failed — back to the previous ssid / key live, saving it failed again (status shows p5 not fresh)" >&2; fi
	fi
	exit "$rc"
fi

# ---- --forget-mesh (#254 §6, `network/leave` and Finish) ------------------------------------------
# Placeholder key on the morse radio's mesh interface(s) AND the keyguard block of that radio (uci disabled=1 + the
# radio merged into the keyguard mark, as halow-keyguard writes it), staged together and committed ONCE: a committed
# placeholder on an enabled radio would put the public key on the air. Then verified: no mesh netdev and netifd
# reports the radio up=false disabled=true.
# #254 §19.3 — the escalation's helpers. morse_phy: the phyN whose device is uci wireless.<radio>.path (04: phy0 <->
# .../spi0/spi0.0); none or two matches -> empty (no escalation). orphan_netdevs: the mesh-point netdevs on that phy.
# radio_released: netifd reports the radio down, disabled and not pending (it has nothing left to tear down). s1g_ok:
# the pid is a root wpa_supplicant_s1g by /proc (an argv impostor, or ` (deleted)`, is not accepted).
morse_phy() {
	mp_path=$(uci -q get "wireless.$1.path"); [ -n "$mp_path" ] || return 1
	mp_n=""
	for mp_p in "$IEEE80211"/phy*; do
		[ -e "$mp_p/device" ] || continue
		case "$(readlink -f "$mp_p/device" 2>/dev/null)" in */"$mp_path") [ -z "$mp_n" ] || return 1; mp_n=${mp_p##*/} ;; esac
	done
	[ -n "$mp_n" ] && echo "$mp_n"
}
orphan_netdevs() {
	for on_d in $(iw dev 2>/dev/null 9>&- | awk '/^\tInterface/{i=$2} /type mesh point/{print i}'); do
		on_p=$(readlink -f "$NETCLASS/$on_d/phy80211" 2>/dev/null); [ "${on_p##*/}" = "$1" ] && echo "$on_d"
	done
}
radio_released() {
	rr_st=$(wl_status) || return 1
	[ "$(wl_field "$rr_st" "$1" up)" = false ] && [ "$(wl_field "$rr_st" "$1" disabled)" = true ] && [ "$(wl_field "$rr_st" "$1" pending)" = false ]
}
s1g_ok() { [ "$(readlink "$PROC/$1/exe" 2>/dev/null)" = "$S1G_EXE" ] && [ "$(awk '/^Uid:/{print $2}' "$PROC/$1/status" 2>/dev/null)" = "$S1G_UID" ]; }
ere_escape() { printf '%s' "$1" | sed 's/\./\\./g'; }   # a netdev name: [A-Za-z0-9_.-]; `.` is the only ERE metacharacter
radio_down() {   # $1 = radio; netifd's view (the same one `wifi status` prints)
	st=$(ubus call network.wireless status 2>/dev/null 9>&-)
	[ "$(printf '%s' "$st" | jsonfilter -e "@.$1.up" 2>/dev/null 9>&-)" = false ] && [ "$(printf '%s' "$st" | jsonfilter -e "@.$1.disabled" 2>/dev/null 9>&-)" = true ]
}
if [ "$FORGET" = 1 ]; then
	RADIO=$(morse_radio)
	[ -n "$RADIO" ] || { echo "no morse (HaLow) radio in uci — nothing to forget"; exit 2; }
	ms=""; for s in $(mesh_ifaces); do [ "$(uci -q get "wireless.$s.device")" = "$RADIO" ] && ms="$ms $s"; done
	[ -n "$ms" ] || { echo "no mesh interface on $RADIO — nothing to forget"; exit 2; }
	# the mark first (atomic rename; keyguard's entries — blocked APs — are kept): a mark without the commit is harmless
	# (keyguard / setkey only delete `disabled` of what it lists), a commit without the mark would let setkey's
	# release logic miss the radio
	prev=""; [ -f "$MARK" ] && { read -r prev < "$MARK" || true; }
	inmark=0; for s in $prev; do [ "$s" = "$RADIO" ] && inmark=1; done
	# #254 §15.6 (B m4): a radio switched off by hand (disabled=1, not in the mark) stays the operator's switch — it is
	# kept off but NOT added to the mark, so a later setkey / join never switches it on behind the operator's back
	if [ "$(uci -q get "wireless.$RADIO.disabled")" = 1 ] && [ "$inmark" = 0 ]; then
		echo "$RADIO is switched off by hand — kept off, left out of the keyguard mark"
	else
		new=""; for s in $prev; do [ "$s" = "$RADIO" ] || new="$new $s"; done; new="$new $RADIO"
		{ echo "$new" > "$MARK.tmp" && mv -f "$MARK.tmp" "$MARK"; } || { rm -f "$MARK.tmp"; echo "cannot write $MARK — nothing changed"; exit 2; }
	fi
	for s in $ms; do uci -q set "wireless.$s.key=$PLACEHOLDER"; done
	uci -q set "wireless.$RADIO.disabled=1"
	uci commit wireless
	logger -t halow-setkey "forget mesh: placeholder key on:$ms, radio $RADIO blocked; reloading wifi"
	wifi reload >/dev/null 2>&1 9>&- || wifi 9>&-
	i=0; ok=0
	while :; do
		[ -z "$(mesh_netdev)" ] && radio_down "$RADIO" && { ok=1; break; }
		[ "$i" -ge "$FORGET_WAIT" ] && break
		sleep 1; i=$((i + 1))
	done
	if [ "$ok" != 1 ]; then
		# ---- escalation (#254 §19.3) — only when netifd has RELEASED the radio (down, disabled, not pending) and a
		# mesh netdev of the morse phy is still there: the orphan of §19.1 (its wpa_supplicant_s1g + netdev survived a
		# reload that landed inside netifd's setup; netifd has nothing left to tear down, so only a reboot cleared it).
		# netifd's status is read again before every kill and del: an operator's `wifi up` meanwhile makes netifd the
		# owner again and the escalation stops. A kill needs the pid to be a root wpa_supplicant_s1g (/proc), never
		# an argv impostor. The log line names the netdev and pids only.
		phy=$(morse_phy "$RADIO"); esc=""
		if [ -n "$phy" ] && radio_released "$RADIO"; then
			for d in $(orphan_netdevs "$phy"); do
				esc="$esc $d"; pids=$(pgrep -f "wpa_supplicant_s1g .*-i $(ere_escape "$d")( |\$)" 9>&-)
				[ -n "$pids" ] || logger -t halow-setkey "forget: no wpa_supplicant_s1g for orphan $d"
				for p in $pids; do
					s1g_ok "$p" || continue
					radio_released "$RADIO" || break 2
					kill -TERM "$p" 2>/dev/null; j=0
					while [ "$j" -lt 3 ] && [ -d "$PROC/$p" ]; do sleep 1; j=$((j + 1)); done
					[ -d "$PROC/$p" ] && s1g_ok "$p" && radio_released "$RADIO" && kill -KILL "$p" 2>/dev/null
					esc="$esc s1g:$p"
				done
				radio_released "$RADIO" || break
				[ -d "$NETCLASS/$d" ] && iw dev "$d" del 9>&- 2>/dev/null
			done
			i=0
			while [ "$i" -lt 10 ]; do
				[ -z "$(mesh_netdev)" ] && radio_down "$RADIO" && { ok=1; break; }
				sleep 1; i=$((i + 1))
			done
			[ "$ok" = 1 ] && logger -t halow-setkey "forgotten after escalation (orphan$esc)"
		fi
	fi
	if [ "$ok" != 1 ]; then
		echo "forget: NOT verified — within ${FORGET_WAIT}s the mesh netdev is '$(mesh_netdev)' and $RADIO is not reported up=false disabled=true" >&2
		echo "persist: not attempted (forget unverified)"; exit 3
	fi
	echo "forgotten: placeholder key on:$ms, $RADIO blocked and down"
	persist_exit
fi

# ---- 1. validate everything BEFORE changing anything (validate(), shared with --check-only) -------
validate

# ---- 2. apply --------------------------------------------------------------------------------------
prev_chan=$(uci -q get "wireless.$RADIO.channel")
changed=""
for s in $(mesh_ifaces); do
	[ -n "$MESH" ] && { uci -q set "wireless.$s.key=$MESH"; uci -q set "wireless.$s.encryption=sae"; changed="$changed $s"; }
	[ -n "$MESHID" ] && { uci -q set "wireless.$s.mesh_id=$MESHID"; changed="$changed $s"; }
done
for s in $(ap_ifaces); do
	[ -n "$AP" ] && { uci -q set "wireless.$s.key=$AP"; changed="$changed $s"; }
done
[ -n "$CHAN" ] && { uci -q set "wireless.$RADIO.channel=$CHAN"; changed="$changed $RADIO"; }
# release what the guard disabled, but only where the key is no longer the placeholder
if [ -f "$MARK" ]; then
	rest=""; read -r prev < "$MARK"
	for s in $prev; do
		# entry is either a radio (blocked for a placeholder mesh key) or an AP iface
		if uci -q get "wireless.$s.type" >/dev/null; then   # radio
			ok=1; for m in $(mesh_ifaces); do [ "$(uci -q get "wireless.$m.device")" = "$s" ] && [ "$(uci -q get "wireless.$m.key")" = "$PLACEHOLDER" ] && ok=0; done
		else
			ok=1; [ "$(uci -q get "wireless.$s.key")" = "$PLACEHOLDER" ] && ok=0
		fi
		if [ "$ok" = 1 ]; then uci -q delete "wireless.$s.disabled"; else rest="$rest $s"; fi
	done
	if [ -n "$rest" ]; then echo "$rest" > "$MARK"; else rm -f "$MARK"; fi
fi
# #254 §19.2 rule 2: the morse radio is enabled after the release step (staged uci; a placeholder still blocking it,
# or a radio switched off by hand, stays `disabled=1`) -> netifd must report it up on the new settings below
ENABLED=0; [ -n "$RADIO" ] && [ "$(uci -q get "wireless.$RADIO.disabled")" != 1 ] && ENABLED=1
uci commit wireless
logger -t halow-setkey "config updated on:$changed${CHAN:+ channel=$CHAN}; reloading wifi"
wifi reload >/dev/null 2>&1 9>&- || wifi 9>&-
echo "applied on:$changed"
[ -f "$MARK" ] && echo "still blocked (placeholder key remains):$(cat "$MARK")"

# ---- 3. read back: netifd's word first (#254 §19.2 rule 2), then the chip as before --------------
# cfg_matches: netifd's reported running config == what was written (the status is from after our reload, not
# before it). Compared in-process with [ = ] only; the values are never printed or logged.
cfg_matches() {
	cm_st=$1
	[ -z "$CHAN" ] || [ "$(wl_field "$cm_st" "$RADIO" config.channel)" = "$CHAN" ] || return 1
	for cm_s in $(mesh_ifaces); do
		[ "$(uci -q get "wireless.$cm_s.device")" = "$RADIO" ] || continue
		cm_idx=$(printf '%s' "$cm_st" | jsonfilter -e "@.$RADIO.interfaces[*].section" 2>/dev/null 9>&- | awk -v s="$cm_s" '$0 == s { print NR - 1; exit }')
		[ -n "$cm_idx" ] || return 1
		[ -z "$MESH" ] || [ "$(wl_field "$cm_st" "$RADIO" "interfaces[$cm_idx].config.key")" = "$MESH" ] || return 1
		[ -z "$MESHID" ] || [ "$(wl_field "$cm_st" "$RADIO" "interfaces[$cm_idx].config.mesh_id")" = "$MESHID" ] || return 1
	done
	return 0
}
RC=0
deadline=60
if [ "$ENABLED" = 1 ]; then
	i=0; nup=""; gaveup=0
	while [ "$i" -lt "$READBACK_WAIT" ]; do
		# morse may write its hardware default back into uci when it rejects a channel: the channel block below handles it
		if [ -n "$CHAN" ] && [ "$(uci -q get "wireless.$RADIO.channel")" != "$CHAN" ]; then break; fi
		st=$(wl_status)
		if [ "$(wl_field "$st" "$RADIO" pending)" = false ]; then
			[ "$(wl_field "$st" "$RADIO" retry_setup_failed)" = true ] && { gaveup=1; break; }
			[ "$(wl_field "$st" "$RADIO" up)" = true ] && cfg_matches "$st" && { nup=$i; break; }
		fi
		sleep 1; i=$((i + 1))
	done
	if [ -z "$nup" ] && { [ -z "$CHAN" ] || [ "$(uci -q get "wireless.$RADIO.channel")" = "$CHAN" ]; }; then
		if [ "$gaveup" = 1 ]; then echo "unverified — netifd gave up bringing $RADIO up (retry_setup_failed); NOT persisting" >&2
		else echo "unverified — netifd did not report $RADIO up on the new settings within ${READBACK_WAIT}s; NOT persisting" >&2; fi
		echo "persist: not attempted (radio unverified)"; exit 3
	fi
	[ -n "$nup" ] && { logger -t halow-setkey "read-back: netifd up after ${nup} s"; deadline=$((READBACK_WAIT - nup)); [ "$deadline" -ge 10 ] || deadline=10; }
fi
if [ -n "$CHAN" ]; then
	# morse may write its hardware default back into uci when it rejects a channel (99-batman-chanfix)
	i=0; verified=0
	while [ "$i" -lt "$deadline" ]; do
		cur=$(uci -q get "wireless.$RADIO.channel")
		if [ "$cur" != "$CHAN" ]; then break; fi
		dev=$(mesh_netdev)
		if [ -n "$dev" ]; then
			khz=$(morse_cli -i "$dev" channel 2>/dev/null 9>&- | sed -n 's/^[[:space:]]*Operating Frequency:[[:space:]]*\([0-9]*\) kHz.*/\1/p' | head -1)
			[ "$khz" = "$CENTRE_KHZ" ] && { verified=1; break; }
		fi
		sleep 1; i=$((i + 1))
	done
	cur=$(uci -q get "wireless.$RADIO.channel")
	if [ "$cur" != "$CHAN" ]; then
		echo "radio rejected channel $CHAN (uci now holds $cur) — restoring channel ${prev_chan:-<unset>}, NOT persisting" >&2
		if [ -n "$prev_chan" ]; then uci -q set "wireless.$RADIO.channel=$prev_chan"; else uci -q delete "wireless.$RADIO.channel"; fi
		uci commit wireless; wifi reload >/dev/null 2>&1 9>&- || wifi 9>&-
		echo "persist: not attempted (channel rejected)"; exit 3
	fi
	if [ "$verified" != 1 ]; then
		# do NOT revert: peers may already have followed; just do not persist an unverified channel
		echo "unverified — the radio did not report $CENTRE_KHZ kHz within ${deadline}s (got '${khz:-?}'); re-run 'halow-setkey --channel $CHAN' to verify, NOT persisting" >&2
		echo "persist: not attempted (channel unverified)"; exit 3
	fi
	echo "radio on channel $CHAN ($khz kHz, $BW MHz)"
else
	# the netdev wait only when the radio is enabled (a blocked radio has none to wait for: #254 §19.2 rule 2)
	i=0; while [ "$ENABLED" = 1 ] && [ "$i" -lt 20 ] && [ -z "$(mesh_netdev)" ]; do sleep 1; i=$((i + 1)); done
	ok=1
	for s in $(mesh_ifaces); do [ -z "$MESH" ] || [ "$(uci -q get "wireless.$s.key")" = "$MESH" ] || ok=0; done
	[ "$ok" = 1 ] || { echo "read-back mismatch: uci does not hold the key just set" >&2; echo "persist: not attempted"; exit 3; }
fi

# ---- 4. persist (#202) -----------------------------------------------------------------------------
persist_exit
