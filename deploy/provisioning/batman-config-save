#!/bin/sh
# batman-config-save — write the per-node config delta + identity to the shared config
# partition (p5) so 96-batman-config-migrate can restore it onto a fresh A/B slot (#88/#89/#202).
#
# Design: the golden image bakes the mesh STRUCTURE (batman/bridge/firewall/mesh11sd, all
# identical across nodes); p5 holds only the per-node DELTA — hostname, mesh id/key, AP key,
# channel/country, the reserved IP, openmanetd flags — plus identity files (SSH host keys).
# Everything not listed here takes the new image's default on upgrade (new-default-wins).
#
#   batman-config-save --seed [--reformat]   first write at provisioning (--reformat: see below)
#   batman-config-save --save [--promote-lkg] [--txn TOK]   rewrite now (operator / halow-setkey / provd);
#                                            --txn (#254 wireless-txn §7, the helper's Finish only): allowed while the
#                                            run-dir marker AND /etc/batman-prov/.txn carry TOK
#   batman-config-save --if-healthy          rewrite only if joinwatch health is OK (#127)
#   batman-config-save --on-join             joinwatch, every tick while JOINED (#202 close-out)
#   batman-config-save --check               read-only: is p5 what a save would write right now?
#   batman-config-save --prov-only --prov-file F --prov-meta M [--prov-identity D] [--txn TOK]
#                                            (#254, batman-provhelper only) write the provisioning record:
#                                            identity/prov/ (only if p5 lacks a complete one) -> prov.cbor ->
#                                            prov.meta LAST. Never touches .seeded, overrides, lkg, dropbear
#                                            identity or shadow; allowed on an unseeded p5.
#   batman-config-save --prov-get DIR        (#254) read-only: copy prov.cbor, prov.meta, identity/prov/ to DIR
#
# Exit codes (docs/design/202-config-survival-closeout.md §4):
#   0 done (--on-join: p5 == live AND root has a password)        1 error (see stderr)
#   3 not applicable (--check: no p5 / not ext4 / bypass boot; --if-healthy: not OK)
#   4 --on-join: p5 == live but the node is still OPEN (no root password)
#   5 --check: p5 is STALE vs live (incl. a live value that cannot be persisted)
#   6 write modes: a live value could not be persisted (forbidden characters) — the rest was written
#   7 --check: p5 not seeded          8 --check / --prov-only / --prov-get: lock busy
#   --prov-get (#254, 254-stage1-impl §4.2): 0 complete prov + identity   7 ext4, unseeded, no prov
#     9 seeded, no prov   10 prov incomplete / sha mismatch / meta missing   13 prov but identity/prov incomplete
#     1 mount failed   3 bypass   11 no p5   12 not ext4   14 prov.meta v too new
#
# Writes p5 rw briefly and atomically (stage + rename + sync), keeps two copies (primary + lkg).
# One writer at a time (cfgsave.lock, #202 T6); the rw mount is VERIFIED rw — a concurrent ro reader
# makes a second mount of the same ext4 silently read-only (#202 T11) — and retried.
set -u
DEV=/dev/mmcblk0p5
SCHEMA=1
PRESERVE="
system.@system[0].hostname
wireless.default_radio1.mesh_id
wireless.default_radio1.key
wireless.default_radio0.key
wireless.radio1.channel
wireless.radio1.country
network.ahwlan.ipaddr
network.ahwlan.proto
openmanetd.config.dhcpconfigured
openmanetd.config.roipconfigured
"
UNSAFE='*[`$();|&<>'"'"']*'   # same character set 96-batman-config-migrate's valid_batch rejects

mode=${1:-}; opt=${2:-}
USAGE="usage: batman-config-save --seed [--reformat] | --save [--promote-lkg] [--txn TOK] | --if-healthy | --on-join | --check | --prov-only --prov-file F --prov-meta M [--prov-identity D] [--txn TOK] | --prov-get DIR"
case "$mode" in
	--seed|--save|--if-healthy|--on-join|--check|--prov-only|--prov-get) ;;
	*) echo "$USAGE" >&2; exit 1 ;;
esac
REFORMAT=0; PROMOTE=0; PF=""; PM=""; PI=""; PTXN=""; PGET=""; STXN=""; STXN_SET=0
case "$mode" in
--save)
	shift
	while [ $# -gt 0 ]; do
		case "$1" in
			--promote-lkg) PROMOTE=1; shift ;;
			--txn) STXN=${2:-}; STXN_SET=1; [ $# -ge 2 ] && shift 2 || shift ;;
			*) echo "batman-config-save: unknown option $1 for --save" >&2; exit 1 ;;
		esac
	done
	# the helper's token is hex (node.go); anything else (empty, a space, the word "none") can never match a live one
	[ "$STXN_SET" = 0 ] || case "$STXN" in ''|none|*[!0-9a-f]*) echo "batman-config-save: --txn needs the transaction's hex token" >&2; exit 1 ;; esac ;;
--prov-only)
	shift
	while [ $# -gt 0 ]; do
		case "$1" in
			--prov-file) PF=${2:-}; shift 2 ;; --prov-meta) PM=${2:-}; shift 2 ;;
			--prov-identity) PI=${2:-}; shift 2 ;; --txn) PTXN=${2:-}; shift 2 ;;
			*) echo "batman-config-save: unknown option $1 for --prov-only" >&2; exit 1 ;;
		esac
	done
	[ -n "$PF" ] && [ -n "$PM" ] || { echo "$USAGE" >&2; exit 1; } ;;
--prov-get)
	PGET=$opt; [ -n "$PGET" ] && [ $# -eq 2 ] || { echo "$USAGE" >&2; exit 1; } ;;
*)
	case "$mode:$opt" in
		--seed:--reformat) REFORMAT=1 ;; --save:--promote-lkg) PROMOTE=1 ;;
		*:) ;; *) echo "batman-config-save: unknown option $opt for $mode" >&2; exit 1 ;;
	esac ;;
esac
[ "$(id -u)" = 0 ] || { echo "batman-config-save: root only" >&2; exit 1; }
up() { cut -d. -f1 /proc/uptime; }
say() { echo "batman-config-save: $*"; }
err() { echo "batman-config-save: $*" >&2; }
PROVD=/etc/batman-prov                     # overlay copy (owned by batman-provhelper)
# #254 §15.3 (code review 2 B MAJOR-1): an unfinished network change (.txn, per slot) makes --check STALE before anything
# else — before the no-p5 / bypass / lock / ext4 / mount checks, so an unreadable p5 (the usual reason .txn stays) never
# turns the OTA gate's verdict into "skip" / "error". An OTA now would drop the helper's obligation to finish it.
if [ "$mode" = --check ] && { [ -e "$PROVD/.txn" ] || [ -L "$PROVD/.txn" ]; }; then
	say "p5 stale: an unfinished network change (.txn) — the helper finishes it at the next app action or reboot"; exit 5
fi

# ---- run dir (#280) and the files that live there --------------------------------------------
# shellcheck source=/dev/null
[ -r /usr/lib/batman/rundir.sh ] && . /usr/lib/batman/rundir.sh   # root-only run dir (never /tmp)
RUNDIR=${RUNDIR:-/nonexistent/batman-rundir}
RDOK=0; type batman_rundir >/dev/null 2>&1 && batman_rundir 2>/dev/null && RDOK=1
ST=$RUNDIR/cfgsave-onjoin.state          # --on-join fingerprint cache (#263 M0)
GATEFAIL=$RUNDIR/cfgsave-pi3gate.failed   # Pi 3 factory gate failed this boot
MNTFAIL=$RUNDIR/cfgsave-mount.failed      # "<uptime> <reason>": the LAST rw mount attempt failed (cleared on success)
FROZEN=$RUNDIR/cfgsave-frozen           # --on-join met an identity mismatch this boot (#254 P-U6): skip until another write mode or reboot
LOCK=$RUNDIR/cfgsave.lock                 # one writer at a time (dir: pid, uptime)
BUSY=$RUNDIR/cfgsave-lock.busy            # --on-join was lock-blocked >= 8 calls in a row (cleared when anyone gets the lock)
BUSYCNT=$RUNDIR/cfgsave-lock.count
WRITES=$RUNDIR/cfgsave-writes             # "<n> <uptime>": actual p5 writes this boot (write-amplification guard)
[ "$RDOK" = 1 ] || { ST=/nonexistent/cfgsave; GATEFAIL=$ST; MNTFAIL=$ST; FROZEN=$ST; BUSY=$ST; BUSYCNT=$ST; WRITES=$ST; }

tmpd() { batman_tmp -d "$1" 2>/dev/null || mktemp -d "/tmp/$1.XXXXXX"; }
tmpf() { batman_tmp "$1" 2>/dev/null || mktemp "/tmp/$1.XXXXXX"; }

# ---- cleanup on every exit path ---------------------------------------------------------------
LOCK_MINE=0; MNT=""; STAGE=""; UCIDIR=""
cleanup() {
	[ -n "$STAGE" ] && rm -rf "$STAGE"
	if [ -n "$MNT" ]; then grep -q " $MNT " /proc/mounts 2>/dev/null && { sync; umount "$MNT" 2>/dev/null; }; rmdir "$MNT" 2>/dev/null; fi
	[ -n "$UCIDIR" ] && rm -rf "$UCIDIR"
	[ "$LOCK_MINE" = 1 ] && rm -rf "$LOCK"
}
trap cleanup EXIT
# #254 review 3 (B m5 / A m8): busybox ash runs no EXIT trap when a signal kills it, and batman-provhelper's Exec deadline
# sends TERM to the whole process group. Trap TERM / INT: `exit` from the trap runs the EXIT trap above (unmount p5,
# remove the stage, release the lock) and returns 143 / 130. Every p5 file is replaced by rename (below), so a child
# killed mid-copy leaves at most a temp / stage file, never a half-written p5 file.
trap 'exit 143' TERM
trap 'exit 130' INT

# committed values only (#202 C0): a `uci set` not yet committed must not reach p5 — the running
# config after a reboot would then be behind p5. -P <empty dir> hides the pending delta.
UCIDIR=$(tmpd cfgsave-uci) || UCIDIR=""
uget() { if [ -n "$UCIDIR" ]; then uci -q -P "$UCIDIR" get "$1"; else uci -q get "$1"; fi; }

WRITE=1; { [ "$mode" = --check ] || [ "$mode" = --prov-get ]; } && WRITE=0
bypass=0; grep -q 'batman_bypass=1' /proc/cmdline 2>/dev/null && bypass=1

# ---- applicability --------------------------------------------------------------------------
if [ ! -b "$DEV" ]; then
	[ "$mode" = --prov-get ] && { say "p5 SKIP no-p5"; exit 11; }
	[ "$WRITE" = 1 ] && { err "no $DEV"; exit 1; }
	say "p5 SKIP no-p5"; exit 3
fi
if [ "$bypass" = 1 ]; then
	[ "$WRITE" = 1 ] && { err "bypass boot (batman_bypass=1): refusing to persist image defaults over p5"; exit 1; }
	say "p5 SKIP bypass"; exit 3
fi
# tier note (#202/#111): DEV is the plain p5 (civilian, no crypto chip). A Secure-tier (608B) node
# encrypts p5 with LUKS; its plaintext ext4 lives on the cryptsetup mapper, which the LUKS software
# path (#111) opens — batman-config-save must then resolve DEV to that mapper. Until #111 lands we
# only ever see a plain-ext4 p5. The one hard rule that keeps this forward-safe: NEVER mkfs a
# non-ext4 partition (that would silently reformat a LUKS p5 -> data loss + security downgrade,
# review finding #1), so only --seed may format, and only a genuinely raw/plain p5 (or, with
# --reformat, an ext4 p5 that provably no longer mounts — guards below).
magic=$(hexdump -s 1080 -n 2 -e '2/1 "%02x"' "$DEV" 2>/dev/null)
sbstamp() { hexdump -s 1072 -n 6 -e '1/4 "%u" " " 1/2 "%u"' "$DEV" 2>/dev/null; }

# ---- #254 provisioning record: formats (254-stage1-impl §4.3) ----------------------------------
# shellcheck source=/dev/null
PROVLIB=0; [ -r /usr/lib/batman/prov-lock.sh ] && . /usr/lib/batman/prov-lock.sh && type prov_meta_ok >/dev/null 2>&1 && PROVLIB=1
case "$mode" in --prov-only|--prov-get) [ "$PROVLIB" = 1 ] || { echo "batman-config-save: /usr/lib/batman/prov-lock.sh missing — refusing $mode" >&2; exit 1; } ;; esac
# identity_mismatch <p5 mount>: overlay and p5 both hold an identity sha list and they differ (P-U6 frozen node)
identity_mismatch() {
	[ -f "$PROVD/identity/sha256" ] && [ -f "$1/identity/prov/sha256" ] && ! cmp -s "$PROVD/identity/sha256" "$1/identity/prov/sha256"
}
prov_compare() {	# --check (#254 P1 §4.8): runs BEFORE the unseeded early exit. $1 = p5 mount
	[ -f "$PROVD/prov.meta" ] || return 0              # no overlay prov (pre-P1 slot / no helper): nothing to compare
	if identity_mismatch "$1"; then
		say "p5 stale: prov-identity (overlay and p5 hold different identities — owner action or reflash needed, not --persist-now)"; exit 5
	fi
	if [ -f "$PROVD/identity/sha256" ] && [ ! -f "$1/identity/prov/sha256" ]; then
		say "p5 stale: prov-identity-missing (p5 lacks the identity this slot has; the helper re-persists it at the next boot only if p5 still shows this node's sn and an older-or-equal generation, otherwise the node stays unknown(identity-lost) until the owner acts)"; exit 5
	fi
	cmp -s "$PROVD/prov.meta" "$1/prov.meta" || { say "p5 stale: prov"; exit 5; }
	return 0
}

# ---- #254: a provisioning transaction in progress makes the periodic writers yield --------------
TXN=$RUNDIR/prov-txn
txn_live() { { [ "$RDOK" = 1 ] && [ -f "$TXN" ] && [ -O "$TXN" ]; } || [ -e "$PROVD/.txn" ] || [ -L "$PROVD/.txn" ]; }   # .txn by existence, as TxnPresent
# the txn sequence (#254 wireless-txn §7): "<marker token|none> <.txn token|none>". Read before staging and again
# right before the p5 write: a transaction that started in between makes this save stale -> abort, next tick.
txn_seq() {
	m=none; [ "$RDOK" = 1 ] && [ -f "$TXN" ] && [ -O "$TXN" ] && { m=$(head -c 128 "$TXN"); [ -n "$m" ] || m=empty; }
	t=none; if [ -e "$PROVD/.txn" ] || [ -L "$PROVD/.txn" ]; then t=""; read -r t _ < "$PROVD/.txn" 2>/dev/null; [ -n "$t" ] || t=unreadable; fi
	printf '%s %s' "$m" "$t"
}
SEQ0=""
case "$mode" in
	--on-join) txn_live && { err "provisioning transaction in progress — next tick"; exit 1; }; SEQ0=$(txn_seq) ;;
	--save|--if-healthy)
		if [ -n "$STXN" ]; then
			# the helper's Finish persists BEFORE it removes .txn (§3): only while the marker and .txn carry its token
			[ "$(txn_seq)" = "$STXN $STXN" ] || { err "--txn $STXN does not match the live transaction (run-dir marker and .txn)"; exit 1; }
		else
			i=0; while txn_live; do i=$((i + 1)); [ "$i" -gt 10 ] && { err "provisioning transaction still in progress after 10 s — not saving"; exit 1; }; sleep 1; done
		fi
		SEQ0=$(txn_seq) ;;
	--prov-only)
		if [ -n "$PTXN" ]; then
			[ "$RDOK" = 1 ] && [ -f "$TXN" ] && [ -O "$TXN" ] && [ "$(head -c 128 "$TXN")" = "$PTXN" ] || { err "--txn $PTXN does not match the live transaction"; exit 1; }
		elif [ "$RDOK" = 1 ] && [ -f "$TXN" ]; then
			err "a provisioning transaction is live — --prov-only without its --txn refused"; exit 1
		fi ;;
esac
# #254 §15.6 (B m1): a mode without --txn writes only while NO transaction exists — one that started between the check
# above and SEQ0 is caught here (and the re-check before the p5 write compares against this SEQ0 = "none none")
case "$mode" in --save|--if-healthy|--on-join)
	[ -n "$STXN" ] || [ "$SEQ0" = "none none" ] || { err "provisioning transaction in progress — next tick"; exit 1; } ;;
esac
# validate the inputs of --prov-only before taking the lock (no p5 access)
if [ "$mode" = --prov-only ]; then
	set -- $(prov_meta_ok "$PM"); [ $# = 4 ] || { err "--prov-meta $PM is malformed"; exit 1; }
	NEWGEN=$3; NEWSHA=$4
	prov_cbor_ok "$PF" "$NEWSHA" || { err "--prov-file $PF is not a regular file <= $PROV_MAX B matching the meta sha"; exit 1; }
	[ -z "$PI" ] || prov_ident_ok "$PI" || { err "--prov-identity $PI is not a complete identity (7 files, sha256 list)"; exit 1; }
fi
if [ "$mode" = --prov-get ]; then
	case "$PGET" in /*) ;; *) err "--prov-get needs an absolute path"; exit 1 ;; esac
	[ ! -e "$PGET" ] && [ ! -L "$PGET" ] || { err "--prov-get $PGET already exists"; exit 1; }
	( umask 077; mkdir "$PGET" ) || { err "cannot create $PGET"; exit 1; }
fi

# ---- the lock (#202 A2) ----------------------------------------------------------------------
# Takeover = pid gone OR its cmdline is not a batman-config-save (pids are small and reused).
lock_try() {
	mkdir "$LOCK" 2>/dev/null && return 0
	p=$(cat "$LOCK/pid" 2>/dev/null)
	if [ -n "$p" ] && [ "$p" != $$ ] && kill -0 "$p" 2>/dev/null && tr '\0' ' ' < "/proc/$p/cmdline" 2>/dev/null | grep -q batman-config-save; then
		return 1
	fi
	err "taking over a stale lock (pid ${p:-?} is gone)"; rm -rf "$LOCK"; mkdir "$LOCK" 2>/dev/null
}
lock_age() { a=$(cat "$LOCK/uptime" 2>/dev/null); case "$a" in ''|*[!0-9]*) echo "?" ;; *) echo $(( $(up) - a )) ;; esac; }
if [ "$RDOK" = 1 ]; then
	case "$mode" in --on-join) wait=0 ;; --check|--prov-get) wait=5 ;; *) wait=10 ;; esac
	i=0
	until lock_try; do
		[ "$i" -ge "$wait" ] && {
			p=$(cat "$LOCK/pid" 2>/dev/null)
			case "$mode" in
				--on-join)
					n=$(cat "$BUSYCNT" 2>/dev/null); case "$n" in ''|*[!0-9]*) n=0 ;; esac; n=$((n + 1))
					( umask 077; echo "$n" > "$BUSYCNT" )
					if [ "$n" -ge 8 ] && [ ! -f "$BUSY" ]; then
						( umask 077; echo "$(up) pid=${p:-?}" > "$BUSY" )
						logger -t batman-config-save -p daemon.warn "p5 save blocked by a stuck batman-config-save (pid ${p:-?}, age $(lock_age)s) for $n ticks — p5 is NOT following the live config" 2>/dev/null
					fi
					exit 1 ;;
				--check) say "p5 error lock-busy pid=${p:-?} age=$(lock_age)s (kill $p if it is stuck; a D-state holder needs a reboot)"; exit 8 ;;
				--prov-only|--prov-get) err "lock busy (pid ${p:-?}, age $(lock_age)s)"; exit 8 ;;
				*) err "lock busy (pid ${p:-?}, age $(lock_age)s) — another batman-config-save is writing p5"; exit 1 ;;
			esac
		}
		sleep 1; i=$((i + 1))
	done
	echo $$ > "$LOCK/pid"; up > "$LOCK/uptime"; LOCK_MINE=1
	rm -f "$BUSY" "$BUSYCNT"
fi
# everything below reads uci / p5 only while holding the lock

# ---- --seed on a raw or broken p5 ------------------------------------------------------------
seed_key_ok() { grep -Eq '^[[:space:]]*(ssh-(ed25519|rsa|dss)|ecdsa-sha2-|sk-)' /etc/dropbear/authorized_keys 2>/dev/null; }
do_mkfs() {
	command -v mkfs.ext4 >/dev/null 2>&1 || { err "mkfs.ext4 missing"; exit 1; }
	say "formatting $DEV (ext4, label batman-cfg)"
	# ONE -F only: e2fsprogs still refuses a mounted device with a single -F (never -F -F)
	mkfs.ext4 -F -q -L batman-cfg -m 0 "$DEV" >/dev/null 2>&1 || { err "mkfs.ext4 failed"; exit 1; }
	magic=53ef
}
if [ "$magic" != "53ef" ]; then
	if [ "$mode" = --seed ]; then
		seed_key_ok || { err "refusing --seed without a usable public key in /etc/dropbear/authorized_keys — a locked node with no key is unreachable. Install the operator public key first (#137)."; exit 1; }
		do_mkfs
	elif [ "$WRITE" = 1 ]; then
		err "p5 is not plain ext4 (magic=$magic) — run --seed first (or, on a Secure-tier LUKS p5, open it via #111)"; exit 1
	elif [ "$mode" = --prov-get ]; then
		say "p5 SKIP not-ext4"; exit 12
	else
		say "p5 SKIP not-ext4"; exit 3
	fi
elif [ "$REFORMAT" = 1 ]; then
	# --seed --reformat: the exit for a p5 whose ext4 is really broken (#202 C2). All guards must hold:
	# not mounted anywhere, a ro,noload mount fails 3x with an error that is NOT "busy/already mounted"
	# (that is a live rw holder, T11 — not damage), operator key present. Prints what is lost.
	grep -q "^$DEV " /proc/mounts && { err "--reformat refused: $DEV is mounted"; exit 1; }
	seed_key_ok || { err "--reformat refused: no usable public key in /etc/dropbear/authorized_keys (#137)"; exit 1; }
	m=$(tmpd cfgsave-ro) || exit 1; i=0; e=""
	while [ "$i" -lt 3 ]; do
		e=$(mount -t ext4 -o ro,noload "$DEV" "$m" 2>&1) && { umount "$m"; rmdir "$m"; err "--reformat refused: p5 mounts read-only just fine — nothing to repair"; exit 1; }
		sleep 1; i=$((i + 1))
	done
	rmdir "$m" 2>/dev/null
	case "$e" in *usy*|*already\ mounted*) err "--reformat refused: p5 is busy ($e) — someone holds it rw, it is not broken"; exit 1 ;; esac
	err "p5 ext4 does not mount: $e"
	dmesg 2>/dev/null | grep EXT4-fs | tail -5 >&2
	err "reformatting: p5's lkg/ copy and identity/ copy are LOST (the live config and keys are re-seeded from this slot now)"
	do_mkfs
fi

# ---- --on-join fast paths (#263 M0 cache, backoffs) -----------------------------------------
onjoin_fp() {
	{ echo "schema=$SCHEMA"
	  for t in $PRESERVE; do printf '%s=%s\n' "$t" "$(uget "$t")"; done
	  for f in /etc/dropbear/dropbear_ed25519_host_key /etc/dropbear/dropbear_rsa_host_key \
		/etc/dropbear/authorized_keys /etc/openmanet/config.yml; do
		if [ -s "$f" ]; then echo "$f $(sha256sum < "$f")"; else echo "$f -"; fi
	  done
	  echo "shadow $(grep '^root:' /etc/shadow 2>/dev/null | sha256sum)"
	} | sha256sum | cut -d' ' -f1
}
onjoin_record() {   # $1 = rc; only after p5 provably matches the inputs (written, or unchanged), p5 unmounted
	[ "$mode" = --on-join ] && [ -n "$FP" ] || return 0
	sb=$(sbstamp); [ -n "$sb" ] || return 0
	( umask 077; rm -f "$ST"; echo "$FP $sb $1" > "$ST" )
}
FP=""
if [ "$mode" = --on-join ]; then
	[ -f "$GATEFAIL" ] && [ -O "$GATEFAIL" ] && { err "Pi 3 factory check failed earlier this boot — skip (fix the card at the bench)"; exit 1; }
	# frozen (identity mismatch, #254 P-U6, round-7 A-M6): nothing --on-join may write; do not rw-mount p5 every tick (#263 M0)
	[ -f "$FROZEN" ] && [ -O "$FROZEN" ] && { err "frozen: this slot and p5 hold different node identities (refused earlier this boot) — skip"; exit 1; }
	# the last rw mount failed: back off 5 minutes instead of retrying every tick
	if [ -f "$MNTFAIL" ] && [ -O "$MNTFAIL" ]; then
		read -r t reason < "$MNTFAIL" 2>/dev/null || t=""; now=$(up)
		case "$t" in ''|*[!0-9]*) ;; *) [ $((now - t)) -lt 300 ] && { err "p5 rw mount failed $((now - t))s ago (${reason:-?}) — backing off"; exit 1; } ;; esac
	fi
	FP=$(onjoin_fp); [ "${#FP}" = 64 ] && case "$FP" in *[!0-9a-f]*) FP="" ;; esac || FP=""   # fail-safe: no valid fp -> no cache
	# cached verdicts 0/4/6 are all "p5 already holds what it can hold": 6 (an unpersistable value)
	# does not change by retrying, so it is cached too, else every tick would mount p5 again (#263 M0)
	if [ -n "$FP" ] && [ -f "$ST" ] && [ -O "$ST" ] && read -r cfp cwt cmc crc < "$ST" && [ "$cfp" = "$FP" ] \
		&& [ "$cwt $cmc" = "$(sbstamp)" ] && { [ "$crc" = 0 ] || [ "$crc" = 4 ] || [ "$crc" = 6 ]; }; then
		say "unchanged ($mode, cached this boot) — skip"
		exit "$crc"
	fi
elif [ "$WRITE" = 1 ]; then
	rm -f "$ST" "$FROZEN"   # other writers change p5: drop the on-join cache and the frozen marker
fi

if [ "$mode" = "--if-healthy" ]; then
	verdict=$(halow-status 2>/dev/null | sed -n 's/^HEALTH[[:space:]]*\[\([A-Z]*\)\].*/\1/p')
	case "$verdict" in OK) ;; *) say "health=$verdict (not OK) — skip"; exit 3 ;; esac
fi

# ---- mount -----------------------------------------------------------------------------------
MNT=$(tmpd cfgsave-mnt) || { err "no private mount point"; exit 1; }
if [ "$WRITE" = 1 ]; then
	# rw, VERIFIED rw: with a ro reader holding the same ext4, `mount` returns 0 but the new mount shares
	# the read-only superblock (#202 T11, probed on 02) — a write would then fail half-way. Retry, and only
	# after 5 failures record the marker; a success clears it (#202 T12: it used to stay for the whole boot).
	i=0; e=""
	while :; do
		if e=$(mount -t ext4 "$DEV" "$MNT" 2>&1); then
			opts=$(awk -v m="$MNT" '$2==m {print $4}' /proc/mounts)
			case "$opts" in rw*) break ;; esac
			e="rw mount came up read-only ($opts)"
			err "rw mount came up read-only — retry"   # fixed string, the D1 T11 probe looks for it (stderr + syslog)
			logger -t batman-config-save -p daemon.notice "rw mount came up read-only — retry ($opts; a ro reader holds p5, #202 T11)" 2>/dev/null
			umount "$MNT" 2>/dev/null
		fi
		i=$((i + 1)); [ "$i" -ge 5 ] && break
		sleep 1
	done
	if ! awk -v m="$MNT" '$2==m {print $4}' /proc/mounts | grep -q '^rw'; then
		[ "$mode" = --on-join ] && ( umask 077; echo "$(up) ${e:-mount-failed}" > "$MNTFAIL" )
		err "mount rw failed after $i tries: ${e:-?}"; exit 1
	fi
	rm -f "$MNTFAIL"
elif [ "$mode" = --prov-get ]; then
	i=0; STALE=""
	until mount -t ext4 -o ro "$DEV" "$MNT" 2>/dev/null; do
		i=$((i + 1))
		if [ "$i" -ge 3 ]; then
			mount -t ext4 -o ro,noload "$DEV" "$MNT" 2>/dev/null && { STALE=1; break; }
			say "p5 error mount (ro and ro,noload failed)"; exit 1
		fi
		sleep 1
	done
	[ -n "$STALE" ] && say "p5 prov maybe-stale (journal not replayed: ro,noload)"
else
	i=0
	until mount -t ext4 -o ro,noload "$DEV" "$MNT" 2>/dev/null; do
		i=$((i + 1)); [ "$i" -ge 3 ] && { say "p5 error mount (ro,noload failed 3x)"; exit 1; }
		sleep 1
	done
fi

# ---- Pi 3 factory gate (#209 v4.3 D2) --------------------------------------------------------
pi3_factory_check() {
	D=/dev/mmcblk0
	s7=$(cat /sys/class/block/mmcblk0p7/start 2>/dev/null) || return 0
	sec0=$(tmpf cfgsave-mbr) || return 1
	dd if="$D" bs=512 count=1 iflag=direct 2>/dev/null > "$sec0" || dd if="$D" bs=512 count=1 2>/dev/null > "$sec0"
	e() { o=$((446 + 16 * ($1 - 1))); echo "$(hexdump -s $((o + 4)) -n1 -e '1/1 "%02x"' "$sec0") $(hexdump -s $((o + 8)) -n4 -e '1/4 "%u"' "$sec0") $(hexdump -s "$o" -n1 -e '1/1 "%02x"' "$sec0")"; }
	[ "$(e 1 | cut -d' ' -f2)" = "$s7" ] || { rm -f "$sec0"; return 0; }      # not a Pi 3 card
	err=""
	[ "$(e 1)" = "0c $s7 80" ] || err="$err MBR[1]='$(e 1)'"
	[ "$(e 2 | cut -d' ' -f1,2)" = "0c $(cat /sys/class/block/mmcblk0p1/start)" ] || err="$err MBR[2]='$(e 2)'"
	[ "$(e 3 | cut -d' ' -f1,2)" = "0c $(cat /sys/class/block/mmcblk0p3/start)" ] || err="$err MBR[3]='$(e 3)'"
	[ "$(e 4 | cut -d' ' -f1)" = ee ] || err="$err MBR[4]='$(e 4)'"
	rm -f "$sec0"
	dsz=$(cat /sys/block/mmcblk0/size); pend=$(( $(cat /sys/class/block/mmcblk0p6/start) + $(cat /sys/class/block/mmcblk0p6/size) ))
	[ $((dsz - pend)) -le 32768 ] || err="$err p6-not-grown($((dsz - pend))-sectors-free)"
	m=$(tmpd cfgsave-p7) || return 1
	if mount -t vfat -o ro /dev/mmcblk0p7 "$m" 2>/dev/null; then
		for f in bootcode.bin autoboot.txt config.txt; do [ -f "$m/$f" ] || err="$err p7-lacks-$f"; done
		umount "$m"
	else
		err="$err p7-unmountable"
	fi
	rmdir "$m"
	[ -z "$err" ] || { [ "$mode" = --on-join ] && ( umask 077; : > "$GATEFAIL" ); err "Pi 3 card not ready to be provisioned:$err — fix at the bench (reflash) before seeding (#209 D2)"; exit 1; }
	say "Pi 3 factory check passed (hybrid MBR, p6 grown, p7 intact)"
}
# #254 P-U6 (round-6 A-M2 / B-M2): a node whose overlay and p5 hold different identities is FROZEN — no write mode may
# persist this slot's config, keys or shadow over the other identity's record (that is the X/Y mix §4.8 forbids).
if [ "$WRITE" = 1 ] && identity_mismatch "$MNT"; then
	err "refusing $mode: this slot and p5 hold different node identities (frozen, #254 P-U6) — owner action or reflash needed"
	logger -t batman-config-save -p daemon.warn "refused $mode: identity mismatch between this slot and p5 (frozen)" 2>/dev/null
	[ "$mode" = --on-join ] && ( umask 077; : > "$FROZEN" )
	exit 1
fi
if [ "$mode" = --prov-only ] && [ -n "$PI" ] && [ -f "$MNT/identity/prov/sha256" ] && ! cmp -s "$PI/sha256" "$MNT/identity/prov/sha256"; then
	err "refusing --prov-only: the identity offered is not the one on p5 (identities are written once)"; exit 1
fi
# --save included (#202 G4): it is now a first-seed path too (halow-setkey)
[ "$WRITE" = 1 ] && [ "$mode" != --if-healthy ] && [ "$mode" != --prov-only ] && [ ! -f "$MNT/.seeded" ] && [ -b /dev/mmcblk0p7 ] && pi3_factory_check

# ---- stage what a save writes (shared by every mode, --check included) -----------------------
HAS_SHADOW=0; ROOT_LOCKED=0; REJECTED=""
stage_overrides() {   # $1 = staging dir
	s=$1
	mkdir -p "$s/identity/dropbear"
	for f in dropbear_ed25519_host_key dropbear_rsa_host_key authorized_keys; do
		[ -s "/etc/dropbear/$f" ] && cp -a "/etc/dropbear/$f" "$s/identity/dropbear/$f"
	done
	if [ -s /etc/openmanet/config.yml ]; then
		mkdir -p "$s/identity/openmanet"; cp -a /etc/openmanet/config.yml "$s/identity/openmanet/config.yml"
	fi
	# per-node root password (#137): only a real crypt hash. 96 restores it before dropbear.
	rootline=$(grep '^root:' /etc/shadow 2>/dev/null)
	case "$rootline" in
		root:\$*) printf '%s\n' "$rootline" > "$s/identity/shadow-root"; chmod 600 "$s/identity/shadow-root"; HAS_SHADOW=1 ;;
		root:!*) ROOT_LOCKED=1 ;;   # #254: a provisioned node locks root without a hash — that is not "open"
	esac
	# per-node delta -> uci batch (scalars only). Single-quote values so spaces survive (N-R6); a value
	# with shell metacharacters or a quote CANNOT be persisted (96's valid_batch rejects the whole batch
	# otherwise) — it is reported, never silently dropped (#202 T4).
	: > "$s/overrides.uci"
	for t in $PRESERVE; do
		val=$(uget "$t") || continue
		[ -n "$val" ] || continue        # empty preserved key -> image default wins (documented)
		# shellcheck disable=SC2254  # $UNSAFE is a glob pattern on purpose
		case "$val" in $UNSAFE) REJECTED="$REJECTED $t"; continue ;; esac
		printf "set %s='%s'\n" "$t" "$val" >> "$s/overrides.uci"
	done
	echo "$SCHEMA" > "$s/schema_version"
}
same_identity() {   # every identity file this save would write is already on p5, byte for byte. Files only
	# on p5 (removed locally since) do not count: the write never deletes them either (cp -a), so
	# counting them would rewrite p5 every tick forever (review M0-R2).
	( cd "$STAGE/identity" && find . -type f ) | while IFS= read -r f; do
		cmp -s "$STAGE/identity/$f" "$MNT/identity/$f" || { echo differs; break; }
	done | grep -q differs && return 1
	return 0
}
p5_matches() { [ -f "$MNT/.seeded" ] && cmp -s "$STAGE/overrides.uci" "$MNT/overrides.uci" && cmp -s "$STAGE/schema_version" "$MNT/schema_version" && same_identity; }
diff_keys() {   # key names whose `set` line differs between stage and p5 (never the values)
	for t in $PRESERVE; do
		a=$(grep -F "set $t=" "$STAGE/overrides.uci" 2>/dev/null); b=$(grep -F "set $t=" "$MNT/overrides.uci" 2>/dev/null)
		[ "$a" = "$b" ] || printf '%s,' "$t"
	done
}

# ---- --check: read-only verdict (#202 C3) ----------------------------------------------------
if [ "$mode" = --check ]; then
	prov_compare "$MNT"
	[ -f "$MNT/.seeded" ] || { say "p5 unseeded"; exit 7; }
	STAGE=$(tmpd cfgsave-check) || { say "p5 error staging"; exit 1; }
	stage_overrides "$STAGE"
	keys=$(diff_keys); keys=${keys%,}
	if [ -n "$REJECTED" ]; then
		say "p5 stale: $(echo "$REJECTED" | tr ' ' ',' | sed 's/^,//') (unpersistable — change the value, --save cannot fix this)"; exit 5
	fi
	if p5_matches; then say "p5 fresh"; exit 0; fi
	[ -n "$keys" ] || keys="identity-or-schema"
	say "p5 stale: $keys"; exit 5
fi

# ---- #254 --prov-get: read-only copy + rc table (254-stage1-impl §4.2) ------------------------
if [ "$mode" = --prov-get ]; then
	has_meta=0; [ -e "$MNT/prov.meta" ] || [ -e "$MNT/prov.cbor" ] && has_meta=1
	if [ "$has_meta" = 0 ]; then
		[ -d "$MNT/identity/prov" ] && cp -a "$MNT/identity/prov" "$PGET/identity" 2>/dev/null
		if [ -f "$MNT/.seeded" ]; then say "p5 prov none (seeded)"; exit 9; fi
		say "p5 prov none (unseeded)"; exit 7
	fi
	mt=$(prov_meta_ok "$MNT/prov.meta"); mrc=$?
	[ "$mrc" = 2 ] && { say "p5 prov too-new"; exit 14; }
	set -- $mt
	if ! { [ $# = 4 ] && prov_cbor_ok "$MNT/prov.cbor" "$4"; }; then
		# round-8 A-m10 / B-m1: hand the reader what is there (raw meta, identity) so it can still refuse a downgrade
		# or an identity mismatch; the record itself is NOT copied (it failed its sha). The reader validates the meta.
		[ -f "$MNT/prov.meta" ] && cp -p "$MNT/prov.meta" "$PGET/prov.meta" 2>/dev/null
		[ -d "$MNT/identity/prov" ] && cp -a "$MNT/identity/prov" "$PGET/identity" 2>/dev/null
		say "p5 prov corrupt (meta missing/malformed or sha mismatch)"; exit 10
	fi
	cp -p "$MNT/prov.cbor" "$MNT/prov.meta" "$PGET/"
	if ! prov_ident_ok "$MNT/identity/prov"; then
		[ -d "$MNT/identity/prov" ] && cp -a "$MNT/identity/prov" "$PGET/identity" 2>/dev/null
		say "p5 prov identity-lost (state=$2 gen=$3)"; exit 13
	fi
	cp -a "$MNT/identity/prov" "$PGET/identity"
	say "p5 prov ok state=$2 gen=$3${STALE:+ maybe-stale}"; exit 0
fi

# ---- #254 --prov-only: the provisioning record, written in commit order ---------------------
if [ "$mode" = --prov-only ]; then
	rm -rf "$MNT/identity/prov.tmp" "$MNT/prov.cbor.tmp" "$MNT/prov.meta.tmp"
	if [ -n "$PI" ] && ! prov_ident_ok "$MNT/identity/prov"; then
		mkdir -p "$MNT/identity" && mkdir "$MNT/identity/prov.tmp" && chmod 700 "$MNT/identity/prov.tmp" || { err "identity staging failed"; exit 1; }
		for f in $PROV_IDFILES sha256; do cp "$PI/$f" "$MNT/identity/prov.tmp/$f" || { err "identity copy failed"; exit 1; }; done
		chmod 600 "$MNT/identity/prov.tmp"/*; chmod 644 "$MNT/identity/prov.tmp/node.cert"
		prov_ident_ok "$MNT/identity/prov.tmp" || { err "identity copy does not verify"; exit 1; }
		sync; rm -rf "$MNT/identity/prov"; mv "$MNT/identity/prov.tmp" "$MNT/identity/prov" || { err "identity rename failed"; exit 1; }
		sync
	fi
	cp "$PF" "$MNT/prov.cbor.tmp" && chmod 600 "$MNT/prov.cbor.tmp" && sync && mv "$MNT/prov.cbor.tmp" "$MNT/prov.cbor" && sync \
		|| { err "prov.cbor write failed"; exit 1; }
	cp "$PM" "$MNT/prov.meta.tmp" && chmod 600 "$MNT/prov.meta.tmp" && sync && mv "$MNT/prov.meta.tmp" "$MNT/prov.meta" && sync \
		|| { err "prov.meta write failed (prov.cbor already updated: --prov-get decides by gen)"; exit 1; }
	umount "$MNT" 2>/dev/null
	say "prov saved gen=$NEWGEN -> $DEV"; exit 0
fi

# ---- write modes -----------------------------------------------------------------------------
[ "$mode" = --seed ] && { seed_key_ok || { err "refusing --seed without a usable public key in /etc/dropbear/authorized_keys — a locked node with no key is unreachable. Install the operator public key first (#137)."; exit 1; }; }
STAGE="$MNT/.stage.$$"
rm -rf "$STAGE"; stage_overrides "$STAGE"
case "$mode" in --seed|--on-join|--save) [ "$HAS_SHADOW" = 1 ] || err "root has no password hash — persisting radio config only; node stays UNPROVISIONED (open) until a password is set (#137)" ;; esac
[ -n "$REJECTED" ] && err "cannot persist$REJECTED (forbidden characters: backtick \$ ( ) ; | & < > ') — change the value"

mark_mesh_expected() {
	# A seeded node is provisioned to live in a mesh: mirror that onto p6 so batman-autocommit's OTA gate
	# can require a mesh join without mounting p5 itself (#209 S4-5, ab-autocommit.md v2.2 N5).
	if { [ "$mode" = --seed ] || [ "$mode" = --on-join ]; } && grep -q " /opt/batdata " /proc/mounts 2>/dev/null; then
		[ -f /opt/batdata/state/mesh-expected ] || { mkdir -p /opt/batdata/state && echo "seeded $mode" > /opt/batdata/state/mesh-expected && sync; }
	fi
}
final_rc() { if [ -n "$REJECTED" ]; then echo 6; elif [ "$mode" = --on-join ] && [ "$HAS_SHADOW" = 0 ] && [ "$ROOT_LOCKED" = 0 ]; then echo 4; else echo 0; fi; }

# idempotency for --on-join (bounds re-writes while a node stays open, #104): skip the write when p5
# already holds exactly what this save would write — overrides, the proven lkg copy (a --save in between
# updates overrides but not lkg; this joined boot must rotate it, review M0-R3), schema, every identity file.
if [ "$mode" = --on-join ] && p5_matches && cmp -s "$STAGE/overrides.uci" "$MNT/lkg/overrides.uci"; then
	rm -rf "$STAGE"; STAGE=""; sync; umount "$MNT" 2>/dev/null
	say "unchanged ($mode) — skip"
	mark_mesh_expected
	rc=$(final_rc); onjoin_record "$rc"; exit "$rc"
fi

# write-amplification guard (#202 A3): after 20 real writes in one boot, at most one per 60 s
if [ "$mode" = --on-join ] && [ "$RDOK" = 1 ]; then
	read -r wn wl < "$WRITES" 2>/dev/null || { wn=0; wl=0; }
	case "$wn" in ''|*[!0-9]*) wn=0 ;; esac; case "$wl" in ''|*[!0-9]*) wl=0 ;; esac
	if [ "$wn" -ge 20 ] && [ $(( $(up) - wl )) -lt 60 ]; then
		rm -rf "$STAGE"; STAGE=""; umount "$MNT" 2>/dev/null
		err "write rate-limited ($wn writes this boot) — retry next tick"; exit 1
	fi
fi

# publish atomically. lkg = last config that was PROVEN good: rotate it on --seed (the baseline),
# --if-healthy / --on-join (this boot joined — the mesh key demonstrably works) and on an explicit
# --save --promote-lkg (the caller proved it); a bare --save (operator, unproven) must NOT clobber the
# last proven lkg (N-R8). 219 §6.4 follows this contract.
# txn sequence re-check, right before the p5 write (#254 wireless-txn §7)
if [ -n "$SEQ0" ] && [ "$(txn_seq)" != "$SEQ0" ]; then
	rm -rf "$STAGE"; STAGE=""; umount "$MNT" 2>/dev/null
	err "provisioning transaction started — next tick"; exit 1
fi
mkdir -p "$MNT/identity" "$MNT/lkg"
# identity files: renamed from the stage (same filesystem) into place, one by one — never copied over in place
( cd "$STAGE/identity" && find . -type f ) | while IFS= read -r f; do
	f=${f#./}; d=${f%/*}; [ "$d" = "$f" ] || mkdir -p "$MNT/identity/$d"
	mv -f "$STAGE/identity/$f" "$MNT/identity/$f"
done
mv "$STAGE/overrides.uci" "$MNT/overrides.uci"
if [ "$mode" = --seed ] || [ "$mode" = --if-healthy ] || [ "$mode" = --on-join ] || [ "$PROMOTE" = 1 ]; then
	cp -a "$MNT/overrides.uci" "$MNT/lkg/overrides.uci.tmp" && mv -f "$MNT/lkg/overrides.uci.tmp" "$MNT/lkg/overrides.uci"
fi
mv "$STAGE/schema_version" "$MNT/schema_version"
rm -rf "$STAGE"; STAGE=""
: > "$MNT/.seeded"        # sentinel written LAST (DR-2)
sync
umount "$MNT" 2>/dev/null
if [ "$mode" = --on-join ] && [ "$RDOK" = 1 ]; then
	wn=$((wn + 1)); ( umask 077; echo "$wn $(up)" > "$WRITES" )
	[ "$wn" = 20 ] && logger -t batman-config-save -p daemon.warn "20 p5 writes this boot — a config value is churning; further writes limited to one per 60 s" 2>/dev/null
fi
say "saved ($mode) schema=$SCHEMA -> $DEV${REJECTED:+ (rejected:$REJECTED)}"
mark_mesh_expected
rc=$(final_rc)
onjoin_record "$rc"
exit "$rc"
