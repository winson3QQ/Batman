#!/bin/sh
# 95-batman-storage — OpenWrt first-boot storage provisioning (#88) + crash/reboot capture (#61).
#
# Runs ONCE on the end user's first boot (OpenWrt runs /etc/uci-defaults/* then deletes each
# on exit 0), BEFORE services need the data area. Baked into the golden image by
# depersonalise.sh, so every flashed card provisions itself — no operator, no manual scripts.
# This is the productionised form of deploy/provisioning/firstboot-provision.sh (validated on
# hardware): carve the SD free space into an (optionally LUKS) expand-to-fill data partition,
# ext4, and install the persistent `batdata-mount` init.
#
# The init it installs is the p5 "data partition" service (docs/storage-architecture.md):
#   START=11  mount before logd (S12) so anything wanting the data area finds it mounted
#   boot      mount; move /sys/fs/pstore records (kernel panics) to $MOUNT/crash; classify why
#             the previous life ended (PANIC / CLEAN / UNCLEAN) -> $MOUNT/log/boot-reasons.log
#   stop      clean shutdown/reboot: dump the syslog ring + a marker saying what triggered it
# Zero steady-state SD writes (#41): the SD is written only at boot (if a panic was captured)
# and at clean shutdown. Continuous log persistence is the EMS collector's job (#65).
#
# Ordering vs the #88 target scheme: this is the DATA partition (the real §B1 GPT p1..p5 layout
# is a later image-build change). dm-verity (#74/B2) and SE-sealed keys (#47/B3) are separate.
# If dm-crypt is unavailable it provisions UNENCRYPTED (loud syslog warning) — the image must
# add CONFIG_DM_CRYPT for encryption (#47).
#
# Idempotent + safe: only ever creates its own partition in the FREE SPACE (never p1/p2); never
# reformats a partition that already carries a filesystem; a non-zero exit makes OpenWrt re-run
# it next boot (used when the kernel needs a reboot to see a freshly-created partition).

# DISK is overridable ONLY so tests/ab-card-invariants.sh can run this script against a loop
# device; on a node it is always the SD card. DISKN is the sysfs/basename form.
DISK=${DISK:-/dev/mmcblk0}
DISKN=${DISK##*/}
LABEL=batdata
MAPPER=batdata_crypt
MOUNT=/opt/batdata
KEYFILE=/etc/batman-provision.key   # PLACEHOLDER (LUKS mode). Real key = secure element (#47/B3).
INIT=/etc/init.d/batdata-mount
# The ONLY licence to format: this script created the partition itself (step 1, legacy MBR card).
# A pre-made data partition (every A/B card: the builders mkfs p6) is never formatted — a missing
# ext4 magic there means damage, and damage gets a repair attempt, not mkfs (see step 3).
P3MARK=/etc/batman-storage.p3-created

lg(){ logger -t batman-storage "$*"; echo "batman-storage: $*"; }
# ext4 superblock magic (0xEF53 LE at byte 1080) — no dumpe2fs/blkid needed (not in the image)
has_fs(){ [ "$(hexdump -s 1080 -n 2 -e '2/1 "%02x"' "$1" 2>/dev/null)" = "53ef" ]; }
# has_fs matches the ext4 superblock magic ONLY, so a squashfs rootfs reads back as "empty".
# Every guard built on it is therefore blind to a rootfs slot — hence is_squashfs below.
is_squashfs(){ [ "$(hexdump -n 4 -e '4/1 "%02x"' "$1" 2>/dev/null)" = "68737173" ]; }   # 'hsqs'

# --- identify the data partition POSITIVELY (#209 review) --------------------------------------
# build-gpt-ab-card.sh stamps GPT names (bootA/rootA/bootB/rootB/config/data) and unique GUIDs
# 3276af79-0000-4000-8000-00000000000N, so "the partition NAMED data" is an answer. The old
# `[ -b p6 ] && 6 || 3` was a GUESS, and it mis-identifies any layout whose data area is not p6:
# on the five-partition Pi 3 A/B profile (boot / rootA / rootB / config / data —
# docs/storage-architecture.md) it lands on p3 = ROOTFS B, and step 2/3 below then luksFormat or
# mkfs.ext4 straight over a rootfs. has_fs() cannot catch that (see above). Refusing beats
# guessing: a node with no data partition is recoverable, a node with a wiped slot is not.
GUID_ROOTA=3276af79-0000-4000-8000-000000000002
GUID_ROOTB=3276af79-0000-4000-8000-000000000004
partcount(){ set -- /sys/class/block/"$DISKN"p*; [ -e "$1" ] || { echo 0; return; }; echo "$#"; }
gpt_field(){ # $1 = partition number, $2 = sgdisk field label
	command -v sgdisk >/dev/null 2>&1 || return 1
	sgdisk -i "$1" "$DISK" 2>/dev/null | sed -n "s/^$2: //p" | sed "s/^'//;s/'$//"
}
find_named_data(){
	command -v sgdisk >/dev/null 2>&1 || return 1
	for d in /sys/class/block/"$DISKN"p*; do
		[ -e "$d" ] || continue
		pn=${d##*p}
		[ "$(gpt_field "$pn" 'Partition name')" = "data" ] && { echo "$pn"; return 0; }
	done
	return 1
}
if PART_NUM=$(find_named_data); then
	:                                                   # GPT says which one it is
elif [ -b "${DISK}p6" ]; then
	PART_NUM=6                                          # v2 six-partition A/B card (no sgdisk on node)
elif [ "$(partcount)" -le 2 ]; then
	PART_NUM=3                                          # interim/MBR card: carve data out of free space
elif [ "$(partcount)" = 3 ] && { has_fs "${DISK}p3" || cryptsetup isLuks "${DISK}p3" 2>/dev/null; }; then
	PART_NUM=3                                          # interim card, already provisioned (re-run)
else
	PART_NUM=""
fi
PART=${DISK}p${PART_NUM}

[ -n "$PART_NUM" ] || { lg "cannot identify the data partition on a $(partcount)-partition layout (no GPT partition named 'data', no p6) — REFUSING rather than guessing (#209)"; exit 0; }

# Test seam (tests/ab-card-invariants.sh): print which partition was identified and stop, before
# anything is written. Deliberately placed AFTER the refusal above so a refusal prints nothing.
[ -z "${BATMAN_STORAGE_PROBE:-}" ] || { echo "$PART"; exit 0; }

# Last line of defence, independent of the identification above: never write a filesystem over
# something that is demonstrably a system area. Called before the two destructive steps.
assert_not_system(){
	is_squashfs "$PART" && { lg "REFUSING: $PART carries a squashfs — that is a rootfs slot, not data"; exit 0; }
	n=$(gpt_field "$PART_NUM" 'Partition name') || n=""
	case "$n" in ""|data) : ;; *) lg "REFUSING: $PART is GPT-named '$n', not 'data'"; exit 0 ;; esac
	# sgdisk prints GUIDs in UPPER case; the constants are lower case (the guard never fired before)
	g=$(gpt_field "$PART_NUM" 'Partition unique GUID' | tr 'A-F' 'a-f') || g=""
	case "$g" in
		"$GUID_ROOTA"|"$GUID_ROOTB") lg "REFUSING: $PART carries the rootfs GUID $g"; exit 0 ;;
	esac
}

# already provisioned + mounted? (a re-run after success, or the init already did it) -> done
if mount | grep -q " $MOUNT "; then lg "already mounted — nothing to do"; exit 0; fi

# tool guards live where the tool is used: parted only to CREATE p3 (below), mkfs.ext4 only to
# format an empty partition. A pre-made p6 (v2 card) needs neither to just be mounted (N-R5).

# LUKS capability
LUKS=0
# BATMAN_STORAGE_NO_LUKS: test seam only (tests/storage-p6-safety.sh runs this on a host that has
# cryptsetup); a node never sets it.
if [ -z "${BATMAN_STORAGE_NO_LUKS:-}" ] && command -v cryptsetup >/dev/null 2>&1; then modprobe dm-crypt 2>/dev/null; [ -e /dev/mapper/control ] && LUKS=1; fi
if [ "$LUKS" = 1 ]; then
	DEV="/dev/mapper/$MAPPER"
else
	DEV="$PART"; lg "!!! dm-crypt unavailable — provisioning UNENCRYPTED (image needs CONFIG_DM_CRYPT, #47) !!!"
fi

# 1. create the data partition in the free space (idempotent, free space only)
if [ ! -b "$PART" ]; then
	command -v parted >/dev/null 2>&1 || { lg "parted missing — cannot create data partition, skip"; exit 0; }
	PARTCOUNT=$(parted -sm "$DISK" print 2>/dev/null | grep -cE '^[0-9]+:')
	[ "$PARTCOUNT" -eq 2 ] || { lg "expected p1+p2+free, found $PARTCOUNT partitions — refusing (safety)"; exit 0; }
	START=$(parted -sm "$DISK" unit s print free 2>/dev/null | awk -F: '/free;?$/{sz=$4; gsub("s","",sz); if(sz+0>best){best=sz+0; bs=$2}} END{gsub("s","",bs); print bs}')
	[ -n "$START" ] && [ "$START" -gt 0 ] 2>/dev/null || { lg "no free space — skip"; exit 0; }
	lg "creating $PART ${START}s..100% (expand-to-fill)"
	# marker BEFORE mkpart: the exit-1 retry below re-enters with the partition already present
	touch "$P3MARK"; sync
	parted -s "$DISK" mkpart primary ext4 "${START}s" 100% || { lg "mkpart failed"; rm -f "$P3MARK"; exit 0; }   # licence only for a partition that exists
	sync; sleep 1; [ -b "$PART" ] || partprobe "$DISK" 2>/dev/null || true; sleep 1
	# if the kernel still can't see it, ask OpenWrt to re-run us next boot (non-zero exit)
	[ -b "$PART" ] || { lg "$PART not visible yet — will retry next boot"; exit 1; }
fi

# --- Pi 3 card (#209 v4.3 D2) --------------------------------------------------------------------
# A Pi 3 A/B card carries a hybrid MBR (1=p7 batfw, 2=bootA, 3=bootB, 4=ee) that the Pi 3 boot ROM
# reads to find bootcode.bin. Step 1b's sgdisk rewrites sector 0; E0d showed the hybrid entries
# survive it, but a power cut inside that write could leave a Pi 3 unable to boot at all (a Pi 4
# reads the GPT from its EEPROM and is unaffected). So on a Pi 3 card the grow runs only on a card
# that was never provisioned (the factory first boot), sector 0 is backed up first, and the MBR is
# re-read uncached afterwards and restored if it is not exactly what the builder wrote.
raw_sector0(){ dd if="$DISK" bs=512 count=1 iflag=direct 2>/dev/null || dd if="$DISK" bs=512 count=1 2>/dev/null; }
mbr_entry(){ # $1 = sector-0 file, $2 = 1..4 -> "TYPE START FLAG"
	o=$((446 + 16 * ($2 - 1)))
	echo "$(hexdump -s $((o + 4)) -n1 -e '1/1 "%02x"' "$1") $(hexdump -s $((o + 8)) -n4 -e '1/4 "%u"' "$1") $(hexdump -s "$o" -n1 -e '1/1 "%02x"' "$1")"
}
part_start(){ cat "/sys/class/block/${DISKN}p$1/start" 2>/dev/null; }
pi3_mbr_ok(){ # $1 = sector-0 file
	[ "$(mbr_entry "$1" 1)" = "0c $(part_start 7) 80" ] \
	&& [ "$(mbr_entry "$1" 2 | cut -d' ' -f1,2)" = "0c $(part_start 1)" ] \
	&& [ "$(mbr_entry "$1" 3 | cut -d' ' -f1,2)" = "0c $(part_start 3)" ] \
	&& [ "$(mbr_entry "$1" 4 | cut -d' ' -f1)" = ee ]
}
IS_PI3=0
if [ -b "${DISK}p7" ]; then
	raw_sector0 > /tmp/95-mbr.$$
	[ "$(mbr_entry /tmp/95-mbr.$$ 1 | cut -d' ' -f2)" = "$(part_start 7)" ] && IS_PI3=1
	rm -f /tmp/95-mbr.$$
fi
# 0 only when p5 is a plain ext4 that mounts and has NO .seeded — i.e. provably never provisioned.
# LUKS / unmountable / unknown all answer "provisioned" so the grow is skipped (fail-safe: a small
# p6 is a degraded node, a torn MBR is a site visit).
p5_never_seeded(){
	p5=${DISK}p5; [ -b "$p5" ] && has_fs "$p5" || return 1
	m=/tmp/95-p5.$$; mkdir -p "$m"
	mount -t ext4 -o ro "$p5" "$m" 2>/dev/null || { rmdir "$m"; return 1; }
	[ -f "$m/.seeded" ]; s=$?
	umount "$m"; rmdir "$m"; [ "$s" -ne 0 ]
}

# 1b. grow a pre-made GPT last partition (v2 A/B p6) to fill the card (#201). Step 1 only expands
#     partitions IT creates; a baked-small p6 (200 MiB in the distributable .img) would otherwise
#     stay small forever, because A/B OTA never touches the partition table (one-way door). Table
#     grow only here; the ext4 grow is step 3b. Geometry from sysfs (kernel truth — no blockdev);
#     sgdisk only for the atomic table rewrite. Idempotent, grow-only, fail-open.
#     See docs/design/201-firstboot-grow.md.
if [ "$PART_NUM" = 6 ] && [ -b "$PART" ] && command -v sgdisk >/dev/null 2>&1; then
	dsz=$(cat /sys/block/"$DISKN"/size 2>/dev/null)
	pst=$(cat /sys/class/block/"$DISKN"p6/start 2>/dev/null)
	psz=$(cat /sys/class/block/"$DISKN"p6/size 2>/dev/null)
	if [ -n "$dsz" ] && [ -n "$pst" ] && [ -n "$psz" ]; then
		pend=$((pst + psz))
		# p6 must be PHYSICALLY last: nothing may occupy a sector at/after our start (GPT entries
		# can be out of order, so key off geometry not the number). Refuse otherwise (fail-open).
		last=1
		for d in /sys/class/block/"$DISKN"p*; do
			pn=${d##*"$DISKN"p}; [ "$pn" = 6 ] && continue
			s=$(cat "$d/start" 2>/dev/null); z=$(cat "$d/size" 2>/dev/null)
			[ -n "$s" ] && [ -n "$z" ] || continue
			[ $((s + z)) -le "$pst" ] || { last=0; lg "p$pn sits at/after p6 start — refusing grow"; break; }
		done
		# gate on the PHYSICAL device size (sysfs), NOT GPT last-usable — the latter is stale on a
		# dd'd card until sgdisk -e runs, which would wrongly report "already full" (=#201 unfixed).
		# 32768 sectors = 16 MiB slack so an already-full card / slot flip is a clean no-op.
		grow_ok=1
		if [ "$last" = 1 ] && [ $((dsz - pend)) -gt 32768 ] && [ "$IS_PI3" = 1 ] && ! p5_never_seeded; then
			grow_ok=0
			lg "Pi 3 card that is already provisioned (or p5 unreadable): NOT rewriting the boot-critical MBR — p6 stays at $psz sectors (#209 D2; grow it at the factory first boot)"
		fi
		if [ "$last" = 1 ] && [ $((dsz - pend)) -gt 32768 ] && [ "$grow_ok" = 1 ]; then
			guid=$(sgdisk -i 6 "$DISK" 2>/dev/null | sed -n 's/^Partition unique GUID: //p')
			[ "$IS_PI3" = 1 ] && { raw_sector0 > /tmp/95-mbr.bak; lg "Pi 3 card: sector 0 backed up before the table rewrite"; }
			if [ -n "$guid" ]; then
				lg "growing p6 to fill card: start=$pst old_end=$pend dev_end=$dsz (sectors)"
				# ONE atomic sgdisk write: -e relocates the backup header to the true disk end,
				# -a 1 pins alignment to 1 sector so the start CANNOT shift (a shifted start would
				# strand the ext4), then delete+recreate p6 at the SAME start to disk end with the
				# same GUID/type/name. Never a bare -d then -n (a crash between them orphans p6 with
				# no rebuild path — the create branch above refuses when p1..p5 already exist).
				if sgdisk -a 1 -e -d 6 -n "6:${pst}:0" -t 6:8300 -u "6:$guid" -c 6:data "$DISK" >/dev/null 2>&1; then
					# test only (tests/ab-card-invariants.sh): break MBR entry 1 as a torn write would
					[ "${BATMAN_FAULT_INJECT:-}" = mbr-after-grow ] && dd if=/dev/zero of="$DISK" bs=1 seek=446 count=16 conv=notrunc,fsync 2>/dev/null
					if [ "$IS_PI3" = 1 ]; then
						raw_sector0 > /tmp/95-mbr.now
						if pi3_mbr_ok /tmp/95-mbr.now; then
							lg "Pi 3 card: hybrid MBR intact after the table rewrite"
						else
							lg "!!! Pi 3 card: hybrid MBR WRONG after the table rewrite — restoring sector 0 from the backup"
							dd if=/tmp/95-mbr.bak of="$DISK" bs=512 count=1 conv=notrunc,fsync 2>/dev/null; sync
							raw_sector0 > /tmp/95-mbr.now
							if pi3_mbr_ok /tmp/95-mbr.now; then lg "Pi 3 card: sector 0 restored and verified"
							else lg "!!! Pi 3 card: sector 0 restore did NOT verify — this card may not boot; CHECK IT before deployment"; fi
						fi
						rm -f /tmp/95-mbr.now
					fi
					partx -u "$DISK" 2>/dev/null; partprobe "$DISK" 2>/dev/null; sync; sleep 1
					nsz=$(cat /sys/class/block/"$DISKN"p6/size 2>/dev/null)
					if [ -n "$nsz" ] && [ "$nsz" -gt "$psz" ]; then
						lg "p6 partition grown ($psz -> $nsz sectors); ext4 grown in step 3b"
					else
						# one-shot uci-default: a plain continue deletes this hook, so the fs grow
						# would never run. exit 1 to re-run next boot (1b then no-ops as already-full
						# and 3b completes the fs grow against the now-visible partition).
						lg "kernel did not re-read grown p6 — exit 1 to retry next boot"; exit 1
					fi
				else
					lg "sgdisk grow failed — continuing on small p6 (fail-open)"
				fi
			else
				lg "cannot read p6 GUID — skip grow (fail-open)"
			fi
		fi
	fi
fi

rm -f /tmp/95-mbr.bak
# Test seam (tests/ab-card-invariants.sh): stop after the table grow, before anything is formatted.
[ -z "${BATMAN_STORAGE_STOP_AFTER_GROW:-}" ] || { echo "p6=$(cat /sys/class/block/"$DISKN"p6/size 2>/dev/null)"; exit 0; }

# Everything below this line WRITES. Assert the target is not a system area first (#209 review:
# a five-partition layout used to send step 2/3 onto rootfs B).
assert_not_system

crit(){ lg "!!! $*"; echo "<2>batman-storage: $*" > /dev/kmsg 2>/dev/null; echo "$*" > /tmp/batman-storage.crit 2>/dev/null; }
may_format(){ [ -f "$P3MARK" ]; }

# 2. LUKS (if capable, idempotent)
# NB (#111, not fixed here): the key lives on the overlay, so an OTA (fresh overlay) generates a NEW
# key and cannot open an existing LUKS p6. Latent until the image carries dm-crypt.
JUST_LUKSFORMATTED=0
if [ "$LUKS" = 1 ]; then
	[ -f "$KEYFILE" ] || { head -c 512 /dev/urandom > "$KEYFILE"; chmod 600 "$KEYFILE"; }
	if ! cryptsetup isLuks "$PART" 2>/dev/null; then
		if has_fs "$PART"; then
			# a dm-crypt-capable image meeting a plain-ext4 data partition: never luksFormat over it
			# (N-R4), and do NOT stop here either — stopping skipped step 4, so the trial slot booted
			# with p6 unmounted and autocommit reverted every OTA. Carry on unencrypted.
			lg "$PART already carries a plain ext4 — NOT encrypting it; continuing unencrypted"
			LUKS=0; DEV=$PART
		elif may_format; then
			cryptsetup luksFormat --type luks2 --batch-mode --key-file "$KEYFILE" "$PART" && JUST_LUKSFORMATTED=1
		else
			crit "$PART is neither LUKS nor ext4 and was not created by this script — not formatting it (pre-made data partition: damaged, or written by something else)"
			LUKS=0; DEV=$PART
		fi
	fi
	[ "$LUKS" = 1 ] && { cryptsetup status "$MAPPER" >/dev/null 2>&1 || cryptsetup open --key-file "$KEYFILE" "$PART" "$MAPPER"; }
fi

# 3. ext4. A pre-made data partition is NEVER formatted (#209 S5 review W1): this hook re-runs on the
#    first boot of every OTA slot, before p6 is mounted, so "no ext4 magic" there means a damaged
#    superblock (power cut) or a transient read error — and mkfs would wipe the data before the
#    autocommit gate could revert anything. Only a partition this script created (P3MARK), or the
#    mapper of a LUKS volume it formatted just now, may be formatted.
recover_ext4(){ # $1 = device without a readable ext4 magic; 0 = a filesystem is there now
	d=$1
	# a transient read must not be "repaired": re-read uncached a few times first
	n=0
	while [ $n -lt 3 ]; do
		sync; echo 3 > /proc/sys/vm/drop_caches 2>/dev/null
		has_fs "$d" && { lg "$d: ext4 magic present on re-read — transient read, nothing repaired"; return 0; }
		sleep 1; n=$((n + 1))
	done
	# card I/O errors this boot: e2fsck -y over unreliable reads would destroy what is left
	if dmesg 2>/dev/null | grep -qE "I/O error,? dev ${DISKN}|Buffer I/O error on dev ${DISKN}"; then
		crit "$d: no ext4 magic AND the card reported I/O errors this boot — not running fsck, not formatting; replace/inspect the card"
		return 1
	fi
	if [ "$(hexdump -n 6 -e '6/1 "%02x"' "$d" 2>/dev/null)" = 4c554b53babe ]; then
		crit "$d carries a LUKS header but this image has no dm-crypt — leaving it untouched (an image without encryption must not be OTA'd onto an encrypted node)"
		return 1
	fi
	command -v e2fsck >/dev/null 2>&1 || { crit "$d: no ext4 magic and no e2fsck to repair it — not formatting"; return 1; }
	lg "$d: no ext4 magic — trying e2fsck (it locates a backup superblock itself)"
	e2fsck -fy "$d" >/dev/null 2>&1
	has_fs "$d" && { lg "$d: ext4 recovered by e2fsck"; return 0; }
	for bb in 32768:4096 16384:2048 8193:1024; do
		e2fsck -fy -b "${bb%%:*}" -B "${bb##*:}" "$d" >/dev/null 2>&1
		has_fs "$d" && { lg "$d: ext4 recovered from backup superblock ${bb%%:*} (block ${bb##*:})"; return 0; }
	done
	crit "$d: ext4 unrecoverable (primary and backup superblocks) — NOT formatting; the data stays on the card for manual recovery"
	return 1
}
if has_fs "$DEV"; then
	lg "$DEV already has a filesystem — keeping it"
elif may_format || [ "$JUST_LUKSFORMATTED" = 1 ]; then
	if command -v mkfs.ext4 >/dev/null 2>&1; then
		lg "mkfs.ext4 $DEV (created by this script)"; mkfs.ext4 -F -b 4096 -L "$LABEL" -m 0 "$DEV" >/dev/null 2>&1
		# the licence is single-use: a later damaged superblock on this partition gets a repair, not mkfs
		has_fs "$DEV" && { rm -f "$P3MARK"; sync; }
	else
		lg "mkfs.ext4 missing and $DEV unformatted — skip"; exit 0
	fi
else
	recover_ext4 "$DEV" || lg "continuing without a usable data filesystem (the mount will fail and be reported)"
fi

# 3b. grow the ext4 to fill the (possibly enlarged by 1b) partition (#201). This is a one-shot
#     uci-default so it runs once per slot first-boot, not every boot — resize2fs is a no-op when
#     the fs already fills the device, so an already-full card / a fresh mkfs above just no-ops.
#     Unmounted here (boot()/mount is step 5). LUKS: grow the mapper first. e2fsck exit 0/1 = OK
#     (1 = errors fixed), >=4 = real failure -> skip resize, fail-open (small p6 degraded, not bricked).
if [ "$PART_NUM" = 6 ] && has_fs "$DEV" && command -v resize2fs >/dev/null 2>&1; then
	[ "$LUKS" = 1 ] && cryptsetup resize "$MAPPER" >/dev/null 2>&1 && lg "luks mapper resized to partition"
	e2fsck -pf "$DEV" >/dev/null 2>&1; rc=$?
	if [ "$rc" -le 1 ]; then
		if resize2fs "$DEV" >/dev/null 2>&1; then lg "ext4 resized to fill $DEV"; else lg "resize2fs failed (fail-open)"; fi
	else
		lg "e2fsck rc=$rc on $DEV — skip resize (degraded, fail-open)"
	fi
fi
# Test seam (tests/storage-p6-safety.sh): report the filesystem outcome and stop before step 4
# installs the init / mounts anything on the host.
[ -z "${BATMAN_STORAGE_STOP_AFTER_FS:-}" ] || { has_fs "$DEV" && echo "fs=ext4" || echo "fs=none"; exit 0; }

# 4. install the persistent data-partition service (runs on every boot + clean shutdown).
#    Node-specific values are baked into the header; the body is verbatim (quoted heredoc).
#    Upgrade path: an older init (START=78) must be disabled first or its rc.d links linger.
[ -x "$INIT" ] && "$INIT" disable 2>/dev/null
{
	printf '#!/bin/sh /etc/rc.common\n'
	printf '# batdata-mount — data partition (p5) service, generated by 95-batman-storage (#88/#61).\n'
	printf '# LUKS mode uses a PLACEHOLDER key on rootfs — replace with SE-sealed release (#47/B3).\n'
	printf 'PART=%s\nDEV=%s\nLUKS=%s\nMAPPER=%s\nKEYFILE=%s\nMOUNT=%s\n' "$PART" "$DEV" "$LUKS" "$MAPPER" "$KEYFILE" "$MOUNT"
	cat <<'INITBODY'
START=11   # before logd (S12): anything that wants the data area finds it mounted
STOP=10    # clean shutdown/reboot: capture the log ring + trigger before unmounting
CRASH=$MOUNT/crash   # kernel-panic records moved off pstore (#61)
LOG=$MOUNT/log       # boot-reasons.log + shutdown dumps; continuous logs are #65's job
KEEP_SHUTDOWN_LOGS=10

ts(){ date +%Y%m%d-%H%M%S; }                              # no RTC: may be pre-NTP, boot_id keeps names unique
bid(){ cut -c1-8 /proc/sys/kernel/random/boot_id; }
# S11 runs before logd (S12): a plain `logger` here is lost. Also write the kernel ring, which
# logd picks up when it starts -> visible in both dmesg and logread.
note(){ logger -t batdata-mount "$*" 2>/dev/null; echo "batdata-mount: $*" > /dev/kmsg 2>/dev/null; }

# OTA flight recorder (#209 S5, docs/design/ota-trace.md). A missing lib degrades to no trace.
# shellcheck source=/dev/null
[ -f /usr/lib/batman/otatrace.sh ] && . /usr/lib/batman/otatrace.sh
type otalog >/dev/null 2>&1 || { otalog(){ :; }; otalog_k(){ :; }; ota_get(){ :; }; ota_thr(){ :; }; }
dt_hex(){ hexdump -v -e '1/1 "%02x"' "/proc/device-tree/chosen/bootloader/$1" 2>/dev/null; }
# One line of firmware facts per boot — the raw material for "did the tryboot happen, and if not,
# why": what the firmware reports (DT), what autoboot.txt asked for, the flag right now, the supply,
# the firmware's own log of which partition it booted, and on a Pi 3 the p7 boot code it ran.
boot_facts(){
	ab=""; p7=""; extra=""
	if [ -b /dev/mmcblk0p7 ]; then
		bm=/tmp/bm-p7; mkdir -p "$bm"
		if mount -t vfat -o ro /dev/mmcblk0p7 "$bm" 2>/dev/null; then
			ab=$(tr '\n' ' ' < "$bm/autoboot.txt" 2>/dev/null)
			p7="p7_bootcode=$(sha256sum "$bm/bootcode.bin" 2>/dev/null | cut -c1-12) p7_autoboot=$(sha256sum "$bm/autoboot.txt" 2>/dev/null | cut -c1-12)"
			umount "$bm"
		fi
		rmdir "$bm" 2>/dev/null
	else
		ab=$(tr '\n' ' ' < /boot/autoboot.txt 2>/dev/null)
		extra="eeprom=$(vcgencmd bootloader_version 2>/dev/null | sed -n 's/^timestamp //p') $(vcgencmd bootloader_config 2>/dev/null | grep -E '^(BOOT_ORDER|PARTITION_WALK)=' | tr '\n' ' ')"
	fi
	echo "slot=$(sed -n 's/.*batman_slot=\([AB]\).*/\1/p' /proc/cmdline) ver=$(sed -n 's/^BATMAN_VERSION=//p' /etc/batman-build 2>/dev/null) dt_tryboot=$(dt_hex tryboot) dt_partition=$(dt_hex partition) dt_rsts=$(dt_hex rsts) dt_bootmode=$(dt_hex boot-mode) get_now=$(ota_get) thr=$(ota_thr) autoboot=\"$ab\" fw=\"$(vclog -m 2>/dev/null | grep -m1 'boot-part')\" devkmsg=$(cat /proc/sys/kernel/printk_devkmsg 2>/dev/null) $p7 $extra"
}

# payload guardian restore (#192, extended for #167): an A/B flash clears the overlay, so a payload
# guardian init that lives on the persistent data area (deploy/<payload>/<name>.init or the generic
# apps/<tenant>/<name>.init — NOT baked into the generic image) is gone from /etc/init.d. Reinstate it
# EVERY boot, idempotently, after p6 is mounted, so OTS + its #156 reconcile guardian (and any generic
# payload tenant) return with no manual step. Done here (not a one-shot uci-default) so a boot where the
# mount was not ready self-heals next boot instead of the hook deleting itself into a silent no-guardian
# state (review #192). Guard: only root-owned inits are boot-exec'd (physical-capture is in the threat
# model; this runs before the network is fully up). See docs/design/192-payload-guardian-restore.md.
# payload config golden refresh (docs/design/payload-config-golden.md): the tenant's declarative config
# on p6 was, historically, a hand-installed artifact with no image/version-controlled source, so it drifts
# (observed: p6 ots.manifest stuck at RESTART on-failure:5 while the image says unless-stopped). The image
# now bakes the canonical config at /usr/share/batman/payload-golden/<tenant>/ (batman-payload-host, bcm2711
# only). Refresh p6 FROM that golden every boot, idempotently, BEFORE restore_payload_guardians (which
# reinstalls the possibly-refreshed .init). REFRESH-EXISTING-ONLY: gate on an existing *.manifest so a bare
# node / manet02 (no tenant) and an empty/half dir are left untouched (review B2). No secrets, no images.
refresh_payload_config(){
	[ -d /usr/share/batman/payload-golden ] || return 0    # non-payloadhost image: nothing baked
	for golden in /usr/share/batman/payload-golden/*/ ; do
		[ -d "$golden" ] || continue                   # busybox ash: a no-match glob stays literal
		tenant=${golden%/}; tenant=${tenant##*/}
		dst="$MOUNT/apps/$tenant"
		ls "$dst"/*.manifest >/dev/null 2>&1 || continue   # refresh only an already-provisioned tenant
		for f in "$golden"* ; do
			[ -f "$f" ] || continue
			b=${f##*/}
			[ "$b" = secrets ] && continue         # never touch p6 secrets/
			cmp -s "$f" "$dst/$b" 2>/dev/null && continue   # idempotent: write only on change (#41)
			# cp -p keeps the golden's mode (+x on .sh/.init/.fw4.uci, installed 0755); &&/|| so a failed
			# cp is removed, never promoted to a truncated live file (review M1 + R2 atomicity).
			tmp="$dst/.$b.tmp.$$"
			if cp -p "$f" "$tmp" && mv -f "$tmp" "$dst/$b"; then
				note "payload config refreshed from golden: $tenant/$b"
			else
				rm -f "$tmp" 2>/dev/null; note "payload config refresh FAILED: $tenant/$b (kept old)"
			fi
		done
	done
}

restore_payload_guardians(){
	[ -d "$MOUNT/deploy" ] || [ -d "$MOUNT/apps" ] || return 0
	for src in "$MOUNT"/deploy/*/*.init "$MOUNT"/apps/*/*.init; do
		[ -f "$src" ] || continue
		[ -O "$src" ] || { note "payload restore: $src not root-owned — skipped"; continue; }
		name=${src##*/}; name=${name%.init}; dst="/etc/init.d/$name"
		if ! cmp -s "$src" "$dst" 2>/dev/null; then
			cp "$src" "$dst" 2>/dev/null || { note "payload restore: cp $name FAILED"; continue; }
			chmod +x "$dst"; note "payload guardian $name (re)installed from p6"
		fi
		"$dst" enable 2>/dev/null
		# S11 runs before the S99 start pass, but the first-boot hook calls boot() during uci-defaults
		# AFTER that pass — so start explicitly when not already up (idempotent on a normal boot).
		"$dst" running 2>/dev/null || "$dst" start 2>/dev/null
	done
}

# best-effort "who triggered this shutdown" for the marker
reboot_trigger(){
	# a daemon asked for this shutdown and said why (batpower low-battery #122, joinwatch #127)
	if [ -f /tmp/shutdown.reason ]; then read -r m < /tmp/shutdown.reason; echo "$m"; return; fi
	if [ -e /tmp/sysupgrade.tgz ] || { command -v pgrep >/dev/null 2>&1 && pgrep -f sysupgrade >/dev/null 2>&1; }; then
		echo "sysupgrade"; return
	fi
	# openmanetd's two-stage addressing reboots once after reserving the mesh IP (by design)
	if logread 2>/dev/null | tail -50 | grep -q "Rebooting system to apply new network settings"; then
		echo "openmanetd address reservation (expected once after provisioning)"; return
	fi
	who=$(logread 2>/dev/null | grep "dropbear.*Auth succeeded" | tail -1 | sed -n 's/.*from \([0-9a-fA-F.:]*\):.*/\1/p')
	[ -n "$who" ] && echo "reboot/halt command (last ssh login from $who)" || echo "reboot/halt command (no ssh login in log)"
}

boot(){
	[ -b "$PART" ] || return 0
	[ "$LUKS" = 1 ] && { cryptsetup status "$MAPPER" >/dev/null 2>&1 || cryptsetup open --key-file "$KEYFILE" "$PART" "$MAPPER" 2>/dev/null; }
	mkdir -p "$MOUNT"
	# p6 (data) mount: a single try, with the real error captured to kmsg (logd is not up at S11)
	# on failure. An earlier retry loop here was based on a wrong "mount transient" diagnosis; the
	# real Build #2 slot-B failure was a corrupt f2fs overlay degrading the whole boot (see
	# 96-batman-config-migrate) — a card-prep gap a retry cannot fix. A healthy slot mounts p6 first try.
	if ! mount | grep -q " $MOUNT "; then
		merr=$(mount "$DEV" "$MOUNT" 2>&1) || { note "mount $DEV on $MOUNT FAILED: $merr"; return 0; }
	fi
	# the real data device (the LUKS mapper when encrypted) for the sysupgrade stage-2 recorder,
	# which re-mounts it to keep its trace (/tmp crosses into the stage-2 ramfs)
	echo "$DEV" > /tmp/batdata.dev
	mkdir -p "$CRASH" "$LOG"
	note "mounted $DEV on $MOUNT"
	# #215: online-grow the ext4 to fill the partition (offline step 3b can no-op on first boot
	# before the kernel re-reads the grown table; after mount the kernel sees the partition).
	# #216 M5: grow the LUKS mapper first (symmetry with the offline step-3b) when encrypted.
	# #216: log the resize2fs failure reason instead of swallowing it — an online resize refuses on a
	# fs needing `e2fsck -f` (e.g. after an unclean shutdown) and would otherwise silently leave p6
	# small (a soft recurrence of the #215 bug); grow-only + idempotent, self-heals once fsck'd.
	if command -v resize2fs >/dev/null 2>&1; then
		[ "$LUKS" = 1 ] && command -v cryptsetup >/dev/null 2>&1 && { cryptsetup resize "$MAPPER" >/dev/null 2>&1 && note "p6 luks mapper online-resized"; }
		rerr=$(resize2fs "$DEV" 2>&1) && note "p6 ext4 online-resized to fill partition" || note "p6 ext4 online-resize skipped/failed: $rerr"
	fi
	# once per boot: the first-boot hook calls `boot` itself and the S11 link may run it again
	[ -f /tmp/batdata-mount.booted ] && return 0
	: > /tmp/batdata-mount.booted

	refresh_payload_config      # payload-config-golden: refresh p6 tenant config from the baked image
	restore_payload_guardians   # #192: bring the payload guardian(s) back after an A/B flash

	# crash capture (#61): move pstore records off the volatile ramoops region so the next event
	# has a clean region and the record can't be lost. With console capture on (#105) a
	# console-ramoops record exists after EVERY warm reboot; it is only worth keeping when the
	# boot was not clean, so on a clean boot it is discarded without touching the SD.
	clean=0; [ -f "$LOG/shutdown.marker" ] && clean=1
	n=0; ncon=0; confile=""
	for f in /sys/fs/pstore/*; do
		[ -f "$f" ] || continue
		b=${f##*/}
		case "$b" in
			console-*)
				if [ "$clean" = 1 ]; then rm -f "$f"; continue; fi
				confile="$CRASH/$(ts)_$(bid)_$b"
				cp "$f" "$confile" && rm -f "$f" && ncon=$((ncon+1));;
			*)	cp "$f" "$CRASH/$(ts)_$(bid)_$b" && rm -f "$f" && n=$((n+1));;
		esac
	done
	# keep the last 5 console records (they only accumulate on unclean boots; names sort by time)
	k=0; for f in "$CRASH"/*_console-ramoops-*; do [ -f "$f" ] && k=$((k+1)); done
	for f in "$CRASH"/*_console-ramoops-*; do [ "$k" -gt 5 ] || break; [ -f "$f" ] && rm -f "$f" && k=$((k-1)); done

	# boot reason: why did the previous life end? (every reboot must say who/what triggered it)
	#   dmesg-ramoops        -> the kernel panicked
	#   shutdown marker      -> clean (stop() ran: reboot/halt/sysupgrade/low-battery/openmanetd)
	#   console record only  -> no shutdown ran: a hang cut by the hardware watchdog, reboot -f,
	#                           sysrq or a reflash. The record tail is the evidence; hints are
	#                           appended when it contains something recognisable (a procd reboot
	#                           did not always leave "reboot: Restarting system" in the zone on
	#                           the bench, so the absence of a hint must not be read as "hang").
	#   nothing              -> power loss (or a hang, when console capture is not active)
	if [ "$n" -gt 0 ]; then
		reason="PANIC ($n pstore record(s) saved under $CRASH)"
	elif [ "$clean" = 1 ]; then
		reason="CLEAN: $(cat "$LOG/shutdown.marker")"
	elif [ "$ncon" -gt 0 ]; then
		hint=""
		grep -q "sysrq: " "$confile" 2>/dev/null && hint="$hint sysrq"
		grep -qE "reboot: (Restarting system|Power down)" "$confile" 2>/dev/null && hint="$hint kernel-reboot"
		grep -q "watchdog did not stop" "$confile" 2>/dev/null && hint="$hint watchdog-dev-closed"
		grep -qE "Out of memory|oom-kill" "$confile" 2>/dev/null && hint="$hint oom"
		reason="UNCLEAN — no shutdown ran (hang→hardware watchdog, reboot -f, sysrq or reflash); last console log saved under $CRASH${hint:+; hints:$hint}"
	elif [ "$(cat /sys/module/ramoops/parameters/console_size 2>/dev/null || echo 0)" -gt 0 ]; then
		reason="UNCLEAN (power loss: no shutdown marker, no panic, no console record)"
	else
		reason="UNCLEAN (power loss or hardware watchdog: no shutdown marker, no panic; console capture not active)"
	fi
	bs=$(cat /sys/class/watchdog/watchdog0/bootstatus 2>/dev/null)
	[ -n "$bs" ] && [ "$bs" != 0 ] && reason="$reason [watchdog bootstatus=$bs]"
	# Stage-2 evidence of the previous life (#209 S5): the stock sysupgrade ends in `reboot -f`, which
	# looks exactly like a hang above. Graded by evidence, never inferred: the last S2 line the previous
	# boot wrote — to p6 (stage 2 re-mounts it) or, where ramoops survives, its kmsg copy. Read BEFORE
	# this boot's boot-reasons line is appended (its last line is still the previous life's boot_id).
	# PANIC keeps precedence; the original text and hints are kept, not replaced.
	pb=$(tail -n 1 "$LOG/boot-reasons.log" 2>/dev/null | sed -n 's/.* boot_id=\([^ ]*\) .*/\1/p')
	s2=""
	[ -n "$pb" ] && s2=$(grep " boot=$pb .* S2 " "$LOG/ota-trace.log" 2>/dev/null | tail -n 1)
	[ -z "$s2" ] && [ -n "$confile" ] && s2=$(grep -a "batman-ota: .* S2 " "$confile" 2>/dev/null | tail -n 1)
	if [ -n "$s2" ]; then
		case "$s2" in
			*" S2 END "*) tag="SYSUPGRADE-REBOOT (${s2#* S2 END })" ;;
			*) tag="DIED-IN-STAGE2 (last: ${s2#* up=})" ;;
		esac
		if [ "$n" -gt 0 ]; then reason="$reason [after stage 2: $tag]"; else reason="$tag — $reason"; fi
	fi
	prevslot=""; [ -n "$confile" ] && prevslot=$(grep -ao 'batman_slot=[AB]' "$confile" 2>/dev/null | tail -n 1)
	rm -f "$LOG/shutdown.marker"
	echo "$(ts) boot_id=$(bid) prev=$reason" >> "$LOG/boot-reasons.log"
	note "previous shutdown: $reason"
	# shellcheck disable=SC2046
	otalog_k BOOT $(boot_facts) prevslot="${prevslot#batman_slot=}" prev="$(echo "$reason" | cut -c1-100)"
	tf="$LOG/ota-trace.log"
	if [ "$(wc -c < "$tf" 2>/dev/null || echo 0)" -gt 262144 ]; then tail -n 1500 "$tf" > "$tf.tmp" && mv "$tf.tmp" "$tf"; fi
	sync
}
start(){ boot; }
stop(){
	# clean shutdown/reboot: keep the syslog ring + what triggered it. Only SD write in steady state.
	if mount | grep -q " $MOUNT "; then
		mkdir -p "$LOG"
		t=$(ts)
		logread > "$LOG/shutdown_${t}_$(bid).log" 2>/dev/null
		echo "$t uptime=$(cut -d' ' -f1 /proc/uptime)s trigger=$(reboot_trigger)" > "$LOG/shutdown.marker"
		# retention: names sort chronologically (timestamp prefix), so drop the oldest beyond KEEP
		n=0; for f in "$LOG"/shutdown_*.log; do [ -f "$f" ] && n=$((n+1)); done
		for f in "$LOG"/shutdown_*.log; do
			[ "$n" -gt "$KEEP_SHUTDOWN_LOGS" ] || break
			[ -f "$f" ] && rm -f "$f" && n=$((n-1))
		done
		sync
		umount "$MOUNT" 2>/dev/null
	fi
	[ "$LUKS" = 1 ] && cryptsetup status "$MAPPER" >/dev/null 2>&1 && cryptsetup close "$MAPPER" 2>/dev/null
	true
}
INITBODY
} > "$INIT"
chmod +x "$INIT"; "$INIT" enable 2>/dev/null

# 5. bring it up now for this first boot (the S11 link was created after rcS enumerated it)
"$INIT" boot
lg "provisioned ($([ "$LUKS" = 1 ] && echo LUKS || echo plain)); data at $MOUNT (crash/, log/)"
exit 0
