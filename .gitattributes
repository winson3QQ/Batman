# Normalize line endings to LF — these ship to Linux/OpenWrt nodes.
# Prevents the CRLF-in-shebang bug (a Windows checkout gave deep-sample.sh
# CRLF -> `sh: not found`).
* text=auto eol=lf
*.sh    text eol=lf
*.py    text eol=lf
*.init  text eol=lf
*.conf  text eol=lf
*.nft   text eol=lf
*.md    text eol=lf

# Binary — never touch
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.gz binary
*.zip binary
*.bin binary
*.img binary
