<?xml version="1.0" encoding="utf-8"?>
<!-- design 254-app-s1 §4 (backup): nothing of this app leaves the phone — cloud backup and device-to-device transfer
     both exclude every domain (the sealed records are useless without this phone's Keystore keys, and a restored older
     record must never come back). allowBackup="false" alone does not stop device-to-device transfer on Android 12+.
     check<Variant>ManifestGate (build.gradle.kts) fails the build on any <include> or a missing domain. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
        <exclude domain="device_root" path="." />
        <exclude domain="device_file" path="." />
        <exclude domain="device_database" path="." />
        <exclude domain="device_sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
        <exclude domain="device_root" path="." />
        <exclude domain="device_file" path="." />
        <exclude domain="device_database" path="." />
        <exclude domain="device_sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
