+# ------------------------------------------------------------------ main power distribution
+# 5 V (Q3 = ideal-diode FET, U4 = its LM74700 controller). Q3 keeps the cloud orientation: source
+# pins 1-3 on its left (5V_BUCK), drain + tab on its right facing U4. Rotating Q3 90 deg (source
+# down, drain up) widened the 5V_BUCK neck to 1.7 mm but made Q3's gate / source / drain lines cross
+# on their way to U4 (left column VCAP/GND/5V_BUCK, right column 5V_BUCK/G_5VID/5V_PI): Freerouting
+# failed U4 on every run, so it was reverted.
+# 5V_BUCK: L1.2 -> Q3 source, a strip along Q3's left edge (the Pi 4 Wi-Fi keep-out starts at x 12,
+# the gate pin 4 sits bottom-left) -> ~1 mm neck, from 0.35 mm.
+# 5V_PI: Q3 drain / tab -> Pi header J2.2 / J2.4 through the gaps between the second-row pins; the
+# In2 5V_PI track stays in parallel; B.Cu is left for the header signals.
+POUR_5V_BUCK = [(12.05, 6.9), (13.7, 6.9), (13.7, 9.07), (13.05, 9.07), (13.05, 9.95), (16.6, 9.95), (16.6, 13.5),
+                (15.5, 13.5), (15.5, 12.4), (12.05, 12.4)]
+POUR_5V_PI = [(6.4, 0.6), (16.9, 0.6), (16.9, 9.75), (14.3, 9.75), (14.3, 6.7), (6.4, 6.7)]
+# 3.3 V HaLow: L2.2 -> C27 / C28 -> both sides of C27.2 (GND) -> R22 shunt
+POUR_3V3_BUCK = [(29.1, 49.2), (36.7, 49.2), (36.7, 53.45), (32.9, 53.45), (32.9, 55.1), (29.1, 55.1)]
+
+
+def power_5v_3v3(b):
+    # keep Q3's gate stub / via and the Q3 -> U4 sense lines that cross the pour corners
+    print("  ripped 5V_BUCK area", ops.rip_in_poly(b, POUR_5V_BUCK, "F", keep={"5V_BUCK", "G_5VID", "5V_PI"}),
+          "5V_PI area", ops.rip_in_poly(b, POUR_5V_PI, "F", keep={"5V_PI"}),
+          "3V3_BUCK area", ops.rip_in_poly(b, POUR_3V3_BUCK, "F"))
+    ops.zone(b, "5V_BUCK", "F", POUR_5V_BUCK)
+    ops.zone(b, "5V_PI", "F", POUR_5V_PI)
+    ops.zone(b, "3V3_BUCK", "F", POUR_3V3_BUCK)
+    ops.fill(b)
+
+
+STEPS = [spi1_sclk, j5_gnd, buck5, halow_reset, input_stage, power_5v_3v3]

