#!/bin/sh /etc/rc.common
#
# procd service for sigsurvey so it can be started/stopped reliably from the
# survey-web CGI (procd owns it, not uhttpd) and optionally auto-start on boot
# (`/etc/init.d/sigsurvey enable`). Survives crashes via respawn; the CSV is in
# /root and append-mode, so a reboot/brownout continues the same survey.
#
START=99
STOP=10
USE_PROCD=1

start_service() {
	procd_open_instance
	procd_set_param command /usr/bin/sigsurvey
	procd_set_param respawn 3600 5 0
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}
