#!/bin/sh
#
# sigsurvey - log GPS position + link quality for a coverage / heat-map survey.
#
# Pulls NMEA from an iPhone running GPS2IP Lite (Socket/server mode) over the
# local Wi-Fi, measures THIS node's RX signal from the peer + ping loss, and
# writes a CSV you can turn into a coloured coverage map (see scripts/survey2kml).
#
# GPS2IP Lite quirk: its socket server only starts streaming after the client
# sends a byte, so we send a newline first and hold the connection open.
# Position is taken from $GPRMC (ddmm.mmmm -> decimal degrees). The node clock
# is irrelevant here because each row carries its own lat/lon.
#
#   usage: sigsurvey [iphone_ip] [gps_port] [peer_ip]
#          defaults:  10.41.0.131  11123     10.41.1.1
#          Ctrl-C to stop.  Output: /tmp/survey.csv
#
IP=${1:-10.41.0.131}
PORT=${2:-11123}
PEER=${3:-10.41.1.1}
NMEA=/tmp/survey.nmea        # volatile buffer (fine to lose on reboot)
OUT=/root/survey.csv         # persistent: survives a reboot / battery brownout

echo "sigsurvey: GPS=$IP:$PORT  peer=$PEER  -> $OUT   (Ctrl-C to stop)"
: > "$NMEA"
# NMEA feed: GPS2IP only streams after the client sends a byte, and it drops the
# connection whenever the app is backgrounded. So reconnect in a tight loop -
# each cycle re-discovers the iPhone's current IP from the DHCP leases (in case
# it reconnected with a new address), sends the trigger newline, and holds the
# socket open ~8s (bounded, so a drop reconnects within 8s instead of hanging).
( while :; do
    ip=$(grep -i 'iphone' /etc/dhcp.leases /tmp/dhcp.leases 2>/dev/null | awk '{print $3}' | tail -1)
    [ -n "$ip" ] || ip="$IP"
    ( printf '\r\n'; sleep 8 ) | nc "$ip" "$PORT"
    sleep 1
  done ) >> "$NMEA" 2>/dev/null &
FEED=$!
trap 'kill $FEED 2>/dev/null; echo; echo "stopped. logged $(( $(wc -l < "$OUT") - 1 )) points -> $OUT"; exit 0' INT TERM

echo "ts,lat,lon,signal_dbm,noise_dbm,snr_db,loss_pct" > "$OUT"
while :; do
  pos=$(grep '\$GPRMC' "$NMEA" 2>/dev/null | tail -1 | awk -F, '$3=="A"{
    la=$4; ns=$5; lo=$6; ew=$7;
    d=int(la/100); lat=d+(la-d*100)/60; if(ns=="S")lat=-lat;
    d=int(lo/100); lon=d+(lo-d*100)/60; if(ew=="W")lon=-lon;
    printf "%.6f,%.6f", lat, lon }')
  sig=$(iw dev wlan0 station dump 2>/dev/null | awk '/signal avg:/{print $3; exit}')
  noise=$(morse_cli -i wlan0 stats 2>/dev/null | awk -F: '/^Noise \(dBm\)/{gsub(/ /,"",$2);print $2}')
  snr=""; [ -n "$sig" ] && [ -n "$noise" ] && snr=$((sig-noise))
  loss=$(ping -c 3 -W 1 "$PEER" 2>/dev/null | grep -oE '[0-9]+% packet loss' | grep -oE '[0-9]+' | head -1)
  ts=$(date +%s)
  if [ -n "$pos" ]; then
    echo "$ts,$pos,$sig,$noise,$snr,$loss" | tee -a "$OUT"
  else
    echo "(waiting for GPS fix... sig=${sig}dBm snr=${snr}dB)"
  fi
  sleep 2
done
