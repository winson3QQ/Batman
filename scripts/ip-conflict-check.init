#!/bin/sh /etc/rc.common

# Runs the duplicate-IP check once, late in boot (after network + mesh are up).
START=98
USE_PROCD=1

start_service() {
	procd_open_instance
	procd_set_param command /usr/bin/ip-conflict-check
	# one-shot: don't respawn
	procd_set_param respawn 0 0 0
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}
