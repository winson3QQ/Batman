From: Batman (#254 P2, docs/design/254-p2-impl.md §4.8 / D3)
Subject: [PATCH] Bluetooth: eir: bound the Flags / TX power ADs in eir_create_adv_data (6.6.138 backport)

The linux-stable 6.6.y backports of
  47c03902269aff377f959dc3fd94a9733aa31d6e "Bluetooth: eir: Fix possible crashes on eir_create_adv_data"
      (CVE-2025-38303; stable e98ce4b70beab73563d82bd21821024140e6da06)
  6f5fb689fdf80bdd143f22a502f9eb1f3c85e286 "Bluetooth: eir: Fix stack OOB write when prepending the Flags AD"
      (CVE-2026-64539; stable 9174992ee1045c9c96e53eecda64f49dd7e8fbba)
combined into one diff against 6.6.138 (the firmware's kernel). On an LE-only controller a 31-byte advertising
instance made the kernel prepend 3 bytes of Flags into the 31-byte legacy buffer (stack overrun; 04 panicked
2026-10-31, 254-p2-impl F-P10). Drop this file when the firmware moves to a 6.6.y that contains both.

MASTER COPY: Batman scripts/dv/data/999-batman-eir-adv-flags-oob-254.patch; the firmware's
target/linux/bcm27xx/patches-6.6/999-batman-eir-adv-flags-oob-254.patch must equal it byte for byte (build-board.sh).

--- a/net/bluetooth/eir.c
+++ b/net/bluetooth/eir.c
@@ -242,7 +242,7 @@
 	return ad_len;
 }
 
-u8 eir_create_adv_data(struct hci_dev *hdev, u8 instance, u8 *ptr)
+u8 eir_create_adv_data(struct hci_dev *hdev, u8 instance, u8 *ptr, u8 size)
 {
 	struct adv_info *adv = NULL;
 	u8 ad_len = 0, flags = 0;
@@ -283,10 +283,12 @@
 		if (!flags)
 			flags |= mgmt_get_adv_discov_flags(hdev);
 
-		/* If flags would still be empty, then there is no need to
-		 * include the "Flags" AD field".
+		/* Only add the "Flags" if it fits together with the instance
+		 * advertising data; drop it rather than overflow the buffer.
 		 */
-		if (flags) {
+		if (flags &&
+		    (ad_len + eir_precalc_len(1) +
+		     (adv ? adv->adv_data_len : 0) <= size)) {
 			ptr[0] = 0x02;
 			ptr[1] = EIR_FLAGS;
 			ptr[2] = flags;
@@ -316,7 +318,8 @@
 		}
 
 		/* Provide Tx Power only if we can provide a valid value for it */
-		if (adv_tx_power != HCI_TX_POWER_INVALID) {
+		if (adv_tx_power != HCI_TX_POWER_INVALID &&
+		    (ad_len + eir_precalc_len(1) <= size)) {
 			ptr[0] = 0x02;
 			ptr[1] = EIR_TX_POWER;
 			ptr[2] = (u8)adv_tx_power;
--- a/net/bluetooth/eir.h
+++ b/net/bluetooth/eir.h
@@ -9,7 +9,7 @@
 
 void eir_create(struct hci_dev *hdev, u8 *data);
 
-u8 eir_create_adv_data(struct hci_dev *hdev, u8 instance, u8 *ptr);
+u8 eir_create_adv_data(struct hci_dev *hdev, u8 instance, u8 *ptr, u8 size);
 u8 eir_create_scan_rsp(struct hci_dev *hdev, u8 instance, u8 *ptr);
 u8 eir_create_per_adv_data(struct hci_dev *hdev, u8 instance, u8 *ptr);
 
--- a/net/bluetooth/hci_sync.c
+++ b/net/bluetooth/hci_sync.c
@@ -1304,7 +1304,8 @@
 			return 0;
 	}
 
-	len = eir_create_adv_data(hdev, instance, pdu.data);
+	len = eir_create_adv_data(hdev, instance, pdu.data,
+				  sizeof(pdu.data));
 
 	pdu.cp.length = len;
 	pdu.cp.handle = instance;
@@ -1335,7 +1336,7 @@
 
 	memset(&cp, 0, sizeof(cp));
 
-	len = eir_create_adv_data(hdev, instance, cp.data);
+	len = eir_create_adv_data(hdev, instance, cp.data, sizeof(cp.data));
 
 	/* There's nothing to do if the data hasn't changed */
 	if (hdev->adv_data_len == len &&
