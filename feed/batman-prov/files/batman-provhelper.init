#!/bin/sh /etc/rc.common
# batman-provhelper — #254 provisioning helper (root). S89: after storage (95/96 ran at S10), network and
# bluetoothd; K15: stops early so its last state write lands before the data partition goes away.
START=89
STOP=15
USE_PROCD=1
PROG=/usr/bin/batman-provhelper

start_service() {
	procd_open_instance
	procd_set_param command "$PROG"
	# endless respawn with back-off: autocommit's health gate reads the health file, not the process (§6.4 (9))
	procd_set_param respawn 3600 5 0
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}
