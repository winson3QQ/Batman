#!/bin/sh /etc/rc.common
# batman-autocommit (#211): after a sysupgrade trial boot, health-gated auto-commit of the new slot.
# START is high, but ordering is NOT relied on — the command polls for health up to its timeout, so it
# tolerates dockerd/guardian/radio still coming up. See docs/design/ab-autocommit.md.
USE_PROCD=1
START=99
STOP=01

start_service() {
	procd_open_instance
	procd_set_param command /usr/bin/batman-autocommit run
	# one-shot: exits after it commits or times out. No respawn — a crash leaves the slot a trial,
	# which is the safe default (a reboot reverts; the operator can commit).
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}
