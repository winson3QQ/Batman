#!/bin/sh
# 94-batman-baseline — bake the mesh baseline (802.11s Mesh Point, ahwlan bridge, mesh11sd,
# batman-adv) as a first-boot default, instead of a manual post-wizard step (#75/#88/#89 v2.0).
#
# Numbered BEFORE 96-batman-config-migrate (95 < 96 < 97 < 99) so the per-node delta 96 restores
# from p5 (mesh_id, key, channel, country, reserved IP) OVERRIDES this baseline's placeholder
# values on a slot switch — see docs/design/p5-config-partition.md Lane B. On a genuinely fresh
# card (no seeded p5), this baseline is what the node boots with (placeholder key; halow-keyguard
# #103 keeps the radio DOWN until halow-setkey sets a real one).
#
# Timing (verified against /etc/init.d/boot on real hardware, 2026-09-13): boot() runs
# config_generate, then `/sbin/wifi config` (hardware-detects the morse wifi-device into
# /etc/config/wireless), THEN uci_apply_defaults (this script). So wireless.$RADIO (type=morse)
# is already populated by the time we run — the earlier assumption that a uci-default runs too
# early to see the detected radio was wrong; this was confirmed by reading the actual init script
# and by baking this hook into a real image (Build #1) and booting it on a fresh A/B slot.
#
# Not run with --apply: config is committed here, but interfaces are not restarted (the reboot
# that follows uci_apply_defaults, plus the normal boot's own network bring-up, applies it).
#
# 2026-09-13 hardware finding: a trial (uncommitted tryboot) boot of a fresh slot B running this
# hook HUNG — no kernel panic, nothing in pstore/ramoops (so not a kernel-level crash), and no
# automatic recovery (rootwait=20 panic=10 only guards early root-device detection, not a
# userspace hang after root is already mounted — a hung trial boot needs a MANUAL power cycle;
# there is no automatic fallback for this case, unlike a committed-slot kernel failure which is
# also unrecovered-until-#89, or a firmware-level boot failure which #133 proved falls back
# automatically). Root cause not pinned down (no crash log to read), but the leading suspect is
# meshpoint-1.8.0.sh's unconditional `lg "committed: ..."` call (line ~159, runs even without
# --apply) — `logger` writes to the syslog socket, which may not be up yet this early in boot()
# (config_generate / wifi config / uci_apply_defaults all run before syslog in the S-numbering).
# Defensive fix regardless of root cause: ANY uci-default that can block hangs the ENTIRE
# uci_apply_defaults loop (and thus all of boot()) forever, since it's a plain sequential
# `( . "./$file" )` with no per-script timeout. So every first-boot hook that calls into
# less-trivial logic should be timeout-wrapped — this one now is. `timeout -k 5 15` gives 15s to
# run, then SIGTERM, then SIGKILL 5s later if that didn't work; failure is logged to kmsg (not
# logger, to avoid the same suspected hang class) and the hook self-deletes either way so a
# genuinely stuck baseline never blocks the slot from booting again on retry.
if [ -x /usr/bin/meshpoint-1.8.0 ]; then
	if ! timeout -k 5 15 /usr/bin/meshpoint-1.8.0; then
		echo "94-batman-baseline: meshpoint-1.8.0 timed out or failed — baseline skipped this boot" > /dev/kmsg 2>/dev/null
	fi
fi
exit 0
