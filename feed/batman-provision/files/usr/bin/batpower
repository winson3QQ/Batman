#!/bin/sh
# batpower — battery voltage/current watchdog: graceful shutdown before the BMS cuts power.
# First line of defence against SD corruption on a hard-power-off node (#41); #104 (no
# steady-state writes) is the second. Parent #91.
#
# Sources (uci batpower.main.source):
#   hwmon  kernel ina2xx driver (kmod-hwmon-ina2xx + dtoverlay=i2c-sensor,<ina226|ina219>):
#          /sys/class/hwmon/hwmonN/{in1_input (mV bus), curr1_input (mA)}
#   i2c    raw register reads with i2c-tools (INA226/INA219 bus-voltage register 0x02)
#   mock   $RUNDIR/batpower.mock holds the pack voltage in mV — bench only: needs `option mock_ok 1`
#          and lives in the root-only run dir (#280: the old /tmp path let any non-root process HALT the node)
#   none   (default until the INA226 is fitted, #91) no reading: state UNKNOWN, never an action
# Policy (all in mV, integer maths): per-cell thresholds x cells; N consecutive readings
# (confirm) below a threshold change state; hysteresis on the way back up.
#   WARN  -> syslog + kmsg + $RUNDIR/batpower.state (halow-status / flightrec / batman-slot read it, as root)
#   CRIT  -> write the shutdown-trigger marker (boot-reasons.log will say low-battery), sync,
#            then crit_action: halt (production) | reboot (bench)
# Writes nothing to the SD in steady state: the last reading lives in the run dir (tmpfs); only the marker
# is consumed by batdata-mount's shutdown dump.
#
#   batpower run | status | once

# shellcheck source=/dev/null
[ -r /usr/lib/batman/rundir.sh ] && . /usr/lib/batman/rundir.sh   # #280: root-only run dir (never /tmp)
RUNDIR=${RUNDIR:-/nonexistent/batman-rundir}
STATE=$RUNDIR/batpower.state
MARK=$RUNDIR/shutdown.reason   # read by batdata-mount stop(): names this shutdown in boot-reasons.log
MOCK=$RUNDIR/batpower.mock

cfg(){ uci -q get "batpower.main.$1" || echo "$2"; }
note(){ logger -t batpower -p "daemon.$1" "$2" 2>/dev/null; echo "batpower: $2" > /dev/kmsg 2>/dev/null; }

load_cfg(){
	SOURCE=$(cfg source none)
	# mock is bench-only (#280 D3): honoured only when explicitly allowed, else treated as none
	[ "$SOURCE" = mock ] && [ "$(cfg mock_ok 0)" != 1 ] && SOURCE=none
	CELLS=$(cfg cells 2)
	V_WARN=$(( $(cfg v_warn_cell_mv 3500) * CELLS ))
	V_CRIT=$(( $(cfg v_crit_cell_mv 3300) * CELLS ))
	HYST=$(cfg hyst_mv 100)
	INTERVAL=$(cfg interval 10)
	CONFIRM=$(cfg confirm 3)
	ACTION=$(cfg crit_action halt)
	I2C_BUS=$(cfg i2c_bus 1)
	I2C_ADDR=$(cfg i2c_addr 0x40)
	CHIP=$(cfg chip ina226)
}

# ---- sources: print "<bus_mV> <current_mA>" (current may be "-") or nothing if unavailable
read_hwmon(){
	for h in /sys/class/hwmon/hwmon*; do
		case "$(cat "$h/name" 2>/dev/null)" in ina2*)
			v=$(cat "$h/in1_input" 2>/dev/null); i=$(cat "$h/curr1_input" 2>/dev/null)
			[ -n "$v" ] && { echo "$v ${i:--}"; return 0; };;
		esac
	done
	return 1
}
read_i2c(){
	# register 0x02 = bus voltage, big-endian; i2cget -w returns it byte-swapped
	raw=$(i2cget -y "$I2C_BUS" "$I2C_ADDR" 0x02 w 2>/dev/null) || return 1
	raw=$((raw)); be=$(( ((raw & 0xff) << 8) | ((raw >> 8) & 0xff) ))
	case "$CHIP" in
		ina219) echo "$(( (be >> 3) * 4 )) -";;          # 13-bit, LSB 4 mV
		*)      echo "$(( be * 125 / 100 )) -";;          # INA226: LSB 1.25 mV
	esac
}
read_mock(){ [ -f "$MOCK" ] && read -r v < "$MOCK" && [ -n "$v" ] && echo "$v -"; }
read_v(){ case "$SOURCE" in hwmon) read_hwmon;; i2c) read_i2c;; mock) read_mock;; *) return 1;; esac; }

# ---- state machine
state=OK; below_warn=0; below_crit=0
tick(){
	r=$(read_v) || { echo "UNKNOWN - - $(date +%s)" > "$STATE"; return 0; }
	v=${r%% *}; i=${r#* }
	if [ "$v" -le "$V_CRIT" ]; then below_crit=$((below_crit+1)); else below_crit=0; fi
	if [ "$v" -le "$V_WARN" ]; then below_warn=$((below_warn+1)); else below_warn=0; fi
	case "$state" in
		OK)   [ "$below_warn" -ge "$CONFIRM" ] && { state=WARN; note warn "LOW BATTERY: ${v} mV (warn <= ${V_WARN} mV) — shutdown at ${V_CRIT} mV"; };;
		WARN) [ "$v" -ge $((V_WARN + HYST)) ] && { state=OK; note notice "battery recovered: ${v} mV"; };;
	esac
	if [ "$below_crit" -ge "$CONFIRM" ] && [ "$state" != CRIT ]; then
		state=CRIT
		# the once-only test seam reports, it never acts (review 5 m5)
		[ "${SEAM:-0}" = 1 ] && { echo "$state $v $i $(date +%s)" > "$STATE"; return 0; }
		[ -f "$MARK" ] || echo "low-battery Vbat=${v}mV I=${i}mA source=${SOURCE} action=${ACTION}" > "$MARK"   # first writer wins
		note crit "CRITICAL BATTERY: ${v} mV <= ${V_CRIT} mV — graceful ${ACTION} now"
		echo "$state $v $i $(date +%s)" > "$STATE"; sync
		sleep 2
		# never let a pending controlled reboot (/etc/init.d/batman-reboot, #209 S5) turn this halt into a restart
		rm -f "$RUNDIR/batman-reboot.want"
		if [ "$ACTION" = reboot ]; then reboot; else halt; fi
		return 0
	fi
	echo "$state $v $i $(date +%s)" > "$STATE"
}

load_cfg
# test seam (scripts/node/tmp-trust-280.sh negative control): `once` only, never the daemon — proves the runtime
# oracle can tell a reading from the old world-writable path from none.
# The seam never publishes: its reading goes to stdout only, never into the production state file (review 4 #1).
SEAM=0; [ "${1:-}" = once ] && [ -n "${BATPOWER_MOCK_PATH:-}" ] && { MOCK=$BATPOWER_MOCK_PATH; SEAM=1; }
case "$1" in
	once)   # same rule as the daemon (#280 review 2 #8): no private run dir -> no mock, print the reading only
	        if [ "$SEAM" = 1 ]; then STATE=/dev/stdout; tick
	        elif type batman_rundir >/dev/null 2>&1 && batman_rundir 2>/dev/null; then tick; cat "$STATE"
	        else [ "$SOURCE" = mock ] && SOURCE=none; STATE=/dev/stdout; tick; fi;;
	status) [ -f "$STATE" ] && read -r s v i t < "$STATE" && printf 'state=%s vbat=%smV i=%smA age=%ss source=%s warn<=%s crit<=%s cells=%s action=%s\n' \
			"$s" "$v" "$i" "$(( $(date +%s) - t ))" "$SOURCE" "$V_WARN" "$V_CRIT" "$CELLS" "$ACTION" || echo "no reading yet";;
	run)    [ "$(cfg enabled 1)" = 1 ] || { note notice "disabled by uci"; exit 0; }
	        # no private run dir: no state file and no mock — readings from hwmon/i2c still protect the pack
	        type batman_rundir >/dev/null 2>&1 && batman_rundir || { note warn "run dir unusable (#280) — mock disabled, state not published"; [ "$SOURCE" = mock ] && SOURCE=none; STATE=/dev/null; }
	        note notice "started source=${SOURCE} cells=${CELLS} warn<=${V_WARN}mV crit<=${V_CRIT}mV confirm=${CONFIRM} action=${ACTION}"
	        while :; do tick; sleep "$INTERVAL"; done;;
	*)      echo "usage: batpower run|status|once"; exit 2;;
esac
