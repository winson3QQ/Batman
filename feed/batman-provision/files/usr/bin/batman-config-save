#!/bin/sh
# batman-config-save — write the per-node config delta + identity to the shared config
# partition (p5) so 96-batman-config-migrate can restore it onto a fresh A/B slot (#88/#89).
#
# Design: the golden image bakes the mesh STRUCTURE (batman/bridge/firewall/mesh11sd, all
# identical across nodes); p5 holds only the per-node DELTA — hostname, mesh id/key, channel/
# country, the reserved IP, openmanetd flags — plus identity files (SSH host keys). Everything
# not listed here takes the new image's default on upgrade (new-default-wins). Because the
# preserve set is per-node scalars, the fragment is a small list of `uci set` commands.
#
#   batman-config-save --seed        first write at provisioning
#   batman-config-save --save        rewrite now (operator)
#   batman-config-save --if-healthy  rewrite only if joinwatch health is OK (#127) — the
#                                    save-on-healthy hook; call from joinwatch on an OK verdict
#
# Writes p5 rw briefly and atomically (stage + rename + sync), keeps two copies (primary + lkg)
# so bit-rot of one is recoverable. Not a boot-path or per-commit action (avoids #104).

DEV=/dev/mmcblk0p5
MNT=/mnt/cfgsave
SCHEMA=1
PRESERVE="
system.@system[0].hostname
wireless.default_radio1.mesh_id
wireless.default_radio1.key
wireless.radio1.channel
wireless.radio1.country
network.ahwlan.ipaddr
network.ahwlan.proto
openmanetd.config.dhcpconfigured
openmanetd.config.roipconfigured
"

die() { echo "batman-config-save: $*" >&2; exit 1; }

mode=$1
case "$mode" in --seed|--save|--if-healthy|--on-join) ;; *) die "usage: --seed | --save | --if-healthy | --on-join" ;; esac

[ -b "$DEV" ] || die "no $DEV"
# tier note (#202/#111): DEV is the plain p5 (civilian, no crypto chip). A Secure-tier (608B) node
# encrypts p5 with LUKS; its plaintext ext4 lives on the cryptsetup mapper, which the LUKS software
# path (#111) opens — batman-config-save must then resolve DEV to that mapper. Until #111 lands we
# only ever see a plain-ext4 p5. The one hard rule that keeps this forward-safe: NEVER mkfs a
# non-ext4 partition (that would silently reformat a LUKS p5 -> data loss + security downgrade,
# review finding #1), so only --seed may format, and only a genuinely raw/plain p5.
magic=$(hexdump -s 1080 -n 2 -e '2/1 "%02x"' "$DEV" 2>/dev/null)
if [ "$magic" != "53ef" ]; then
	# only --seed may format p5 (the one-time deployment step); never on --save/--if-healthy/--on-join
	[ "$mode" = "--seed" ] || die "p5 is not plain ext4 (magic=$magic) — run --seed first (or, on a Secure-tier LUKS p5, open it via #111)"
	command -v mkfs.ext4 >/dev/null 2>&1 || die "mkfs.ext4 missing"
	echo "batman-config-save: formatting $DEV (ext4, label batman-cfg)"
	mkfs.ext4 -F -q -L batman-cfg -m 0 "$DEV" >/dev/null 2>&1 || die "mkfs.ext4 failed"
fi

if [ "$mode" = "--if-healthy" ]; then
	verdict=$(halow-status 2>/dev/null | sed -n 's/^HEALTH[[:space:]]*\[\([A-Z]*\)\].*/\1/p')
	# exit NON-zero on a not-OK skip so joinwatch's `&& :>/tmp/config-saved` guard does NOT latch —
	# a persistently-WARN node must keep retrying, or it would never seed p5 (N5r2).
	case "$verdict" in OK) ;; *) echo "batman-config-save: health=$verdict (not OK) — skip"; exit 3 ;; esac
fi

mkdir -p "$MNT"
mount -t ext4 "$DEV" "$MNT" 2>/dev/null || die "mount rw failed"

STAGE="$MNT/.stage.$$"
rm -rf "$STAGE"; mkdir -p "$STAGE/identity/dropbear"

# identity (verbatim)
for f in dropbear_ed25519_host_key dropbear_rsa_host_key authorized_keys; do
	[ -s "/etc/dropbear/$f" ] && cp -a "/etc/dropbear/$f" "$STAGE/identity/dropbear/$f"
done
if [ -s /etc/openmanet/config.yml ]; then
	mkdir -p "$STAGE/identity/openmanet"; cp -a /etc/openmanet/config.yml "$STAGE/identity/openmanet/config.yml"
fi

# per-node root password (#137): capture root's /etc/shadow line ONLY if it is a real crypt hash.
# A dev node has root:: (empty) — seeding that would ship a passwordless "prod", so skip + warn.
# 96-batman-config-migrate restores this before dropbear and only then arms the lockdown.
HAS_SHADOW=0
rootline=$(grep '^root:' /etc/shadow 2>/dev/null)
case "$rootline" in
	root:\$*) printf '%s\n' "$rootline" > "$STAGE/identity/shadow-root"; chmod 600 "$STAGE/identity/shadow-root"; HAS_SHADOW=1 ;;
	*) { [ "$mode" = --seed ] || [ "$mode" = --on-join ]; } && echo "batman-config-save: root has no password hash — persisting radio config only; node stays UNPROVISIONED (open) until a password is set (#137)" >&2 ;;
esac

# #137: a seeded node whose lockdown will turn OFF network password-auth MUST have a USABLE operator
# key (not just a non-empty file — a whitespace/comment-only authorized_keys would lock it out with no
# key = network brick). Require a real public-key line; same predicate the lockdown gate uses (96).
if [ "$mode" = --seed ] && ! grep -Eq '^[[:space:]]*(ssh-(ed25519|rsa|dss)|ecdsa-sha2-|sk-)' "$STAGE/identity/dropbear/authorized_keys" 2>/dev/null; then
	rm -rf "$STAGE"; umount "$MNT" 2>/dev/null
	die "refusing --seed without a usable public key in /etc/dropbear/authorized_keys — a locked node with no key is unreachable. Install the operator public key first (#137)."
fi

# per-node delta -> uci batch (scalars only). Single-quote values so spaces survive the round
# trip (N-R6); refuse shell metacharacters and embedded single-quotes rather than try to escape.
: > "$STAGE/overrides.uci"
for t in $PRESERVE; do
	val=$(uci -q get "$t") || continue
	[ -n "$val" ] || continue        # empty preserved key -> image default wins (documented)
	case "$val" in *[\`\$\(\)\;\|\&\<\>\']*) echo "batman-config-save: refusing unsafe value in $t" >&2; continue ;; esac
	printf "set %s='%s'\n" "$t" "$val" >> "$STAGE/overrides.uci"
done
echo "$SCHEMA" > "$STAGE/schema_version"

# idempotency for --on-join (bounds re-writes while a node stays open, #104): joinwatch calls this
# every joined tick until it latches, and an open node never latches (see the exit below) — so skip
# the write entirely when the delta AND the shadow-presence already match what is on p5.
if [ "$mode" = --on-join ] && [ -f "$MNT/.seeded" ] && cmp -s "$STAGE/overrides.uci" "$MNT/overrides.uci" 2>/dev/null; then
	# .seeded must already be present too: a write interrupted between overrides.uci and the
	# .seeded sentinel (power loss, #41) leaves overrides matching but the node still "un-seeded";
	# skipping then would never re-create the sentinel. Require it, so that case falls through and writes.
	live_shadow=0; [ -s "$MNT/identity/shadow-root" ] && live_shadow=1
	if [ "$live_shadow" = "$HAS_SHADOW" ]; then
		rm -rf "$STAGE"; sync; umount "$MNT" 2>/dev/null
		echo "batman-config-save: unchanged ($mode) — skip"
		[ "$HAS_SHADOW" = 1 ] && exit 0 || exit 4
	fi
fi

# publish atomically. lkg = last config that was PROVEN good: rotate it on --seed (the baseline),
# --if-healthy (this boot joined) and --on-join (this boot joined — the mesh key demonstrably works,
# so it is the rollback anchor #202/finding-C); --save (operator, unproven) must NOT clobber the
# last proven lkg (N-R8).
mkdir -p "$MNT/identity" "$MNT/lkg"
cp -a "$STAGE/identity/." "$MNT/identity/" 2>/dev/null
mv "$STAGE/overrides.uci" "$MNT/overrides.uci"
case "$mode" in --seed|--if-healthy|--on-join) cp -a "$MNT/overrides.uci" "$MNT/lkg/overrides.uci" ;; esac
mv "$STAGE/schema_version" "$MNT/schema_version"
rm -rf "$STAGE"
: > "$MNT/.seeded"        # sentinel written LAST (DR-2)
sync
umount "$MNT" 2>/dev/null
echo "batman-config-save: saved ($mode) schema=$SCHEMA -> $DEV"
# --on-join persists the RADIO delta so a reflash survives, but signals joinwatch NOT to latch
# (exit 4) while the node is still open (no password) — so a #137 lockdown performed later THIS boot
# is re-persisted on the next tick instead of being silently lost on the next reflash (finding #2).
[ "$mode" = --on-join ] && [ "$HAS_SHADOW" = 0 ] && exit 4
exit 0
