#!/bin/sh
# payload-run — the GENERIC payload orchestrator (#167, replaces the bespoke per-app run.sh).
#
# Brings a tenant's container stack up from its declarative manifest: sequential `docker run` on a
# FIXED-name bridge, the confinement $HARDEN_FLAGS applied per container, health-gated between
# lifecycle steps. The manifest (deploy/<app>/<app>.manifest, rendered on dev/CI by
# scripts/profile-to-manifest.py) is line-oriented so this parses it in busybox ash — no YAML/jq.
#
# NOT docker-compose (it builds a random br-<hash> bridge that the fw4 iifname rules miss, and
# can't consume the run-flag $HARDEN_FLAGS string). See docs/design/167-payload-manager.md.
#
# Usage:  payload-run <tenant>
#         payload-run --cfg-hash <tenant>   # print the tenant's config fingerprint and exit (#274)
# Env:    APPS_DIR (default /opt/batdata/apps) — the tenant lives at $APPS_DIR/<tenant>/, which
#         holds: <tenant>.manifest, <tenant>.fw4.uci, *.hardening.env, secrets/. On the bench,
#         point APPS_DIR at a dir containing <tenant>/ (e.g. deploy/).
#
# Config fingerprint (#274): every container gets --label batman.cfg=<cfg_hash>. The guardian
# re-runs payload-run when a live container's label differs from `payload-run --cfg-hash`, so a
# manifest / mounted file / hardening / image change delivered by an OTA (golden refresh) actually
# reaches the containers — dockerd (live-restore + unless-stopped) otherwise revives the OLD ones.
set -eu

HASH_ONLY=0
[ "${1:-}" = --cfg-hash ] && { HASH_ONLY=1; shift; }
TENANT="${1:-}"
[ -n "$TENANT" ] || { echo "usage: payload-run [--cfg-hash] <tenant>" >&2; exit 2; }
APPS_DIR="${APPS_DIR:-/opt/batdata/apps}"
# #216 M6: default to never-pull (offline fleet: images come from baked tars / the local store), but
# let a future online tenant override. Was hardcoded --pull=never at both docker-run sites.
PULL_POLICY="${PULL_POLICY:-never}"
DIR="$APPS_DIR/$TENANT"
# glob the manifest/fw4 by extension (one per tenant dir) so the on-node FILE name can keep the
# emitter's deploy-dir name (e.g. ots.manifest) even when the tenant dir is apps/opentakserver/.
MANIFEST=""; for m in "$DIR"/*.manifest; do [ -f "$m" ] && { MANIFEST="$m"; break; }; done
[ -n "$MANIFEST" ] || { echo "payload-run: no *.manifest in $DIR" >&2; exit 1; }
command -v docker >/dev/null || { echo "payload-run: docker not installed" >&2; exit 1; }

# cfg_hash: sha256 over an unambiguous, line-per-input list (#274 review R4): a version tag (bump
# CFG_VER whenever this script's rendering of a manifest into `docker run` flags changes), the
# manifest, every HARDEN env file and MOUNT source (by content; a missing one is the literal
# MISSING so the hash stays deterministic), and every IMAGE's local image ID (a re-tagged/reloaded
# image converges too). Never fails: the guardian must get a stable value even for a broken tenant.
CFG_VER=cfg-v1
cfg_hash(){
	{
		echo "$CFG_VER"
		echo "MANIFEST $(sha256sum < "$MANIFEST" | cut -d' ' -f1)"
		awk '$1=="HARDEN" || $1=="MOUNT" || $1=="IMAGE" {print $1, $2}' "$MANIFEST" | while read -r k v; do
			case "$k" in
				IMAGE)  echo "IMAGE $v $(docker image inspect -f '{{.Id}}' "$v" 2>/dev/null || echo MISSING)"; continue ;;
				HARDEN) f="$DIR/$v" ;;
				MOUNT)  f=${v%%:*}; case "$f" in /*) : ;; *) f="$DIR/$f" ;; esac ;;
			esac
			if [ -f "$f" ]; then echo "$k $v $(sha256sum < "$f" | cut -d' ' -f1)"; else echo "$k $v MISSING"; fi
		done
	} | sha256sum | cut -d' ' -f1
}
if [ "$HASH_ONLY" = 1 ]; then cfg_hash; exit 0; fi
CFG=$(cfg_hash)

log(){ echo "payload-run[$TENANT]: $*"; }
die(){ echo "payload-run[$TENANT]: FATAL: $*" >&2; exit 1; }

# ---- pass 1: tenant-level header (network name + kernel bridge + subnet + default restart) ----
NET=""; BRIDGE=""; SUBNET=""; DEF_RESTART="on-failure:5"
while read -r hkey hval || [ -n "$hkey" ]; do
	case "$hkey" in
		NETWORK_NAME) NET="$hval" ;;
		BRIDGE)       BRIDGE="$hval" ;;
		SUBNET)       SUBNET="$hval" ;;
		RESTART)      DEF_RESTART="$hval" ;;
		CONTAINER)    break ;;   # header ends at the first container
	esac
done < "$MANIFEST"
[ -n "$NET" ] && [ -n "$BRIDGE" ] || die "manifest missing NETWORK_NAME/BRIDGE"

# ---- network: create with the EXACT kernel bridge name so fw4 iifname "$BRIDGE" matches ----
if ! docker network inspect "$NET" >/dev/null 2>&1; then
	[ -n "$SUBNET" ] || die "network $NET absent and no SUBNET to create it"
	docker network create --driver bridge --subnet "$SUBNET" \
		-o com.docker.network.bridge.name="$BRIDGE" "$NET" >/dev/null
	log "created network $NET (bridge $BRIDGE, $SUBNET)"
fi
have_br=$(docker network inspect "$NET" -f '{{index .Options "com.docker.network.bridge.name"}}' 2>/dev/null || true)
[ "$have_br" = "$BRIDGE" ] || die "network $NET kernel bridge is '$have_br', not '$BRIDGE' — fw4 iifname rules would miss"

# FAILED tracks any non-fatal-but-degrading step (fw4 apply, health-gate timeout) so bring-up can
# still finish the stack yet EXIT NON-ZERO — otherwise a never-healthy container or a missed fw4
# rule is reported as success ("bring-up complete", rc 0), masking a broken stack from the caller.
FAILED=0

# ---- firewall: apply the tenant's fw4 rules (idempotent; requires dockerd iptables=0) ----
for f in "$DIR"/*.fw4.uci; do [ -f "$f" ] && { sh "$f" || { log "WARN: fw4 apply non-zero"; FAILED=1; }; }; done

# ---- per-container run ----
# Volume pre-chown, mirroring run.sh's "vehicle image" trick: chown a named volume using an
# explicit image before the container mounts it. Spec: <name>:<path>:<uid>:<gid>[:<image>].
prechown(){   # $1 = spec, $2 = fallback image
	pn=${1%%:*}; pr=${1#*:}
	pp=${pr%%:*}; pr=${pr#*:}
	pu=${pr%%:*}; pr=${pr#*:}
	pg=${pr%%:*}; pi=${pr#*:}
	[ "$pg" = "$pi" ] && pi="$2"          # no explicit image field → use fallback
	docker volume inspect "$pn" >/dev/null 2>&1 || docker volume create "$pn" >/dev/null
	# #274 R1(c): chown -R only when the volume root is not already $pu:$pg (a fresh volume is root-owned).
	# A recursive chown on every recreate walks the whole CoT DB on the SD card and eats the autocommit
	# window. The ownership test runs in the vehicle image (host busybox has no stat).
	# shellcheck disable=SC2016  # $1..$3 expand inside the vehicle container's sh
	docker run --pull="$PULL_POLICY" --rm --user 0 -v "$pn:$pp" --entrypoint sh "$pi" -c \
		'find "$1" -maxdepth 0 -user "$2" -group "$3" | grep -q . || chown -R "$2:$3" "$1"' sh "$pp" "$pu" "$pg" >/dev/null 2>&1 \
		|| log "WARN: prechown $pn ($pu:$pg) failed"
}

# ---- pre-pass: remove ALL manifest containers BEFORE (re)creating any. The bring-up runs
# `docker rm -f`+`docker run` per container in manifest order; if a stale sibling is still running
# on another container's static IP (e.g. one that came up with an auto-assigned IP that equals a
# later container's static IP), the first `docker run` fails "address already in use" and `set -e`
# aborts before the squatter is ever removed — a deadlock that leaves the stack half-up across every
# boot. Removing every declared container up front frees all static IPs, so the in-order run cannot
# collide with a sibling. Idempotent; the per-container rm in finish_block stays as a belt.
for _c in $(awk '/^CONTAINER /{print $2}' "$MANIFEST"); do docker rm -f "$_c" >/dev/null 2>&1 || true; done

# state for the current CONTAINER block
NAME=""; IMG=""; IP=""; HOST=""; HARDEN=""; RESTART="$DEF_RESTART"
EP_HEAD=""; EP_REST=""; HEALTH=""; CHOWNS=""; BAD=0

finish_block(){
	[ -n "$NAME" ] || return 0
	[ -n "$IMG" ] || die "container $NAME has no IMAGE"
	docker rm -f "$NAME" >/dev/null 2>&1 || true
	if [ "$BAD" = 1 ]; then
		# a bad MOUNT source: do not start THIS container with a wrong/missing file (#264 F8); the
		# rest of the stack still comes up, and the guardian's liveness verdict reports it as DRIFT.
		log "WARN: $NAME NOT started (bad MOUNT source, see above)"; FAILED=1; return 0
	fi
	OLDIFS=$IFS; IFS=' '
	for cz in $CHOWNS; do [ -n "$cz" ] && prechown "$cz" "$IMG"; done
	IFS=$OLDIFS
	# assemble: fixed opts + accumulated -e/-v ("$@") + $HARDEN_FLAGS + entrypoint + image + trailing args
	set -- --name "$NAME" --hostname "${HOST:-$NAME}" --network "$NET" --restart "$RESTART" --label "batman.cfg=$CFG" "$@"
	[ -n "$IP" ] && set -- --ip "$IP" "$@"
	[ -n "$EP_HEAD" ] && set -- --entrypoint "$EP_HEAD" "$@"
	if [ -n "$HARDEN" ] && [ -f "$DIR/$HARDEN" ]; then
		HARDEN_FLAGS=""
		# shellcheck source=/dev/null
		. "$DIR/$HARDEN"
		# shellcheck disable=SC2086  # flag string, no spaces-in-values → word-split on purpose
		set -- $HARDEN_FLAGS "$@"
	fi
	# shellcheck disable=SC2086  # EP_REST = trailing command args (may be empty) → split on purpose
	docker run --pull="$PULL_POLICY" -d "$@" "$IMG" $EP_REST >/dev/null
	log "started $NAME (${HARDEN:-no-harden})"
	if [ -n "$HEALTH" ]; then
		printf 'payload-run[%s]: wait %s' "$TENANT" "$NAME"; i=0
		while [ "$i" -lt 60 ]; do
			docker exec "$NAME" sh -c "$HEALTH" >/dev/null 2>&1 && { echo " ok"; return 0; }
			printf .; sleep 2; i=$((i+1))
		done
		echo " TIMEOUT"; log "WARN: $NAME health gate timed out"; FAILED=1
	fi
}

reset_block(){
	NAME="$1"; IMG=""; IP=""; HOST=""; HARDEN=""; RESTART="$DEF_RESTART"
	EP_HEAD=""; EP_REST=""; HEALTH=""; CHOWNS=""; BAD=0
}

# The per-container -e/-v accumulator is the MAIN shell's positional params ($@). finish_block is a
# function with its OWN $@, so the accumulator is PASSED to it (finish_block "$@"); a bare
# `finish_block` would see empty args and drop every -e/-v/secret (bug found on-node, #167 Inc-2).
# `set --` to clear the accumulator must run in the main shell here, not inside reset_block.
IN=0
while read -r key rest || [ -n "$key" ]; do
	case "$key" in
		CONTAINER)    [ "$IN" = 1 ] && finish_block "$@"; reset_block "$rest"; set --; IN=1 ;;
		IMAGE)        IMG="$rest" ;;
		IP)           IP="$rest" ;;
		HOSTNAME)     HOST="$rest" ;;
		HARDEN)       HARDEN="$rest" ;;
		RESTART)      [ "$IN" = 1 ] && RESTART="$rest" ;;
		ENV)          set -- "$@" -e "$rest" ;;
		VOLUME)       vn=${rest%%:*}; vtail=${rest#*:}; vpath=${vtail%%:*}
		              set -- "$@" -v "$vn:$vpath"
		              case "$rest" in *:*:*:*) CHOWNS="$CHOWNS $rest" ;; esac ;;
		MOUNT)        # <src>:<dst>[:ro]. A relative src (a config file shipped in the tenant dir) resolves
		              # against $DIR and must be a regular FILE. --mount, not -v: -v silently creates a
		              # missing source as an empty root-owned DIRECTORY (then the start fails and the
		              # leftover dir blocks the golden refresh for good — #264 review F8).
		              msrc=${rest%%:*}; mtail=${rest#*:}; mdst=${mtail%%:*}; mro=""
		              case "$mtail" in *:ro) mro=",readonly" ;; esac
		              case "$msrc" in
		                  /*) [ -e "$msrc" ] || { log "WARN: $NAME MOUNT source $msrc missing"; BAD=1; } ;;
		                  *)  msrc="$DIR/$msrc"
		                      [ -f "$msrc" ] || { log "WARN: $NAME MOUNT source $msrc is not a regular file"; BAD=1; } ;;
		              esac
		              case "$msrc$mdst" in *,*) log "WARN: $NAME MOUNT path contains a comma"; BAD=1 ;; esac
		              set -- "$@" --mount "type=bind,source=$msrc,target=$mdst$mro" ;;
		SECRET)       sname=${rest%% *}; srest=${rest#* }; smount=${srest%% *}
		              case "$srest" in *" "*) suid=${srest#* } ;; *) suid="" ;; esac
		              if [ -f "$DIR/secrets/$sname" ]; then
		                  # a 0600 root secret is unreadable by a non-root container → chown to the
		                  # container's run_as uid + 0400 (readable by that user only), then mount ro.
		                  [ -n "$suid" ] && { chown "$suid" "$DIR/secrets/$sname" 2>/dev/null || true; chmod 0400 "$DIR/secrets/$sname" 2>/dev/null || true; }
		                  set -- "$@" -v "$DIR/secrets/$sname:$smount:ro"
		              else
		                  log "WARN: secret '$sname' missing ($DIR/secrets/$sname) — $NAME may fail"
		              fi ;;
		ENTRYPOINT)   EP_HEAD=${rest%% *}; case "$rest" in *" "*) EP_REST=${rest#* } ;; *) EP_REST="" ;; esac ;;
		HEALTH)       HEALTH="$rest" ;;
		ENDCONTAINER) finish_block "$@"; set --; IN=0 ;;
	esac
done < "$MANIFEST"
[ "$IN" = 1 ] && finish_block "$@"   # tolerate a missing final ENDCONTAINER

if [ "$FAILED" = 0 ]; then
	log "bring-up complete"
else
	log "bring-up FINISHED WITH FAILURES (fw4 and/or health gate) — see WARNs above"; exit 1
fi
