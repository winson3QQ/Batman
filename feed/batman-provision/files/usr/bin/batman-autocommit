#!/bin/sh
# batman-autocommit (#211, v2.2 #209 S4-5) — after a `sysupgrade -n` TRIAL boot, commit the new slot ONCE
# it proves the new rootfs booted a functional, REACHABLE node; otherwise revert it by rebooting into the
# committed slot. See docs/design/ab-autocommit.md (v1 + v2.2). Started late by
# /etc/init.d/batman-autocommit (one-shot).
#
# Health gate (review B1/M1/M2): the signal is the CURRENT rootfs's own core services, NOT raw docker
# container liveness (unless-stopped containers on the shared p6 docker-root come up under ANY rootfs,
# so they don't prove the new rootfs is good).
#
# #216 layered health model: this gate = OS/infra health only. It ADDS a docker-ENGINE liveness +
# canary-run check (can this rootfs actually run containers — overlay/memcg/runc), and it treats a
# tenant that is still doing (or gave up) a first-load THIS boot as NON-GATING (a per-boot latch set
# by batman-ots-firstload). App/payload health is an app-layer concern (guardian reconcile / in-field
# swap), NOT an OS-commit criterion. Steady-state tenants (no latch) still gate on drift as before.
#
# v2.2 (#209 S4-5):
#   * a node EXPECTED in a mesh (p6 marker mesh-joined / mesh-expected, else p5 .seeded, fail-closed)
#     must also be joined + reachable (shared /usr/lib/batman/meshjoin.sh) before it commits;
#   * an unhealthy REAL tryboot (is-trial=0 AND DT tryboot=1) is reverted by a detached watchdog at an
#     uptime deadline, so a wedged check cannot stop the revert, and a #133 stale-fallback boot
#     (tryboot=0) is never rebooted (that would loop);
#   * commit and revert race for ONE atomic claim, so our reboot never tears a Pi 3 p7 sector write.
#
# Test seams (bench only): AUTOCOMMIT_DRYRUN=1 evaluates and prints the decision, never commits or
# reboots; AUTOCOMMIT_FORCE_TRIAL=1 (dry-run only) treats a committed slot as a real tryboot;
# AUTOCOMMIT_TIMEOUT overrides the deadline (dry-run only — never in production).

POLL=10                                # seconds between polls
NEED=3                                 # consecutive healthy SERVICE polls before commit (dwell; review M2)
JOIN_NEED=3                            # joined samples needed in this trial (v2.2 N8) ...
JOIN_FRESH=60                          # ... and joined within the last JOIN_FRESH seconds
MIN_WINDOW=300                         # never give a trial less than this from autocommit start (N2)
DEFER_MAX=600                          # bound on postponing the revert for a busy apply / first-load
ST=/opt/batdata/state
ACLOG=/opt/batdata/log/autocommit.log
# #280: every marker below lives in the root-only run dir, never in world-writable /tmp — a non-root process
# could pre-create a claim, a "committed", a hold or a deadline there (docs/design/280-tmp-trust.md).
# A missing helper leaves RUNDIR unset -> RDBAD below -> never commit (the deadline revert still runs).
# shellcheck source=/dev/null
[ -r /usr/lib/batman/rundir.sh ] && . /usr/lib/batman/rundir.sh
RUNDIR=${RUNDIR:-/nonexistent/batman-rundir}
[ "${AUTOCOMMIT_DRYRUN:-0}" = 1 ] && ACLOG=$RUNDIR/autocommit-dryrun.log   # a dry run must not show up as "LAST OTA"
DECIDED=$RUNDIR/autocommit.decided        # the one atomic claim (mkdir) both main and watchdog must win
COMMITTED=$RUNDIR/autocommit.committed
DRY=${AUTOCOMMIT_DRYRUN:-0}
[ "$DRY" = 1 ] && DEFER_MAX=${AUTOCOMMIT_DEFER_MAX:-$DEFER_MAX}   # test seam: shorten the bounded deferral
# v2.4 (#261/#265): operator-acceptance hold. The p6 one-shot flag names the build it is meant for; it is
# consumed on the first tryboot, whatever that boot then does, and becomes a marker in a root-owned 0700
# control dir inside the run dir (#280).
HOLDCOMMIT_FLAG=$ST/autocommit-hold-commit
CTL=$RUNDIR/autocommit.ctl; [ "$DRY" = 1 ] && CTL=$RUNDIR/autocommit.ctl.dry
ctl_ok(){ [ -d "$CTL" ] && [ ! -L "$CTL" ] && [ -O "$CTL" ]; }
# A planted $CTL (a file, a symlink, someone else's dir) is removed and re-made once; rm -rf on a symlink
# removes the link, never its target. Still not ours after that = the caller fails CLOSED (review #265 F14a).
ctl_init(){ ctl_ok && return 0
	{ [ -e "$CTL" ] || [ -L "$CTL" ]; } && { log "control dir $CTL is not a root-owned directory — removing it"; rm -rf "$CTL"; }
	mkdir -m 700 "$CTL" 2>/dev/null; ctl_ok || { log "control dir $CTL still not a root-owned directory"; return 1; }; }
held_commit(){ ctl_ok && [ -f "$CTL/hold-commit" ] && [ ! -f "$CTL/released" ]; }

log(){ logger -t batman-autocommit "$*" 2>/dev/null; echo "batman-autocommit: $*" > /dev/kmsg 2>/dev/null; [ "$DRY" = 1 ] && echo "batman-autocommit: $*"; }
up(){ cut -d. -f1 /proc/uptime; }
p6(){ grep -q " /opt/batdata " /proc/mounts 2>/dev/null; }
aclog(){ p6 && { mkdir -p "${ACLOG%/*}"; echo "$(date +%Y%m%d-%H%M%S) $*" >> "$ACLOG"; sync; }; }
version(){ sed -n 's/^BATMAN_VERSION=//p' /etc/batman-build 2>/dev/null; }
dt_tryboot(){ [ "$(hexdump -v -e '1/1 "%02x"' /proc/device-tree/chosen/bootloader/tryboot 2>/dev/null)" = 00000001 ]; }
real_tryboot(){  # this boot is a one-shot tryboot of a slot that is not provably committed
	[ "$DRY" = 1 ] && [ "${AUTOCOMMIT_FORCE_TRIAL:-0}" = 1 ] && return 0
	# #209 S5 review R4: is-trial 0 = trial, 1 = committed, 2 = unknown. On a DT tryboot=1 boot a
	# reboot ALWAYS lands on the [all] slot (the flag is one-shot), so "unknown" may be reverted —
	# leaving it running neither committed nor reverted needed a site visit to power-cycle.
	dt_tryboot || return 1
	batman-slot is-trial >/dev/null 2>&1; [ $? -ne 1 ]
}

RUN=$RUNDIR/autocommit.run                # main's pid lives in $RUN/pid (R1)
HOLDC=$RUNDIR/autocommit.hold-consumed    # a hold seen this boot — survives a main restart (R1)
pid_is(){  # $1 pid, $2 pattern in its (NUL-flattened) cmdline
	[ -n "$1" ] && kill -0 "$1" 2>/dev/null && tr '\0' ' ' < "/proc/$1/cmdline" 2>/dev/null | grep -q "$2"
}
main_alive(){ pid_is "$(cat "$RUN/pid" 2>/dev/null)" 'batman-autocommit run'; }
# The one claim (N1) records its owner, so a claim whose owner died can be told from a live one.
claim(){ mkdir "$DECIDED" 2>/dev/null || return 1; echo $$ > "$DECIDED/pid"; }
claim_owner_alive(){ pid_is "$(cat "$DECIDED/pid" 2>/dev/null)" batman-autocommit; }
slot_writer_alive(){ pid_is "$(cat "$RUNDIR/batman-slot.lock/pid" 2>/dev/null)" batman-slot; }
# A hold cancels the revert (#209 S5 review R2): the operator's /tmp hold (root-owned: /tmp is world-
# writable), a hold-once on p6 (consumed here, and remembered in $HOLDC so a restarted main and the
# watchdog both still see it), or one already consumed this boot. Checked by main at start AND by the
# watchdog on every tick, so a hold set after the trial booted still works.
# An operator flag in /tmp (#280 D2): honoured only if root-owned, not a symlink and not a hardlink (link
# count 1 — protected_hardlinks is pinned too, this does not rely on it). Anything else is logged as tamper.
op_flag(){
	[ -e "$1" ] || [ -L "$1" ] || return 1
	if [ -f "$1" ] && [ ! -L "$1" ] && [ -O "$1" ] && [ "$(ls -ln "$1" 2>/dev/null | awk '{print $2}')" = 1 ]; then return 0; fi
	log "TAMPER: $1 is not a root-owned single-link file — ignored"; return 1
}
held(){
	op_flag /tmp/batman-autocommit.hold && return 0
	[ -f "$HOLDC" ] && return 0
	if [ -f "$ST/autocommit-hold-once" ]; then
		[ "$DRY" = 1 ] || { rm -f "$ST/autocommit-hold-once"; sync; }
		: > "$HOLDC"
		log "HOLD-CONSUMED: autocommit-hold-once present — this trial will not be reverted"
		aclog "HOLD-CONSUMED boot=$(cut -c1-8 /proc/sys/kernel/random/boot_id) slot=${SLOT:-$AC_SLOT} version=$(version)"
		otalog AC HOLD-CONSUMED slot="${SLOT:-$AC_SLOT}"
		return 0
	fi
	return 1
}

# shellcheck source=/dev/null
# OTA flight recorder (#209 S5, docs/design/ota-trace.md). A missing lib degrades to no trace.
# shellcheck source=/dev/null
[ -f /usr/lib/batman/otatrace.sh ] && . /usr/lib/batman/otatrace.sh
type otalog >/dev/null 2>&1 || { otalog() { :; }; otalog_k() { :; }; ota_get() { :; }; ota_thr() { :; }; }
. /usr/lib/batman/meshjoin.sh

# The canary is built ON THE NODE from this rootfs's own busybox + musl loader (#209 S5 review K1c):
# nothing to ship (the old canary.tar.gz never was), always the same arch/version as the rootfs, ~1 MB,
# and it exercises exactly the runc/overlay/container-start chain the tenants need. Tagged by the
# content of its inputs, so one image per rootfs build; older tags are pruned after a good run.
# Measured on the Pi 3A+ (manet03, 2026-10-03): import <1 s, run 5 s, ~4 MB RAM.
# `batman-autocommit canary` runs exactly this, for daily-validation (no side effects beyond the image).
canary_run(){
	free=$(df -k /opt/batdata 2>/dev/null | awk 'NR==2{print $4}')
	[ "${free:-0}" -gt 16384 ] || { echo "canary: p6 nearly full (${free:-?} KiB free) — cannot import"; return 1; }
	set -- /bin/busybox /lib/ld-musl-*.so.1 /lib/libc.so
	for f; do [ -e "$f" ] || { echo "canary: $f missing from this rootfs"; return 1; }; done
	tag=$(cat /bin/busybox /lib/ld-musl-*.so.1 /lib/libc.so /lib/libgcc_s.so.1 2>/dev/null | sha256sum | cut -c1-12)
	img=batman-canary:$tag
	if ! docker image inspect "$img" >/dev/null 2>&1; then
		t=$(batman_tmp -d canary) || { echo "canary: run dir unusable"; return 1; }
		mkdir -p "$t/bin" "$t/lib"
		cp /bin/busybox "$t/bin/"
		cp -P /lib/ld-musl-*.so.1 "$t/lib/"; cp /lib/libc.so "$t/lib/"
		[ -e /lib/libgcc_s.so.1 ] && cp /lib/libgcc_s.so.1 "$t/lib/"
		tar -C "$t" -cf - . | docker import - "$img" >/dev/null 2>&1; r=$?; rm -rf "$t"
		[ "$r" = 0 ] || { echo "canary: docker import failed"; return 1; }
	fi
	docker run --rm --network none "$img" /bin/busybox true >/dev/null 2>&1 || { echo "canary: docker run failed (runc/overlay/cgroups)"; return 1; }
	for old in $(docker images batman-canary --format '{{.Tag}}' 2>/dev/null); do
		[ "$old" = "$tag" ] || docker rmi "batman-canary:$old" >/dev/null 2>&1
	done
	return 0
}
if [ "${1:-}" = canary ]; then
	command -v docker >/dev/null 2>&1 || { echo "batman-autocommit: no docker in this rootfs"; exit 1; }
	c=$(canary_run) && { echo "batman-autocommit: canary ok"; exit 0; }
	echo "batman-autocommit: $c"; exit 1
fi
have_docker_tenant(){ for d in /opt/batdata/apps/*/; do [ -d "$d" ] && ls "$d"/*.manifest >/dev/null 2>&1 && return 0; done; return 1; }

# `batman-autocommit release [--wait]` (#261): lift this boot's hold-commit. It never commits by itself —
# main's poll loop does, through the same dwell + pre-commit canary + claim as any commit. Refused when
# there is nothing it could still change: no hold this boot, not a trial, main gone, or past the deadline
# (then: batman-slot commit by hand). --wait returns 0 once committed, 1 on revert/deadline/main gone.
if [ "${1:-}" = release ]; then
	[ "$(id -u)" = 0 ] || { echo "release: must run as root"; exit 1; }
	ctl_ok && [ -f "$CTL/hold-commit" ] || { echo "release: no hold-commit is in effect this boot"; exit 1; }
	[ -f "$COMMITTED" ] && { echo "release: already committed"; exit 0; }
	if [ "$DRY" != 1 ]; then
		batman-slot is-trial >/dev/null 2>&1; [ $? = 0 ] || { echo "release: this boot is not an uncommitted trial"; exit 1; }
		main_alive || { echo "release: the autocommit run is not alive — commit by hand: batman-slot commit"; exit 1; }
		dl=$(cat "$RUNDIR/autocommit.deadline" 2>/dev/null); case "$dl" in ''|*[!0-9]*) echo "release: no deadline recorded"; exit 1;; esac
		[ "$(up)" -lt "$dl" ] || { echo "release: past the deadline (${dl}s) — the trial is being reverted"; exit 1; }
	fi
	: > "$CTL/released" && log "RELEASED: operator lifted the hold-commit — commit follows the normal gate (incl. the pre-commit canary)"
	aclog "RELEASED boot=$(cut -c1-8 /proc/sys/kernel/random/boot_id) slot=$(batman-slot active 2>/dev/null) version=$(version)"
	otalog AC RELEASED
	[ "${2:-}" = --wait ] || { echo "release: hold lifted"; exit 0; }
	s0=$(batman-slot active 2>/dev/null); dl=${dl:-$(( $(up) + 300 ))}; lim=$(( dl - $(up) + 30 ))
	while [ "$lim" -gt 0 ]; do
		[ -f "$COMMITTED" ] && { echo "release: committed"; exit 0; }
		[ "$DRY" = 1 ] || main_alive || [ -f "$COMMITTED" ] || { echo "release: autocommit run ended without committing ($(cat "$RUNDIR/autocommit.why" 2>/dev/null))"; exit 1; }
		[ "$(batman-slot active 2>/dev/null)" = "$s0" ] || { echo "release: slot changed"; exit 1; }
		sleep 2; lim=$((lim - 2))
	done
	echo "release: not committed by the deadline ($(cat "$RUNDIR/autocommit.why" 2>/dev/null))"; exit 1
fi

# The revert watchdog (B/N1/N4): runs as its own process (`batman-autocommit watchdog`, started with
# setsid so it is outside procd's instance), one per boot, and fires at the deadline whatever the poll
# loop is doing. It must win the claim; if main won it, it waits for main's commit to finish.
# Inputs via env: AC_DEADLINE AC_START AC_SLOT.
revert_watchdog(){
	DEADLINE=$AC_DEADLINE; START=$AC_START; SLOT=$AC_SLOT
	# #280 N6: only an UNUSABLE run dir (batman_rundir rc 1) selects the no-claim fallback — then main cannot
	# commit and batman-slot refuses slot writes, so reverting without the claim is safe. A failed mkdir on a
	# good run dir still means "another watchdog runs".
	if [ "${AC_NOCLAIM:-0}" = 1 ]; then
		log "run dir unusable — watchdog runs WITHOUT the claim and reverts at the deadline"
		while [ "$(up)" -lt "$DEADLINE" ]; do held && { log "hold present — revert watchdog stands down"; exit 0; }; sleep 5; done
		held && exit 0; real_tryboot || exit 0
		log "TRIAL-REVERTED slot $SLOT after $(( $(up) - START ))s: run dir unusable"
		aclog "TRIAL-REVERTED boot=$(cut -c1-8 /proc/sys/kernel/random/boot_id) slot=$SLOT version=$(version) waited=$(( $(up) - START ))s reason=run dir unusable"
		[ "$DRY" = 1 ] && { echo "DRYRUN decision: REVERT (no claim) — reason: run dir unusable"; exit 0; }
		echo "slot=$SLOT version=$(version)" > "$ST/bad-slot" 2>/dev/null; sync
		batman-slot reboot committed "autocommit: trial slot $SLOT reverted (run dir unusable)"
		sync; reboot
	fi
	mkdir "$RUNDIR/autocommit.wd" 2>/dev/null || exit 0
	while [ "$(up)" -lt "$DEADLINE" ]; do
		[ -f "$COMMITTED" ] && exit 0
		held && { log "hold present — revert watchdog stands down"; exit 0; }
		sleep 5
	done
	# The claim is mandatory (#209 S5 review R6): main holds it only while running `batman-slot commit`,
	# which on a Pi 3 is a raw p7 sector write — rebooting under it tears autoboot.txt (= a brick).
	# Wait for it; take it over only from a main that is gone. 30 min cap (a write takes seconds).
	# Take it over only when its owner is gone AND no batman-slot is still writing (a `restart` kills
	# main but not the `batman-slot commit` it started — code review F2/F5).
	w=0
	while ! claim; do
		[ -f "$COMMITTED" ] && exit 0
		if ! claim_owner_alive && ! slot_writer_alive; then
			log "claim left behind by a process that is gone — taking it over"; rm -rf "$DECIDED"
		elif [ $w -ge 1800 ]; then
			log "the claim has been held for ${w}s — re-checking without it"; break
		fi
		sleep 5; w=$((w + 5))
	done
	# bounded deferral: an apply/stage-root/commit/rollback writing a slot, or a first-load still loading
	# images (the p6 docker store is shared with the committed slot)
	d=0
	while [ $d -lt $DEFER_MAX ]; do
		# #274: also while a payload guardian converges its stack (post-OTA a changed config is rebuilt once)
		# — bounded by DEFER_MAX like the rest, never a hold.
		if [ -e "$RUNDIR/batman-slot.busy" ] || slot_writer_alive || { ls "$RUNDIR"/batman-firstload-*.latch >/dev/null 2>&1 && pgrep -f "docker load" >/dev/null 2>&1; } \
			|| { ls "$RUNDIR"/batman-payload-*.converging >/dev/null 2>&1 && pgrep -f "payload-run --worker" >/dev/null 2>&1; }; then
			[ $d -eq 0 ] && log "revert deferred: slot write, first-load or payload converge in progress (max ${DEFER_MAX}s)"
			sleep 10; d=$((d + 10))
		else break; fi
	done
	# re-check right before acting (N1): never reboot a slot that got committed, or a non-tryboot boot
	[ -f "$COMMITTED" ] && exit 0
	held && { log "hold present at the deadline — not reverting"; exit 0; }
	real_tryboot || { log "no longer a real tryboot at the deadline — not reverting"; exit 0; }
	why=$(cat "$RUNDIR/autocommit.why" 2>/dev/null)
	log "TRIAL-REVERTED slot $SLOT after $(( $(up) - START ))s: ${why:-unhealthy}"
	aclog "TRIAL-REVERTED boot=$(cut -c1-8 /proc/sys/kernel/random/boot_id) slot=$SLOT version=$(version) waited=$(( $(up) - START ))s reason=${why:-unhealthy}"
	if [ "$DRY" = 1 ]; then echo "DRYRUN decision: REVERT (reboot to the committed slot) — reason: ${why:-unhealthy}"; exit 0; fi
	otalog_k AC REVERT slot=$SLOT why="${why:-unhealthy}"
	# remember which slot+version was reverted: if the firmware later boots it anyway (Pi 4 EEPROM bug,
	# docs/design/explicit-reboot.md) it must never be committed as a "#133 stale fallback"
	echo "slot=$SLOT version=$(version)" > "$ST/bad-slot" 2>/dev/null; sync
	# controlled reboot onto the committed slot: explicit firmware partition on a Pi 4 (#209 S5)
	batman-slot reboot committed "autocommit: trial slot $SLOT reverted (${why:-unhealthy})"
	sync; reboot   # only reached if batman-slot itself is broken
}
[ "${1:-}" = watchdog ] && { revert_watchdog; exit 0; }

[ "${1:-}" = run ] || { echo "usage: batman-autocommit run" >&2; exit 2; }

# #280 fail closed: without a usable root-only run dir there is no trustworthy claim, deadline or hold state.
# Never commit; a real tryboot still gets its deadline revert (watchdog without the claim, see above).
RDBAD=0
if ! type batman_rundir >/dev/null 2>&1 || ! batman_rundir; then
	RDBAD=1; log "run dir unusable (#280) — this boot will NOT be committed; a trial is reverted at the deadline"
fi

# 00) hold-commit (#261, v2.4): consumed on ANY tryboot boot, BEFORE every early exit below (skip-once,
# fw-override, unknown/committed is-trial) — a flag that survived such a boot would later silently hold
# an unrelated OTA until its deadline revert. It applies only when it names the build that booted.
# Order: marker first, then delete the p6 flag (+sync), so a kill in between never loses the hold.
# A non-tryboot boot (plain reboot, stale fallback) leaves it for the trial it was set for.
# A main restarted between the marker and the rm finds the marker already there: the hold is in force, the
# flag is just dropped (review #265 F14b). A flag for this build whose control dir cannot be made safe fails
# CLOSED: HOLDUNSAFE keeps the trial from committing (the deadline revert still fires) and the p6 flag is
# KEPT, so a restarted main holds too (F14a). A discarded flag is shown by halow-status (F14c).
HOLDUNSAFE=0
if { dt_tryboot || { [ "$DRY" = 1 ] && [ "${AUTOCOMMIT_FORCE_TRIAL:-0}" = 1 ]; }; } && [ -f "$HOLDCOMMIT_FLAG" ]; then
	want=$(head -c 200 "$HOLDCOMMIT_FLAG" 2>/dev/null | tr -d '\r\n')
	if ctl_ok && [ -f "$CTL/hold-commit" ]; then
		:
	elif [ "$want" = "$(version)" ]; then
		if ctl_init; then
			echo "$want" > "$CTL/hold-commit"
			log "HOLD-COMMIT: this trial ($want) will not be committed until 'batman-autocommit release'; the deadline revert stays armed"
			aclog "HOLD-COMMIT boot=$(cut -c1-8 /proc/sys/kernel/random/boot_id) slot=$(batman-slot active 2>/dev/null) version=$want"
			otalog AC HOLD-COMMIT version="$want"
		else
			HOLDUNSAFE=1
			log "HOLD-COMMIT-UNSAFE: hold requested for this build but $CTL is not usable — NOT committing (deadline revert armed)"
			aclog "HOLD-COMMIT-UNSAFE boot=$(cut -c1-8 /proc/sys/kernel/random/boot_id) version=$want"
			otalog AC HOLD-COMMIT-UNSAFE version="$want"
		fi
	else
		log "HOLD-COMMIT-DISCARDED: flag is for [$want], this boot runs [$(version)] — not holding"
		aclog "HOLD-COMMIT-DISCARDED boot=$(cut -c1-8 /proc/sys/kernel/random/boot_id) flag=$want booted=$(version)"
		echo "flag for [$want] discarded by a tryboot of [$(version)]" > "$RUNDIR/autocommit.hold-discarded"
	fi
	[ "$DRY" = 1 ] || [ "$HOLDUNSAFE" = 1 ] || { rm -f "$HOLDCOMMIT_FLAG"; sync; }
fi

# 0) skip-once (#209 S5): scripts/ab-selftest.sh drives tryboot/plain reboots itself and must not have
# a healthy trial committed (or reverted) under it. It writes this token on p6 right before each
# reboot it causes; the token is consumed on the very next boot of EITHER slot, whatever happens, so
# a selftest that dies mid-run cannot leave OTAs un-gated for longer than one boot.
if [ "$DRY" != 1 ] && [ -f "$ST/autocommit-skip-once" ]; then
	rm -f "$ST/autocommit-skip-once"; sync
	log "SKIP-ONCE: autocommit-skip-once present (ab-selftest) — no commit and no revert this boot"
	aclog "SKIP-ONCE boot=$(cut -c1-8 /proc/sys/kernel/random/boot_id) slot=$(batman-slot active) version=$(version)"
	exit 0
fi

# 0b) the firmware booted the wrong slot (#209 S5, docs/design/explicit-reboot.md). batdata-mount (S11)
# detected it. Deferred from a first boot (uci-defaults still running then): do the correcting reboot
# now. Otherwise it could not correct (p6 unmounted / retries exhausted): never commit this slot.
if [ "$DRY" != 1 ] && [ -f "$RUNDIR/batman-fw-override-pending" ]; then
	w=$(cat "$RUNDIR/batman-fw-override-pending" 2>/dev/null); rm -f "$RUNDIR/batman-fw-override-pending"
	log "firmware booted the wrong slot ($w) — correcting reboot deferred from the first boot, doing it now"
	otalog_k AC FW-OVERRIDE-REBOOT detail="$w"
	batman-slot reboot committed "fw-override (deferred from first boot): $w"
	exit 0
fi
if [ -f "$RUNDIR/batman-fw-override" ]; then
	log "firmware booted the wrong slot ($(cat "$RUNDIR/batman-fw-override")) — this slot is NOT committed (needs: batman-slot reboot committed)"
	otalog AC FW-OVERRIDE-NO-COMMIT detail="$(cat "$RUNDIR/batman-fw-override")"
	exit 0
fi

# 1) trial? batman-slot owns the authoritative autoboot parse (is-trial: 0=trial, 1=committed, 2=unknown)
UNKNOWN=0
if [ "$DRY" = 1 ] && [ "${AUTOCOMMIT_FORCE_TRIAL:-0}" = 1 ]; then rc=0; else batman-slot is-trial; rc=$?; fi
case $rc in
	0) : ;;
	1) log "running slot is already the committed default — nothing to do"; exit 0 ;;
	*) if dt_tryboot; then
		# R4: never commit what cannot be read, but do revert it (a reboot here always lands on [all])
		UNKNOWN=1; log "cannot determine the slot commit state on a TRYBOOT boot — will not commit; the watchdog reverts at the deadline"
	   else log "cannot determine slot commit state (not a tryboot boot) — leaving as-is (no commit, no revert)"; exit 0; fi ;;
esac
SLOT=$(batman-slot active)
# Single instance per boot (N4) that survives a restart (#209 S5 review R1): the run dir holds main's
# pid. A live main -> exit; a dead one (killed by `restart`) -> take over, keeping its deadline and any
# hold it saw — a restart must neither leave zero poll loops (the watchdog would then revert a healthy
# trial) nor start a second watchdog (it is single via $RUNDIR/autocommit.wd). No run dir: no single
# instance either (#280 N6) — each procd respawn starts another claim-less watchdog; they all revert to the
# same committed slot (harmless, logged; the case should never occur).
if [ "$DRY" != 1 ] && [ "$RDBAD" = 0 ]; then
	if ! mkdir "$RUN" 2>/dev/null; then
		main_alive && { log "already running this boot (pid $(cat "$RUN/pid" 2>/dev/null)) — exiting"; exit 0; }
		log "previous run of this boot is gone — taking over"
		otalog AC TAKEOVER prev_pid="$(cat "$RUN/pid" 2>/dev/null)"
		rm -rf "$RUN"; mkdir "$RUN" 2>/dev/null || { log "lost the takeover race — exiting"; exit 0; }
	fi
	echo $$ > "$RUN/pid"
fi

# 2) can we revert? Only a REAL tryboot (review M1): a stale-fallback boot lands on the same slot again.
REVERT=0
if real_tryboot; then REVERT=1; else log "slot $SLOT is uncommitted but this is NOT a tryboot boot (stale fallback?) — will commit when healthy, will NOT reboot"; fi
# #133 stale fallback, guarded (#209 S5, docs/design/explicit-reboot.md): commit the running slot only
# when the firmware genuinely fell back — it requested no partition (p_req 0) or requested [all] and
# could not boot it. A request >= 32 is the Pi 4 EEPROM misreading PM_RSTS; a request for THIS slot is
# not a fallback either; and a slot autocommit itself reverted is never committed this way.
if [ "$REVERT" = 0 ] && [ "$UNKNOWN" = 0 ] && [ "$DRY" != 1 ] && ! dt_tryboot; then
	# shellcheck source=/dev/null
	. /usr/lib/batman/bootfacts.sh 2>/dev/null
	pq=$(bf_preq 2>/dev/null); al=$(bf_ab_all 2>/dev/null); nocommit=""
	case "$pq" in ''|0) : ;; *) [ "$pq" = "$al" ] || nocommit="firmware was asked for partition $pq, [all]=$al" ;; esac
	if [ -f "$ST/bad-slot" ] && grep -q "^slot=$SLOT version=$(version)\$" "$ST/bad-slot"; then
		nocommit="${nocommit:+$nocommit; }slot $SLOT $(version) was reverted by autocommit"
	fi
	if [ -n "$nocommit" ]; then
		log "stale fallback NOT committed: $nocommit"
		aclog "NOT-COMMITTED boot=$(cut -c1-8 /proc/sys/kernel/random/boot_id) slot=$SLOT version=$(version) reason=$nocommit"
		otalog_k AC STALE-NO-COMMIT why="$nocommit"
		exit 0
	fi
fi
# hold (N3/R2): hold-once is consumed at the START of a real tryboot, whatever the outcome
if [ "$REVERT" = 1 ] && held; then log "hold present — this trial will not be reverted"; REVERT=0; fi

# 3) deadline (N2): uptime-based; operator override on p6 (survives OTA) else the image default per SoC.
#    Computed ONCE per boot and kept in the run dir, so a main that takes over keeps the watchdog's deadline (R1).
if [ "$DRY" != 1 ] && [ -s "$RUNDIR/autocommit.deadline" ] && [ -s "$RUNDIR/autocommit.start" ]; then
	DEADLINE=$(cat "$RUNDIR/autocommit.deadline"); START=$(cat "$RUNDIR/autocommit.start")
else
	case "$(cat /proc/device-tree/compatible 2>/dev/null)" in *bcm2837*) DEF=900 ;; *) DEF=600 ;; esac
	T=$(cat "$ST/autocommit.timeout" 2>/dev/null | tr -dc '0-9'); [ -n "$T" ] || T=$DEF
	[ "$T" -lt 300 ] && T=300; [ "$T" -gt 3600 ] && T=3600
	if [ "$DRY" = 1 ] && [ -n "${AUTOCOMMIT_TIMEOUT:-}" ]; then T=$AUTOCOMMIT_TIMEOUT; MIN_WINDOW=0; fi
	START=$(up); DEADLINE=$T; [ "$DEADLINE" -lt $((START + MIN_WINDOW)) ] && DEADLINE=$((START + MIN_WINDOW))
	[ "$DRY" = 1 ] || [ "$RDBAD" = 1 ] || { echo "$DEADLINE" > "$RUNDIR/autocommit.deadline"; echo "$START" > "$RUNDIR/autocommit.start"; }
fi
log "slot $SLOT is an uncommitted trial — gate until uptime ${DEADLINE}s (now $(up)s), revert=$REVERT"

# 4) expected in a mesh? (N5: fail-closed) — p6 markers first; else p5 .seeded read-only
expected_in_mesh(){
	[ -f "$ST/mesh-joined" ] || [ -f "$ST/mesh-expected" ] && return 0
	p5=/dev/mmcblk0p5; [ -b "$p5" ] || return 1
	grep -q "^$p5 " /proc/mounts && return 0                     # being written by a save right now
	[ "$(hexdump -s 1080 -n 2 -e '2/1 "%02x"' "$p5" 2>/dev/null)" = 53ef ] || return 0   # LUKS / not plain ext4
	m=$(batman_tmp -d autocommit.p5) || return 0   # cannot look -> treat as expected (fail closed)
	mount -t ext4 -o ro "$p5" "$m" 2>/dev/null || { rmdir "$m"; return 0; }   # unreadable -> expected
	[ -f "$m/.seeded" ]; r=$?; umount "$m"; rmdir "$m"; return $r
}
NEED_MESH=0; expected_in_mesh && NEED_MESH=1
log "mesh join required: $NEED_MESH"
otalog_k AC START slot=$SLOT is_trial_rc=$rc revert=$REVERT unknown=$UNKNOWN deadline=$DEADLINE need_mesh=$NEED_MESH dt_tryboot="$(dt_tryboot && echo 1 || echo 0)"

# 5) start the revert watchdog (see revert_watchdog above)
if [ "$REVERT" = 1 ]; then
	export AC_DEADLINE=$DEADLINE AC_START=$START AC_SLOT=$SLOT AC_NOCLAIM=$RDBAD
	if [ "$DRY" = 1 ]; then
		( revert_watchdog ) & WDPID=$!
	else
		setsid "$0" watchdog </dev/null >/dev/null 2>&1 &
	fi
fi
[ "$UNKNOWN" = 1 ] && { echo "slot commit state unreadable (batman-slot is-trial)" > "$RUNDIR/autocommit.why"; exit 0; }
[ "$RDBAD" = 1 ] && { log "not committing: run dir unusable (#280)"; exit 0; }

# 6) health
running(){
	if [ -x "/etc/init.d/$1" ]; then /etc/init.d/"$1" running >/dev/null 2>&1; return $?; fi
	pgrep -f "$1" >/dev/null 2>&1 || pidof "$1" >/dev/null 2>&1
}
# health_ok runs inside $(...) — a subshell — so its latch must be a file, not a variable (code review F4)
CANARY_LATCH=$RUNDIR/autocommit.canary-ok
# echo a reason + return 1 when unhealthy; silent + return 0 when healthy (services/infra only)
health_ok(){
	# p6 must be mounted (v2.2 M3b): otherwise the docker/payload checks below silently skip themselves.
	# 95-batman-storage leaves its verdict in the run dir when it refused to touch a damaged p6 (code review F8).
	p6 || { echo "data partition /opt/batdata not mounted$( [ -s "$RUNDIR/batman-storage.crit" ] && printf ': %s' "$(cat "$RUNDIR/batman-storage.crit")")"; return 1; }
	for s in mesh11sd openmanetd wpad; do running "$s" || { echo "svc $s down"; return 1; }; done
	thr=$(vcgencmd get_throttled 2>/dev/null | sed -n 's/.*=0x//p')
	[ $(( 0x${thr:-0} & 1 )) -eq 0 ] || { echo "undervoltage now"; return 1; }
	[ -s /etc/batman-build ] || { echo "no /etc/batman-build"; return 1; }
	# #209 S5 review K1: with tenants on p6 this rootfs MUST be able to run them. A missing docker, a
	# cgroup v1 tree (memcg unverifiable) or a canary that cannot run is UNHEALTHY — each used to make
	# the whole block skip itself and commit (the 1.4.12 lesson: a build that silently lost a package).
	if have_docker_tenant; then
		command -v docker >/dev/null 2>&1 || { echo "tenants on p6 but this rootfs has no docker engine"; return 1; }
		docker info >/dev/null 2>&1 || { echo "docker engine not live"; return 1; }
		grep -qw overlay /proc/filesystems 2>/dev/null || modprobe overlay 2>/dev/null
		grep -qw overlay /proc/filesystems 2>/dev/null || { echo "no overlay filesystem"; return 1; }
		[ -e /sys/fs/cgroup/cgroup.controllers ] || { echo "no cgroup v2 hierarchy (memcg cannot be verified)"; return 1; }
		grep -qw memory /sys/fs/cgroup/cgroup.controllers 2>/dev/null || { echo "no memcg controller"; return 1; }
		# canary run (authoritative), latched only on SUCCESS (a dockerd still starting is retried next poll)
		if [ ! -f "$CANARY_LATCH" ]; then
			c=$(canary_run) || { echo "$c"; return 1; }
			: > "$CANARY_LATCH"
		fi
	fi
	for d in /opt/batdata/apps/*/; do
		[ -d "$d" ] || continue
		ls "$d"/*.manifest >/dev/null 2>&1 || continue
		t=${d%/}; t=${t##*/}
		[ -f "$RUNDIR/batman-firstload-$t.latch" ] && continue
		df=$RUNDIR/batman-payload-$t-drift.json
		[ -f "$df" ] || { echo "payload $t: no this-boot drift verdict yet"; return 1; }
		[ -n "$(find "$df" -mmin -1 2>/dev/null)" ] || { echo "payload $t: drift verdict stale (>1min)"; return 1; }
		grep -q '"status":"OK"' "$df" || { echo "payload $t: drift not OK"; return 1; }
	done
	return 0
}

# 7) poll: services dwell NEED polls; mesh join latched (>= JOIN_NEED samples, last within JOIN_FRESH)
ok=0; jn=0; jlast=-100000; why=""
while [ "$(up)" -lt "$DEADLINE" ]; do
	if [ "$NEED_MESH" = 1 ]; then
		meshjoin_sample
		if meshjoin_reachable; then jn=$((jn + 1)); jlast=$(up); fi
	fi
	if why=$(health_ok); then ok=$((ok + 1)); else [ "$ok" -gt 0 ] && log "health regressed ($why) — resetting dwell"; ok=0; fi
	if [ "$NEED_MESH" = 1 ]; then
		if [ "$jn" -lt "$JOIN_NEED" ]; then why="${why:+$why; }mesh not joined/reachable ($jn/$JOIN_NEED samples: plink=${MJ_PLINK:-0} batman(wlh0)=${MJ_BAT:-0})"
		elif [ $(( $(up) - jlast )) -gt "$JOIN_FRESH" ]; then why="${why:+$why; }mesh lost (last joined $(( $(up) - jlast ))s ago)"; fi
	fi
	[ -n "$why" ] && [ -z "${FIRSTWHY:-}" ] && { FIRSTWHY=$why; otalog AC UNHEALTHY first_why="$why"; }   # the first reason, not every poll
	# hold-commit (#261): a healthy trial waits for `batman-autocommit release`; the watchdog still reverts at
	# the deadline. Folded into why ONLY when otherwise healthy, so the commit branch (and its canary) is not
	# entered while held, and the hold is never mistaken for the first UNHEALTHY reason.
	if [ -z "$why" ] && [ "$HOLDUNSAFE" = 1 ]; then
		why="hold-commit requested but its control dir is unsafe — not committing (deadline revert armed)"
	elif [ -z "$why" ] && held_commit; then
		why="held for operator acceptance (batman-autocommit release)"
		[ -n "${HELDLOGGED:-}" ] || { HELDLOGGED=1; log "trial $SLOT is healthy and HELD — waiting for release (deadline ${DEADLINE}s)"; otalog AC HELD slot=$SLOT; }
	fi
	echo "$why" > "$RUNDIR/autocommit.why"
	if [ "$ok" -ge "$NEED" ] && [ -z "$why" ]; then
		# #265: the canary latched on its FIRST success, so a runtime broken after that was committed (measured:
		# latched 41-46 s before an injected runc break, then committed). Re-run it — unlatched — right before
		# committing. A failure drops the latch: every following poll re-runs it, so a broken trial is never
		# committed and the watchdog reverts it. Once per commit attempt only (v2.3 S3: Pi 3A+ memory).
		if have_docker_tenant; then
			if ! c=$(canary_run); then
				rm -f "$CANARY_LATCH"; why="pre-commit canary failed: $c"; echo "$why" > "$RUNDIR/autocommit.why"
				log "PRECOMMIT-CANARY-FAIL: $c — not committing, dwell reset"; otalog AC PRECOMMIT-CANARY-FAIL why="$c"
				aclog "PRECOMMIT-CANARY-FAIL boot=$(cut -c1-8 /proc/sys/kernel/random/boot_id) slot=$SLOT version=$(version) why=$c"
				ok=0; sleep "$POLL"; continue
			fi
		fi
		if [ "$DRY" = 1 ]; then echo "DRYRUN decision: COMMIT slot $SLOT (services ${NEED}x${POLL}s, mesh samples $jn)"; [ -n "${WDPID:-}" ] && kill "$WDPID" 2>/dev/null; exit 0; fi
		# claim (N1); if a LIVE watchdog won it, it is reverting — stand down. A claim whose owner is
		# gone (a main killed by `restart` mid-commit, code review F2) is cleared and retried next poll.
		if ! claim; then
			if claim_owner_alive || slot_writer_alive; then log "revert (or a slot write) in progress — not committing"; exit 0; fi
			log "stale claim from a process that is gone — clearing it"; rm -rf "$DECIDED"; sleep "$POLL"; continue
		fi
		if batman-slot commit; then
			: > "$COMMITTED"; log "slot $SLOT committed (services ${NEED}x${POLL}s, mesh samples $jn)"; aclog "COMMITTED boot=$(cut -c1-8 /proc/sys/kernel/random/boot_id) slot=$SLOT version=$(version)"; otalog_k AC COMMITTED slot=$SLOT mesh_samples=$jn; rm -f "$ST/bad-slot"; sync; exit 0
		else
			rc=$?; rm -rf "$DECIDED"; log "slot $SLOT healthy but 'batman-slot commit' failed rc=$rc — retrying (v2.2 F)"; ok=0
		fi
	fi
	sleep "$POLL"
done
log "slot $SLOT NOT committed by uptime ${DEADLINE}s. last: ${why:-?}$([ "$REVERT" = 1 ] && echo ' — watchdog reverts')"
[ "$DRY" = 1 ] && [ -n "${WDPID:-}" ] && wait "$WDPID"
exit 0
