#!/bin/sh
# Batman payload-host: point dockerd's data-root at the persistent data partition and
# enable the service (#159, review M1).
#
# WHY: dockerd ships data_root=/opt/docker/ (on the read-only squashfs / volatile overlay).
# Containers and images must live on the persistent, failure-isolated data partition
# (p6, mounted at /opt/batdata by 95-batman-storage), matching what was validated on
# manet01 during #98. We only WRITE the uci config here; dockerd (START=99) starts long
# after the p6 mount and creates the data-root itself on the mounted partition, so this
# hook must NOT mkdir the path (at uci-defaults time p6 may not be mounted yet, and a
# mkdir would land on the overlay instead of p6).
#
# Idempotent + persistent: the value is written into /etc/config/dockerd in the overlay,
# so it survives reboots; returning 0 lets uci_apply_defaults delete this one-shot hook.

DATA_ROOT="/opt/batdata/docker"

# dockerd config ships with the package; if for any reason it is absent, retry next boot.
[ -f /etc/config/dockerd ] || exit 1

# #274 §12 D7-2: `live_restore` and `no_new_privileges` are NOT set (and are deleted if a kept config still
# has them). The stock /etc/init.d/dockerd maps neither into daemon.json, so they never took effect (the
# generator patch they needed was never applied). live-restore must stay OFF: containers are --restart no and
# dockerd's own shutdown is what stops the tenant gracefully on every sysupgrade path; with live-restore the
# containers would outlive dockerd and be TERM/KILLed by sysupgrade stage 2. The guardian raises a host alarm if
# it is ever on. no-new-privileges is set per container (payload-run; checked by the guardian's allowlist).
# iptables=0 is the design-B invariant (docs/design/ots-networking.md): dockerd must NOT create its
# own `ip nat`/`ip filter` nft tables, so the node's entire firewall is one auditable `inet fw4` and
# a payload's fw4 zone (dockert) governs cross-container east-west. WHY BAKE IT: dockerd ships
# iptables=1 (default); if this is not seeded into /etc/config/dockerd, every fresh A/B slot boots
# with iptables=1 -> stale docker tables + fw4 drop-policy silently refuse ALL cross-container TCP
# (postgres/rabbitmq unreachable), and the OTS stack crash-loops (#206). Baked here it survives every
# reflash; a clean boot under iptables=0 never creates the stale tables (no one-time flush needed).
uci -q batch <<EOF
set dockerd.globals=globals
set dockerd.globals.data_root='${DATA_ROOT}'
set dockerd.globals.iptables='0'
delete dockerd.globals.no_new_privileges
delete dockerd.globals.live_restore
commit dockerd
EOF

# Enable the service so it starts on every boot (procd START=99, after the p6 mount).
/etc/init.d/dockerd enable 2>/dev/null

exit 0
