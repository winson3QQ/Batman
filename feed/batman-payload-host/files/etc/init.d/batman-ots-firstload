#!/bin/sh /etc/rc.common
# batman-ots-firstload — first-boot OTS image bootstrap (#159 flash-and-go OTS).
#
# An OTS golden image ships the OTS docker image tars pre-baked in p6 (/opt/batdata/otsimg/).
# Load them once dockerd is up, then bring the payload guardian up. Confirmed root cause of the
# earlier failure (session-24): the payload guardian starts concurrently at boot and its
# respawn/docker churn broke the slow (~2.5 min on a Pi4) batman/ots load -> only 1 of 3 images
# loaded. So this service:
#   - runs at START=95 (after dockerd, before the guardian at START=99), enabled via a baked rc.d link
#   - SYNCHRONOUSLY stops+disables the guardian first (kills the race), returns fast
#   - loads the tars in a FULLY DETACHED (setsid) subshell so it survives boot() returning and never
#     blocks boot/network; removes each tar ONLY on a successful load
#   - re-enables+starts the guardian only once EVERY tar is loaded; otherwise leaves them for the
#     next boot (idempotent, self-healing across reboots — NOT a one-shot that consumes itself)
#   - no tars (a plain image, or already loaded) -> no-op, does not touch the guardian
START=95
GUARD=batman-payload-opentakserver
OTSIMG=/opt/batdata/otsimg

boot() {
	ls "$OTSIMG"/*.tar >/dev/null 2>&1 || return 0
	# stop the guardian NOW (synchronous, fast) so it cannot race the load; the loader re-enables it
	[ -x "/etc/init.d/$GUARD" ] && { "/etc/init.d/$GUARD" stop >/dev/null 2>&1; "/etc/init.d/$GUARD" disable >/dev/null 2>&1; }
	# FULLY DETACH the (slow) load so it outlives boot() and never blocks boot/network
	setsid sh -c '
		OTSIMG=/opt/batdata/otsimg
		GUARD=batman-payload-opentakserver
		LOG=/opt/batdata/log/ots-firstload.log
		mkdir -p "$(dirname "$LOG")"
		echo "$(date) firstload start" >> "$LOG"
		i=0; while ! docker info >/dev/null 2>&1; do i=$((i+1)); [ "$i" -gt 90 ] && { echo "$(date) dockerd never up" >> "$LOG"; exit 0; }; sleep 3; done
		for t in "$OTSIMG"/*.tar; do
			if docker load -i "$t" >> "$LOG" 2>&1; then rm -f "$t"; echo "$(date) loaded+removed $t" >> "$LOG"; else echo "$(date) load FAILED (kept) $t" >> "$LOG"; fi
		done
		if ls "$OTSIMG"/*.tar >/dev/null 2>&1; then
			echo "$(date) incomplete (tars remain) — retry next boot; leaving guardian down" >> "$LOG"
		else
			[ -x "/etc/init.d/$GUARD" ] && { "/etc/init.d/$GUARD" enable >/dev/null 2>&1; "/etc/init.d/$GUARD" start >/dev/null 2>&1; }
			echo "$(date) done — all images loaded, guardian started" >> "$LOG"
		fi
	' >/dev/null 2>&1 </dev/null &
}
